类 配置 {
    公开 静态 整数 版本 = 3;
    公开 静态 文本 名称 = "甲";
    公开 静态 列表<整数> 数 = 新 列表<整数>();
    公开 静态 整数 加倍() => 版本 * 2;
    公开 静态 整数 基数 = 2;
    公开 静态 整数 倍率 {
        取 { 返回 配置.基数 * 2; }
        写 { 配置.基数 = 值 / 2; }
    }
    公开 静态 整数 只读值 {
        取 { 返回 7; }
    }
}

断言(配置.版本 == 3, $"静态整数字段");
断言(配置.名称 == "甲", $"静态文本字段");
断言(配置.加倍() == 6, $"静态方法读取静态字段");
配置.数.追加(7);
断言(配置.数.数量 == 1, $"静态列表字段");
断言(配置.倍率 == 4, $"静态属性读取");
配置.倍率 = 10;
断言(配置.倍率 == 10 && 配置.基数 == 5, $"静态属性写入");
断言(配置.只读值 == 7, $"静态只读属性读取");
