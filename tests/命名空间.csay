命名空间 数学 {
    公开 命名空间 几何 {
        公开 结构 点 {
            公开 整数 横 = 0;
            公开 整数 纵 = 0;
        }
        公开 枚举 方向 {
            水平,
            垂直,
        }
    }
}

数学.几何.点 甲 = 新 数学.几何.点();
甲.横 = 3;
甲.纵 = 4;
打印(甲.横 + 甲.纵);
数学.几何.方向 向 = 数学.几何.方向.水平;
打印(向 == 数学.几何.方向.水平);

命名空间 工具 {
    公开 委托 变换(整数): 整数;
    公开 类 盒子 {
        公开 整数 值 = 0;
    }
}

工具.变换 加倍 = (整数 甲) => 甲 * 2;
打印(加倍(3));

工具.盒子 盒 = 新 工具.盒子();
盒.值 = 5;
打印(盒.值);

命名空间 容器 {
    公开 类 盒子<T> {
        公开 T 值;
        公开 盒子(T 初值) => 自.值 = 初值;
    }
}

容器.盒子<整数> 泛盒 = 新 容器.盒子<整数>(8);
打印(泛盒.值);
