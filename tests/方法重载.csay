类 计算器 {
    公开 整数 加(整数 a) => a + 1;
    公开 整数 加(整数 a, 整数 b) => a + b;
    公开 文本 描述(整数 v) => "整数";
    公开 文本 描述(文本 v) => "文本";
    公开 静态 整数 加倍(整数 a) => a * 2;
    公开 静态 文本 加倍(文本 a) => a + a;
    公开 整数 调用() => 加(1) + 加(2, 3);
}

计算器 c = 新 计算器();
断言(c.加(1) == 2, $"方法重载 一个参数");
断言(c.加(1, 2) == 3, $"方法重载 两个参数");
断言(c.描述(1) == "整数", $"方法重载 整数参数");
断言(c.描述("x") == "文本", $"方法重载 文本参数");
断言(计算器.加倍(2) == 4, $"静态方法重载 整数");
断言(计算器.加倍("a") == "aa", $"静态方法重载 文本");
断言(c.调用() == 7, $"裸方法重载");
