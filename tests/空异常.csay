异常 甲 = 空;
断言(甲 == 空, $"空异常等于 空");
断言(甲 != 文件异常("错误"), $"空异常不等于错误");

异常 乙 = 文件异常("错误");
断言(乙 != 空, $"错误异常不等于 空");
断言(乙 == 文件异常("错误"), $"同类型同信息异常相等");

异常 丙 = 甲 ?? 乙;
断言(丙.信息 == "错误", $"?? 取右边的异常");

异常 丁 = 乙 ?? 文件异常("另一个");
断言(丁.信息 == "错误", $"?? 左边有值时不取右边");

断言(甲?.信息 == "", $"空异常 ?.信息 为空文本");
断言(甲?.类型 == "", $"空异常 ?.类型 为空文本");
断言(乙?.信息 == "错误", $"非空异常 ?.信息");
断言(乙?.类型 == "文件异常", $"非空异常 ?.类型");
