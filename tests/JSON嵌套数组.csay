断言(JSON序列化([[1, 2], [3]]) == "[[1,2],[3]]", "数组字面量套数组");
断言(JSON序列化([1, 2, 3]) == "[1,2,3]", "数组字面量");

整数[][] 矩阵 = [[1, 2], [3, 4]];
断言(JSON序列化(矩阵) == "[[1,2],[3,4]]", "数组变量套数组");
断言(矩阵[0].长度 == 2, "内层数组长度");
断言([1, 2, 3].长度 == 3, "数组字面量长度");

文本[][] 词 = [["甲"], ["乙", "丙"]];
断言(JSON序列化(词) == "[[\"甲\"],[\"乙\",\"丙\"]]", "文本数组套数组");

表<文本, 整数[]> 索引 = 新 表<文本, 整数[]>();
索引["甲"] = [1, 2];
断言(JSON序列化(索引) == "\{\"甲\":[1,2]}", "表值为数组");
断言(JSON序列化(索引["甲"]) == "[1,2]", "表内数组取值");
断言(JSON序列化(["甲", "乙"]) == "[\"甲\",\"乙\"]", "文本数组字面量");
断言(JSON序列化(['A', '中']) == "[\"A\",\"中\"]", "字符数组字面量");

索引["乙"] = 空;
断言(JSON序列化(索引["乙"]) == "[]", "空数组表值");

断言(JSON序列化([["a"], ["b", "c"]]) == "[[\"a\"],[\"b\",\"c\"]]", "文本数组字面量嵌套");
