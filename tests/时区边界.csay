文本 格式(文本 时刻, 文本 时区) {
    返回 格式化时间(解析时间(时刻), "%Y-%m-%d %H:%M", 时区);
}

断言(格式("2024-10-05T15:59:00Z", "Australia/Sydney") == "2024-10-06 01:59", "悉尼夏令时开始前");
断言(格式("2024-10-05T16:00:00Z", "Australia/Sydney") == "2024-10-06 03:00", "悉尼夏令时开始");
断言(格式("2024-04-06T15:59:00Z", "Australia/Sydney") == "2024-04-07 02:59", "悉尼夏令时结束前");
断言(格式("2024-04-06T16:00:00Z", "Australia/Sydney") == "2024-04-07 02:00", "悉尼夏令时结束");

断言(格式("2024-09-28T13:59:00Z", "Pacific/Auckland") == "2024-09-29 01:59", "奥克兰夏令时开始前");
断言(格式("2024-09-28T14:00:00Z", "Pacific/Auckland") == "2024-09-29 03:00", "奥克兰夏令时开始");
断言(格式("2024-04-06T13:59:00Z", "Pacific/Auckland") == "2024-04-07 02:59", "奥克兰夏令时结束前");
断言(格式("2024-04-06T14:00:00Z", "Pacific/Auckland") == "2024-04-07 02:00", "奥克兰夏令时结束");

断言(格式("2024-01-15T12:00:00Z", "Europe/Athens") == "2024-01-15 14:00", "雅典冬令时");
断言(格式("2024-07-15T12:00:00Z", "Europe/Athens") == "2024-07-15 15:00", "雅典夏令时");
断言(格式("2024-01-15T12:00:00Z", "Europe/Lisbon") == "2024-01-15 12:00", "里斯本冬令时");
断言(格式("2024-07-15T12:00:00Z", "Europe/Lisbon") == "2024-07-15 13:00", "里斯本夏令时");
断言(格式("2024-01-15T12:00:00Z", "America/Detroit") == "2024-01-15 07:00", "底特律冬令时");
断言(格式("2024-07-15T12:00:00Z", "America/Detroit") == "2024-07-15 08:00", "底特律夏令时");
断言(格式("2024-01-15T12:00:00Z", "Asia/Karachi") == "2024-01-15 17:00", "卡拉奇");
断言(格式("2024-01-15T12:00:00Z", "Asia/Yangon") == "2024-01-15 18:30", "仰光");
打印("时区边界通过");
