列表<整数> 甲 = 空;
断言(甲?.数量 == 0, $"空列表数量");
甲 = 新 列表<整数>();
甲.追加(1);
甲.追加(2);
甲.追加(3);
断言(甲?.数量 == 3, $"非空列表数量");
断言(甲?.长度 == 3, $"非空列表长度");
断言(甲?.最大() == 3, $"非空列表最大");
断言(甲?.最小() == 1, $"非空列表最小");
列表<整数> 丙 = 空;
断言(丙?.最大() == 0, $"空列表最大");
表<文本, 整数> 乙 = 空;
断言(乙?.数量 == 0, $"空表数量");
断言(!(乙?.含("一")), $"空表含");
乙 = 新 表<文本, 整数>();
乙.设置("一", 1);
乙.设置("二", 2);
断言(乙?.数量 == 2, $"非空表数量");
断言(乙?.含("一"), $"非空表含");
断言(乙?.取值("一", 9) == 1, $"非空表取值");
断言(乙?.取值("三", 9) == 9, $"非空表缺省");
断言(乙?.取值("三", 8) == 8, $"非空表取值缺省");
表<文本, 整数> 丁 = 空;
断言(丁?.取值("一", 7) == 7, $"空表取值");
表<文本, 文本> 戊 = 空;
断言(戊?.取值("一", "缺") == "缺", $"空文本表取值");
戊 = 新 表<文本, 文本>();
戊.设置("一", "甲");
断言(戊?.取值("一", "缺") == "甲", $"文本表取值");
列表<整数> 默认列 = 新 列表<整数>();
默认列.追加(5);
表<文本, 列表<整数>> 己 = 空;
断言(己?.取值("一", 默认列) == 默认列, $"空引用表取值");
己 = 新 表<文本, 列表<整数>>();
己.设置("一", 默认列);
断言(己?.取值("一", 默认列) == 默认列, $"引用表取值");
