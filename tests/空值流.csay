节点 甲 = 空;
甲 = 新 节点($"甲");
断言(甲.名字 == $"甲", $"空值流 赋值后非空");

节点 乙 = 空;
若 (乙 != 空) {
    打印(乙.名字);
} 否则 {
    打印($"乙为空");
}

节点 丙 = 空;
若 (真) {
    丙 = 新 节点($"丙");
} 否则 {
    丙 = 新 节点($"丙二");
}
断言(丙.名字 == $"丙", $"空值流 两个分支都赋值");

节点 丁 = 空;
若 (丁 == 空) {
    打印($"丁为空");
} 否则 {
    打印(丁.名字);
}

节点 戊 = 新 节点($"戊");
戊 = 空;
若 (戊 != 空) {
    打印(戊.名字);
}

节点 己 = 空;
循环 (; 己 != 空; ) {
    打印(己.名字);
}
断言(真, $"空值流 循环条件");

节点 庚 = 空;
若 (庚 != 空 && 庚.名字 != "") {
    打印(庚.名字);
}

类 节点 {
    公开 文本 名字;
    公开 节点(文本 名字) {
        自.名字 = 名字;
    }
}

无 默认空(节点 p = 空) {
    若 (p != 空) {
        打印(p.名字);
    }
}
默认空();

节点 辛 = 新 节点("辛");
循环 (; 辛 != 空; ) {
    辛 = 空;
}
断言(辛 == 空, $"循环结束后视为空");

节点 壬 = 新 节点("壬");
循环 (; 壬 != 空; ) {
    跳出;
}
打印(壬.名字);

节点 空查找(整数 i) {
    若 (i == 0) {
        返回 空;
    }
    返回 新 节点($"有");
}
节点 空查找结果 = 空查找(0);
若 (空查找结果 != 空) {
    打印(空查找结果.名字);
}

无 显示节点(节点 p) {
    若 (p != 空) {
        打印(p.名字);
    }
}
显示节点(空);

公开 类 方法节点 {
    公开 文本 名字;
    公开 方法节点(文本 n) {
        自.名字 = n;
    }
    公开 方法节点 可能空(整数 i) {
        若 (i == 0) {
            返回 空;
        }
        返回 新 方法节点($"有");
    }
    公开 无 显示参数(节点 p) {
        若 (p != 空) {
            打印(p.名字);
        }
    }
}
方法节点 方法结果 = 新 方法节点($"根").可能空(0);
若 (方法结果 != 空) {
    打印(方法结果.名字);
}

新 方法节点($"根").显示参数(空);
