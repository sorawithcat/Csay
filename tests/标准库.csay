打印(空);
断言(1 + 1 == 2);
文本 词语 = $"你好";
断言(文本长度(词语) == 2, $"文本长度");
表<文本, 文本> 数据 = JSON解析($"[\"a\",\"b\"]");
断言(数据.取值($"[0]", $"") == $"a", $"JSON解析");
文本 嵌套 = $"\{\"用户\":\{\"名字\":\"小明\"\},\"列表\":[10,20]\}";
断言(JSON取值(嵌套, $"用户.名字") == $"小明", $"JSON取值 嵌套对象");
断言(JSON取值(嵌套, $"列表[1]") == $"20", $"JSON取值 数组下标");
文本 改后 = JSON设置(嵌套, $"用户.名字", JSON字符串($"小红"));
断言(JSON取值(改后, $"用户.名字") == $"小红", $"JSON设置 嵌套对象");
文本 数组改 = JSON设置(嵌套, $"列表[1]", JSON序列化(25));
断言(JSON取值(数组改, $"列表[1]") == $"25", $"JSON设置 数组下标");
断言(正则匹配($"abc123", $"[a-z]+[0-9]+"), $"正则字符类");
断言(正则查找($"x42", $"[0-9]+") == 1, $"正则字符类查找");
断言(正则匹配($"A9", $"\\d+"), $"正则数字简写");
断言(正则匹配($"abc", $"[^0-9]+"), $"正则字符类取反");
表<文本, 文本> 对象 = 新 表<文本, 文本>();
对象.设置($"名字", $"小明");
对象.设置($"城市", $"上海");
断言(JSON取值(JSON序列化(对象), $"名字") == $"小明", $"JSON序列化 表");
表<文本, 整数> 分数 = 新 表<文本, 整数>();
分数.设置($"甲", 90);
断言(JSON取值(JSON序列化(分数), $"甲") == $"90", $"JSON序列化 整数表");
整数[] 数组 = [1, 2, 3];
断言(JSON序列化(数组) == $"[1,2,3]", $"JSON序列化 整数数组");
文本[] 数组词 = ["甲", "乙"];
断言(JSON序列化(数组词) == $"[\"甲\",\"乙\"]", $"JSON序列化 文本数组");
真假[] 数组开关 = [真, 假];
断言(JSON序列化(数组开关) == $"[true,false]", $"JSON序列化 真假数组");
整数[] 空数组 = 空;
断言(JSON序列化(空数组) == $"[]", $"JSON序列化 空数组");
列表<整数> 内层 = 新 列表<整数>();
内层.追加(1);
内层.追加(2);
列表<列表<整数>> 外层 = 新 列表<列表<整数>>();
外层.追加(内层);
断言(JSON序列化(外层) == $"[[1,2]]", $"JSON序列化 嵌套列表");
表<文本, 列表<整数>> 表列 = 新 表<文本, 列表<整数>>();
表列.设置($"数字", 内层);
断言(JSON取值(JSON序列化(表列), $"数字[1]") == $"2", $"JSON序列化 表内列表");
表<文本, 表<文本, 整数>> 表表 = 新 表<文本, 表<文本, 整数>>();
表<文本, 整数> 内表 = 新 表<文本, 整数>();
内表.设置($"甲", 7);
表表.设置($"内", 内表);
断言(JSON取值(JSON序列化(表表), $"内.甲") == $"7", $"JSON序列化 表内表");
列表<整数>[] 数组列 = [内层, 内层];
断言(JSON序列化(数组列) == $"[[1,2],[1,2]]", $"JSON序列化 数组内列表");
断言(转大写($"abc") == $"ABC", $"转大写");
断言(转小写($"ABC") == $"abc", $"转小写");
断言(去除空白($"  hi  ") == $"hi", $"去除空白");
浮点数 小 = 16777217;
断言(小 == 16777216, $"浮点数是 32 位");
长小数 大 = 16777217;
断言(大 == 16777217, $"长小数是 64 位");
断言(四舍五入(2.5) == 3, $"四舍五入");
整数 总和 = 0;
循环 (整数 i = 0; i < 3; i++) {
    总和 += i;
}
断言(总和 == 3, $"循环");
选择 (2) {
    情况 1:
        断言(假, $"选择分支 1");
    情况 2:
        断言(真, $"选择分支 2");
    默认:
        断言(假, $"选择默认分支");
}
资源 句柄 = 新 资源();
使用 (句柄) {
    句柄.标记 = 真;
}
断言(句柄.标记 && 句柄.已关, $"使用自动关闭");
圆 空圆 = 空;
断言(空圆 == 空, $"空引用");
断言(解析时间($"1970-01-01 00:00:00") == 0, $"解析时间 epoch");
断言(解析时间($"2024-02-29") == 1709164800, $"解析时间 闰日");
断言(解析时间($"2024-01-01T00:00:00+08:00") == 1704038400, $"解析时间 正偏移");
断言(解析时间($"2023-12-31 16:00:00Z") == 1704038400, $"解析时间 等值 UTC");
断言(解析时间($"2024-01-01 08:00:00+0800") == 1704067200, $"解析时间 无冒号偏移");
断言(解析时间($"2024-01-01 00:00:00-05:30") == 1704087000, $"解析时间 负偏移");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "UTC") == "1970-01-01 00:00", $"格式化时间 UTC");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "+08:00") == "1970-01-01 08:00", $"格式化时间 固定偏移");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "Asia/Shanghai") == "1970-01-01 08:00", $"格式化时间 时区名称");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "America/New_York") == "1969-12-31 19:00", $"格式化时间 负时区名称");
断言(格式化时间(1719792000, "%Y-%m-%d %H:%M", "America/New_York") == "2024-06-30 20:00", $"格式化时间 纽约夏令时");
断言(格式化时间(1719792000, "%Y-%m-%d %H:%M", "Europe/Paris") == "2024-07-01 02:00", $"格式化时间 巴黎夏令时");
断言(格式化时间(1719792000, "%Y-%m-%d %H:%M", "America/Toronto") == "2024-06-30 20:00", $"格式化时间 多伦多夏令时");
断言(格式化时间(1719792000, "%Y-%m-%d %H:%M", "America/Vancouver") == "2024-06-30 17:00", $"格式化时间 温哥华夏令时");
断言(格式化时间(1719792000, "%Y-%m-%d %H:%M", "Europe/Madrid") == "2024-07-01 02:00", $"格式化时间 马德里夏令时");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "Pacific/Auckland") == "1970-01-01 13:00", $"格式化时间 奥克兰夏令时");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "Asia/Kolkata") == "1970-01-01 05:30", $"格式化时间 印度半时区");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "Asia/Kathmandu") == "1970-01-01 05:45", $"格式化时间 尼泊尔时区");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "Australia/Perth") == "1970-01-01 08:00", $"格式化时间 珀斯时区");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "Pacific/Honolulu") == "1969-12-31 14:00", $"格式化时间 檀香山时区");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "America/Anchorage") == "1969-12-31 15:00", $"格式化时间 安克雷奇时区");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "America/St_Johns") == "1969-12-31 20:30", $"格式化时间 圣约翰斯时区");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "America/Phoenix") == "1969-12-31 17:00", $"格式化时间 凤凰城时区");
断言(格式化时间(0, "%Y-%m-%d %H:%M", "Europe/Istanbul") == "1970-01-01 03:00", $"格式化时间 伊斯坦布尔时区");
试 {
    解析时间($"2024-13-01");
    断言(假, $"非法时间应抛异常");
} 捕获 (格式异常 e) {
    断言(真, $"非法时间抛格式异常");
}

公开 类 资源 {
    公开 真假 标记 = 假;
    公开 真假 已关 = 假;
    公开 无 关闭() {
        已关 = 真;
    }
    资源() { }
}

公开 类 圆 {
    公开 长小数 半径;
    圆() { }
}
