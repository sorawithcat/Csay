整数 加(引用 整数 x, 输出 整数 y) {
    x++;
    y = 5;
    返回 x;
}
文本 改名(引用 文本 s) {
    s = s + $"!";
    返回 s;
}
文本 输出 = $"输出变量";
整数 引用 = 7;
断言(输出 == $"输出变量", $"输出可作变量名");
断言(引用 == 7, $"引用可作变量名");
整数 a = 1;
整数 b = 0;
打印(加(引用 a, 输出 b));
打印(a);
打印(b);
文本 t = $"小明";
打印(改名(引用 t));
打印(t);
整数 m = 3;
整数 n = 0;
计数器 c = 新 计数器();
c.加(引用 m, 输出 n);
打印(m);
打印(n);
计数器.加倍(引用 m);
打印(m);

类 计数器 {
    公开 整数 值;
    公开 无 加(引用 整数 x, 输出 整数 y) {
        x = x + 1;
        y = x * 2;
    }
    公开 静态 无 加倍(引用 整数 x) {
        x = x * 2;
    }
    计数器() { }
}

整数 cx = 1;
整数 cy = 0;
构造目标 构造对象 = 新 构造目标(引用 cx, 输出 cy);
断言(cx == 2 && cy == 6 && 构造对象.值 == 2, $"类构造器引用输出");
整数 sx = 5;
结构构造目标 结构对象 = 新 结构构造目标(引用 sx);
断言(sx == 6 && 结构对象.值 == 6, $"结构构造器引用");

类 构造目标 {
    公开 整数 值;
    公开 构造目标(引用 整数 x, 输出 整数 y) {
        x = x + 1;
        y = x + 4;
        自.值 = x;
    }
}

结构 结构构造目标 {
    公开 整数 值;
    公开 结构构造目标(引用 整数 x) {
        x = x + 1;
        自.值 = x;
    }
}

整数 bx = 1;
子构造 子对象 = 新 子构造(引用 bx);
断言(bx == 2 && 子对象.值 == 2, $"基类构造器引用");

类 基构造 {
    公开 整数 值;
    公开 基构造(引用 整数 x) {
        x = x + 1;
        自.值 = x;
    }
}

类 子构造 : 基构造 {
    公开 子构造(引用 整数 x) : 基(引用 x) { }
}

接口 可加引用 {
    无 增加(引用 整数 x);
    文本 描述(引用 整数 x);
}

类 虚拟基 {
    公开 虚拟 无 增加(引用 整数 x) {
        x = x + 1;
    }

    公开 虚拟 整数 加倍(引用 整数 x) {
        x = x + 1;
        返回 x;
    }
}

类 虚拟子 : 虚拟基, 可加引用 {
    公开 覆盖 无 增加(引用 整数 x) {
        x = x + 10;
    }

    公开 覆盖 整数 加倍(引用 整数 x) {
        x = x + 2;
        返回 x * 2;
    }

    公开 文本 描述(引用 整数 x) {
        x = x + 3;
        返回 "描述";
    }
}

虚拟基 基对象 = 新 虚拟子();
整数 vx = 1;
基对象.增加(引用 vx);
断言(vx == 11, $"虚拟方法引用参数");
整数 vy = 1;
断言(基对象.加倍(引用 vy) == 6 && vy == 3, $"虚拟方法引用与返回");
可加引用 接口对象 = 新 虚拟子();
整数 ix = 1;
接口对象.增加(引用 ix);
断言(ix == 11, $"接口方法引用参数");
整数 tx = 1;
断言(接口对象?.描述(引用 tx) == "描述" && tx == 4, $"接口文本方法引用参数");
可加引用 空接口对象 = 空;
整数 ux = 1;
断言(空接口对象?.描述(引用 ux) == "" && ux == 1, $"空接口文本方法引用参数");

抽象 类 抽象基 {
    公开 抽象 无 增加(引用 整数 x);
}

类 抽象子 : 抽象基 {
    公开 覆盖 无 增加(引用 整数 x) {
        x = x + 5;
    }
}

抽象基 抽象对象 = 新 抽象子();
整数 ax = 1;
抽象对象.增加(引用 ax);
断言(ax == 6, $"抽象方法引用参数");
