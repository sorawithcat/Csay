整数 倍数(整数 a) {
    返回 a * 2;
}

整数 倍数(整数 a, 整数 b) {
    返回 a * b;
}

整数 三倍(整数 a) {
    返回 倍数(a) + a;
}

文本 描述(整数 x) {
    返回 "整数";
}

文本 描述(文本 x) {
    返回 "文本";
}

断言(倍数(3) == 6, $"单参数重载");
断言(倍数(3, 4) == 12, $"双参数重载");
断言(三倍(2) == 6, $"重载调用嵌套");
断言(描述(1) == "整数", $"按整数类型选择重载");
断言(描述("a") == "文本", $"按文本类型选择重载");
打印("重载通过");
