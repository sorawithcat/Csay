整数 带默认(整数 a, 整数 b = 10) {
    返回 a + b;
}

整数 带默认(文本 a, 整数 b = 10) {
    返回 文本长度(a) + b;
}

断言(带默认(2) == 12, $"重载默认参数 整数");
断言(带默认(2, 3) == 5, $"重载默认参数 整数两位");
断言(带默认("ab") == 12, $"重载默认参数 文本");
断言(带默认(a: 2, b: 3) == 5, $"重载命名参数");
断言(带默认(b: 3, a: 2) == 5, $"重载命名参数乱序");
断言(带默认(a: "abc") == 13, $"重载命名参数文本");

整数 可选(整数 a) {
    返回 1;
}

整数 可选(整数 a, 整数 b = 10) {
    返回 2;
}

断言(可选(1) == 1, $"默认参数不抢占精确重载");
断言(可选(1, 2) == 2, $"显式传参选择双参数重载");
断言(可选(a: 1) == 1, $"命名参数不抢占精确重载");

类 重载默认 {
    公开 整数 计算(整数 a, 整数 b = 10) => a + b;
    公开 整数 计算(文本 a, 整数 b = 10) => 文本长度(a) + b;
    公开 整数 调用() => 计算(2) + 计算(2, 3) + 计算("ab");
    公开 整数 调用命名() => 计算(b: 3, a: 2) + 计算(a: "abc");
    公开 静态 整数 倍(整数 a, 整数 b = 10) => a * b;
    公开 静态 整数 倍(文本 a, 整数 b = 10) => 文本长度(a) * b;
    公开 文本 名称(整数 a, 文本 b = "x") => b + "整数";
    公开 文本 名称(文本 a, 文本 b = "x") => a + b;
}

重载默认 对象 = 新 重载默认();
断言(对象.调用() == 29, $"方法重载默认参数");
断言(对象.调用命名() == 18, $"方法重载命名参数");
断言(重载默认.倍(2) == 20, $"静态重载默认参数");
断言(重载默认.倍(b: 2, a: 3) == 6, $"静态重载命名参数");
重载默认 空对象 = 空;
断言(空对象?.名称(2) == "", $"空安全重载默认参数");
断言(空对象?.名称(b: "y", a: 2) == "", $"空安全重载命名参数");
打印("重载参数通过");
