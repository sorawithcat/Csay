打印(合计(丙: 5, 甲: 1));
打印(合计(1, 丙: 5));
点 甲 = 新 点(纵: 2, 横: 1);
打印(甲.横);
打印(甲.纵);
打印(甲.和(乙: 10, 甲: 5));
打印(点.加(乙: 2, 甲: 1));

形状 形 = 新 圆(2.0);
打印(形.面积(倍: 3.0));

运算 加 = (整数 甲, 整数 乙) => 甲 + 乙;
打印(加(1, 2));

整数 合计(整数 甲, 整数 乙 = 2, 整数 丙 = 3) {
    返回 甲 + 乙 + 丙;
}

公开 类 点 {
    公开 整数 横;
    公开 整数 纵;
    公开 点(整数 横 = 0, 整数 纵 = 0) {
        自.横 = 横;
        自.纵 = 纵;
    }
    公开 整数 和(整数 甲, 整数 乙 = 0) => 甲 + 乙;
    公开 静态 整数 加(整数 甲, 整数 乙 = 0) => 甲 + 乙;
}

公开 接口 形状 {
    长小数 面积(长小数 倍 = 1.0);
}

公开 类 圆 : 形状 {
    公开 长小数 半径;
    公开 圆(长小数 半径) => 自.半径 = 半径;
    公开 长小数 面积(长小数 倍 = 1.0) => 3.14159 * 半径 * 半径 * 倍;
}

公开 委托 运算(整数, 整数): 整数;
