整数[] 数 = [1, 2, 3];
数.添加(4);
断言(数.长度 == 4 && 数[3] == 4, "数组添加");

数.插入(1, 9);
断言(数.长度 == 5 && 数[1] == 9 && 数[4] == 4, "数组插入");

数.删除(0);
断言(数.长度 == 4 && 数[0] == 9 && 数[3] == 4, "数组删除");

文本[] 名 = ["甲"];
名.添加("乙");
名.插入(0, "丙");
名.删除(2);
断言(名.长度 == 2 && 名[0] == "丙" && 名[1] == "甲", "文本数组增删插");

整数[] 空数 = 空;
空数.添加(7);
断言(空数.长度 == 1 && 空数[0] == 7, "空数组添加");

空数.删除(0);
断言(空数.长度 == 0 && 空数 == 空, "删除最后一个元素后变为空");
