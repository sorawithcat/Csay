断言(加(1) == 3, $"默认参数 顶层函数");
断言(加(1, 4) == 5, $"显式实参 顶层函数");

甲 对象 = 新 甲();
断言(对象.值 == 2, $"默认参数 构造器");
断言(对象.显示() == 3, $"默认参数 方法");
断言(对象.显示(8) == 8, $"显式实参 方法");

乙 结构值 = 新 乙();
断言(结构值.值 == 4, $"默认参数 结构构造器");

显示接口 接口值 = 新 丙();
断言(接口值.显示() == 5, $"默认参数 接口方法");

子 子对象 = 新 子();
断言(子对象.父值 == 1, $"默认参数 父类构造器");

整数 加(整数 a, 整数 b = 2) {
    返回 a + b;
}

类 甲 {
    公开 整数 值
    公开 甲(整数 x = 2) {
        值 = x;
    }
    公开 整数 显示(整数 x = 3) {
        返回 x;
    }
}

结构 乙 {
    公开 整数 值
    公开 乙(整数 x = 4) {
        值 = x;
    }
}

接口 显示接口 {
    整数 显示(整数 x = 5);
}

类 丙 : 显示接口 {
    公开 整数 显示(整数 x = 5) {
        返回 x;
    }
}

类 父 {
    公开 整数 父值
    公开 父(整数 x = 1) {
        父值 = x;
    }
}

类 子 : 父 {
    公开 子() : 基() { }
}
