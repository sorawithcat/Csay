类 回收节点 {
    公开 整数 值;
    公开 回收节点 下一个;
    公开 回收节点(整数 v) {
        自.值 = v;
    }
}

无 制造临时对象() {
    回收节点 临时 = 新 回收节点(7);
    临时.下一个 = 新 回收节点(8);
}

回收节点 甲 = 新 回收节点(42);
甲.下一个 = 新 回收节点(43);
制造临时对象();
回收();
断言(甲.值 == 42 && 甲.下一个.值 == 43, "回收后保留活对象");

整数[] 数 = [1, 2, 3];
文本 字 = "abc" + "def";
回收();
断言(数.长度 == 3 && 数[2] == 3, "回收后保留数组");
断言(字 == "abcdef", "回收后保留文本");

制造临时对象();
回收();
打印(内存块数());

类 静态持有 {
    公开 静态 文本 值 = "静态";
}
回收();
断言(静态持有.值 == "静态", "回收后保留静态字段");

列表<文本> 清单 = 新 列表<文本>();
清单.追加("甲");
清单.追加("乙");
表<文本, 整数> 映射 = 新 表<文本, 整数>();
映射["一"] = 1;
回收();
断言(清单.长度 == 2 && 清单[1] == "乙", "回收后保留列表");
断言(映射["一"] == 1, "回收后保留表");

委托 读前缀(整数): 文本;
文本 前缀 = "捕获";
读前缀 读 = (整数 忽略) => 前缀 + "值";
回收();
断言(读(0) == "捕获值", "回收后保留闭包捕获");
