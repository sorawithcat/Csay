字符 字母 = 'A';
字符 换行 = '\n';
字符 汉字 = '中';
字符 转义 = '\u0042';
字符 数字 = (字符) 67;

断言(字母 == 'A', $"字符字面量");
断言(转义 == 'B', $"字符 Unicode 转义");
断言(数字 == 'C', $"整数转字符");
断言(字母 + 1 == 66, $"字符可以参与整数运算");
断言($"{字母}" == "A", $"字符插值");
断言(JSON序列化(字母) == "\"A\"", $"字符 JSON 序列化");
断言(JSON序列化(汉字) == "\"中\"", $"中文字符 JSON 序列化");
断言(字符(65) == "A", $"字符(整数) 内建函数");
字符[] 字母表 = ['A', '中'];
断言(JSON序列化(字母表) == "[\"A\",\"中\"]", $"字符数组 JSON 序列化");
列表<字符> 字符列 = 新 列表<字符>();
字符列.追加('A');
字符列.追加('中');
断言(JSON序列化(字符列) == "[\"A\",\"中\"]", $"字符列表 JSON 序列化");
表<文本, 字符> 字符表 = 新 表<文本, 字符>();
字符表.设置("甲", 'A');
断言(JSON取值(JSON序列化(字符表), "甲") == "A", $"字符表 JSON 序列化");

打印(字母);
打印(汉字);
打印(转义);
打印(数字);
打印(换行 == '\n');
