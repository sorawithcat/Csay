类 节点 {
    公开 文本 名字;
    公开 节点(文本 名字) { 自.名字 = 名字; }
}

类 容器 {
    公开 节点 值;
    公开 容器(节点 值) { 自.值 = 值; }

    公开 文本 读() {
        若 (假) {
            自.值 = 空;
        }
        返回 自.值.名字;
    }
}

容器 甲 = 新 容器(新 节点("字段"));
断言(甲.读() == "字段", "字段空值流 分支合并");

容器 乙 = 新 容器(新 节点("字段"));
乙.值 = 空;
文本 结果 = 乙.值?.名字;
断言(文本长度(结果) == 0, "局部对象字段空值");

乙.值 = 空;
若 (乙.值 != 空) {
    打印(乙.值.名字);
}
若 (乙.值 == 空) {
    打印("空");
} 否则 {
    打印(乙.值.名字);
}

类 外层 {
    公开 容器 内;
    公开 外层(容器 内) { 自.内 = 内; }
}
外层 丙 = 新 外层(新 容器(新 节点("嵌套")));
丙.内.值 = 空;
若 (丙.内.值 != 空) {
    打印(丙.内.值.名字);
}
