整数[] 空数组 = 空;
整数[] 数组 = [1, 2];
断言(空数组 == 空, $"空数组 判断空");
断言(空数组.长度 == 0, $"空数组 长度");
断言(空数组?.长度 == 0, $"空数组 空安全长度");
断言(数组 != 空, $"空数组 判断非空");
断言(数组[1] == 2, $"空数组 下标");

容器 空容器;
断言(空容器?.取数组() == 空, $"空数组 空安全");

类 容器 {
    公开 整数[] 取数组() => [7];
}
数组 = 空;
断言(数组 == 空, $"空数组 赋空");
断言(数组.长度 == 0, $"空数组 赋空长度");
整数[] 另一组 = [9, 8];
数组 = 另一组;
断言(数组.长度 == 2, $"空数组 引用赋值长度");
