断言(正则匹配($"abc123", $"^abc\\d\{3\}$"), $"分组和数量词范围");
断言(正则匹配($"ababab", $"^(ab)\{3\}$"), $"分组重复");
断言(正则匹配($"xxxxabcyy", $"(abc|def)+"), $"分支和分组");
断言(正则匹配($"2026-11-25", $"^\\d\{4\}-\\d\{2\}-\\d\{2\}$"), $"日期形状");
断言(正则匹配($"颜色:红", $"颜色:(红|蓝|绿)"), $"中文分支");
断言(正则匹配($"ab", $"a\{1,2\}b"), $"范围下限");
断言(正则匹配($"aaa", $"a\{2,\}"), $"范围不设上限");
断言(!正则匹配($"a", $"^a\{2,\}$"), $"范围不满足");
断言(正则匹配($"", $"^$"), $"空文本");
断言(正则查找($"你好abc", $"abc") == 2, $"查找码点下标");
断言(正则替换($"a1b22", $"(\\d+)", $"X") == $"aXb22", $"替换第一个匹配");
