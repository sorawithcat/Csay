形状 空形状 = 空;
形状 圆甲 = 新 圆(1.0);
断言(空形状 == 空, $"空接口 判断空");
断言(圆甲 != 空, $"空接口 判断非空");
空形状 = 圆甲;
断言(空形状.面积() > 3.0, $"空接口 赋值");
形状 选中 = 空形状 ?? 圆甲;
断言(选中.面积() > 3.0, $"空接口 合并");

公开 接口 形状 {
    长小数 面积();
}

公开 类 圆 : 形状 {
    私有 长小数 _半径;
    公开 圆(长小数 半径) => _半径 = 半径;
    公开 虚拟 长小数 面积() => 3.14159 * _半径 * _半径;
}
形状 同一形状 = 圆甲;
断言(同一形状 == 圆甲, $"空接口 相等");
断言(空形状 != 圆甲, $"空接口 不等");

接口 名片 {
    文本 称呼(文本 前缀);
    文本 昵称 { 取; }
    形状 图形 { 取; }
    形状 创建();
}

类 名片人 : 名片 {
    公开 文本 名字 = "小明";
    公开 文本 称呼(文本 前缀) => 前缀 + 名字;
    公开 文本 昵称 => 名字;
    公开 形状 图形 => 新 圆(1.0);
    公开 形状 创建() => 新 圆(1.0);
}

名片 空名片 = 空;
断言(空名片?.称呼("你好，") == "", $"空接口 空文本方法");
断言(空名片?.昵称 == "", $"空接口 空文本属性");
断言(空名片?.图形 == 空, $"空接口 空对象属性");
断言(空名片?.创建() == 空, $"空接口 空对象方法");
名片 名片甲 = 新 名片人();
断言(名片甲?.称呼("你好，") == "你好，小明", $"空接口 文本方法");
断言(名片甲?.图形 != 空, $"空接口 对象属性");
断言(名片甲?.创建() != 空, $"空接口 对象方法");
