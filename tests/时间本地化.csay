整数 时刻 = 解析时间("2024-03-05T12:34:56Z");
文本 长格式 = 本地化时间(时刻, "长");
文本 短格式 = 本地化时间(时刻, "短");
文本 时间格式 = 本地化时间(时刻, "时间");
文本 星期格式 = 本地化时间(时刻, "星期");
文本 英文格式 = 本地化时间(时刻, "英文");

断言(查找文本(长格式, "年") >= 0, "中文长格式包含年");
断言(查找文本(长格式, "星期") >= 0, "中文长格式包含星期");
断言(文本长度(短格式) == 10, "中文短格式长度");
断言(文本长度(时间格式) == 8, "中文时间格式长度");
断言(查找文本(星期格式, "星期") == 0, "中文星期格式");
断言(查找文本(英文格式, "2024") >= 0, "英文格式包含年份");
断言(查找文本(英文格式, ",") >= 0, "英文格式包含逗号");

打印(长格式);
