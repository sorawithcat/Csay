公开 类 包 {
    公开 整数[] 数;
    公开 包(整数[] n) {
        数 = n;
    }
    公开 无 加数(整数 x) {
        数.添加(x);
    }
}
公开 结构 包2 {
    公开 整数[] 数;
}

整数[] n = [2, 4, 6];
包 b = 新 包(n);
断言(b.数.长度 == 3, "类数组字段长度");
断言(b.数[1] == 4, "类数组字段下标");
断言(JSON序列化(b.数) == "[2,4,6]", "类数组字段 JSON");

包 c = 新 包([7, 8]);
断言(c.数.长度 == 2 && c.数[0] == 7, "构造器数组字面量");

整数 求和(整数[] a) {
    整数 s = 0;
    遍历 (整数 x 在 a) {
        s = s + x;
    }
    返回 s;
}
整数 总 = 0;
遍历 (整数 x 在 b.数) {
    总 = 总 + x;
}
断言(求和(b.数) == 12 && 总 == 12, "数组字段传参和遍历");

b.数 = 空;
断言(b.数.长度 == 0 && JSON序列化(b.数) == "[]", "数组字段置空");

包2 s;
s.数 = n;
断言(s.数.长度 == 3 && s.数[2] == 6, "结构体数组字段");
s.数.添加(8);
断言(s.数.长度 == 4 && s.数[3] == 8, "结构体数组字段添加");
s.数.插入(1, 9);
断言(s.数.长度 == 5 && s.数[1] == 9, "结构体数组字段插入");
s.数.删除(0);
断言(s.数.长度 == 4 && s.数[0] == 9, "结构体数组字段删除");
包 m = 新 包([1]);
m.加数(2);
断言(m.数.长度 == 2 && m.数[1] == 2, "方法内数组字段添加");

整数[] 副本 = s.数;
断言(副本.长度 == 4 && 副本[1] == 4, "局部数组从字段初始化");
整数[] 别名 = 副本;
断言(别名.长度 == 4 && 别名[2] == 6, "局部数组从另一个数组初始化");
整数[] 造数组() {
    返回 [5, 6];
}
整数[] 函数结果 = 造数组();
断言(函数结果.长度 == 2 && 函数结果[1] == 6, "局部数组从函数返回值初始化");

公开 类 数组盒<T> {
    公开 T[] 值;
    公开 数组盒(T[] v) {
        值 = v;
    }
    公开 无 加(T x) {
        值.添加(x);
    }
}
数组盒<整数> 盒 = 新 数组盒([9, 10]);
断言(盒.值.长度 == 2 && 盒.值[1] == 10, "泛型数组字段");
盒.加(13);
断言(盒.值.长度 == 3 && 盒.值[2] == 13, "泛型数组字段添加");
数组盒 推断盒 = 新 数组盒([11, 12]);
断言(推断盒.值.长度 == 2 && 推断盒.值[0] == 11, "泛型数组字段推断");
包 空包 = 空;
断言(空包?.数?.长度 == 0, "空对象的数组字段空安全访问");
