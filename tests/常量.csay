类 常量类 {
    公开 常 整数 最大值 = 10 + 5;
    公开 常 文本 名称 = "常量";
    公开 常 真假 开关 = 1 < 2;
    公开 常 字符 字母 = 'A';
    公开 常 长小数 比例 = 1.5 + 0.5;
    公开 静态 常 整数 数量 = 3;
}

常量类 对象 = 新 常量类();
断言(对象.最大值 == 15, $"常量整数运算");
断言(对象.名称 == "常量", $"常量文本");
断言(对象.开关, $"常量真假");
断言(对象.字母 == 'A', $"常量字符");
断言(对象.比例 == 2.0, $"常量小数");
断言(常量类.数量 == 3, $"静态常量");

整数 标记 = 15;
选择 (标记) {
    情况 对象.最大值:
        断言(真, $"常量用于 情况");
    默认:
        断言(假, $"常量用于 情况");
}

打印("常量通过");
