公开 类 盒子<T> {
    公开 T 内容;
    公开 盒子(T v) {
        自.内容 = v;
    }
    公开 T 取得() {
        返回 自.内容;
    }
}

盒子<整数> 整数盒 = 新 盒子<整数>(3);
盒子<文本> 文本框 = 新 盒子<文本>("你好");
盒子 推断盒 = 新 盒子<整数>(4);
盒子 构造盒 = 新 盒子(5);
断言(整数盒.内容 == 3, "泛型整数");
断言(整数盒.取得() == 3, "泛型方法自字段");
断言(文本框.内容 == "你好", "泛型文本");
断言(推断盒.内容 == 4, "泛型推断");
断言(构造盒.内容 == 5, "泛型构造器推断");

公开 类 套盒<T> {
    公开 盒子<T> 内容;
    公开 套盒(盒子<T> v) { 内容 = v; }
}

公开 类 列表盒<T> {
    公开 列表<T> 内容;
    公开 列表盒(列表<T> v) { 内容 = v; }
}

套盒 嵌套盒 = 新 套盒(新 盒子(6));
断言(嵌套盒.内容.内容 == 6, "嵌套泛型推断");

列表盒 列表盒值 = 新 列表盒(新 列表<整数>());
列表盒值.内容.追加(7);
断言(列表盒值.内容.数量 == 1, "列表泛型推断");
