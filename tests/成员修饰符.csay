类 修饰 {
    公开 静态 只读 整数 版本 = 3;
    公开 常 整数 固定 = 7;
    私有 整数 _值;
    保护 整数 _倍数;
    内部 文本 _名;

    公开 修饰(整数 值) {
        _值 = 值;
        _倍数 = 4;
        _名 = "修饰";
    }

    公开 整数 值 { 取 { 返回 _值 } }
    公开 只读 整数 双倍 { 取 { 返回 _值 * 2 } }
    公开 整数 倍数() => _倍数;
}

类 子修饰 : 修饰 {
    公开 子修饰(整数 值) : 基(值) { }
    公开 整数 子倍数() => _倍数;
}

类 受保护 {
    保护 受保护() { }
}

类 受保护子 : 受保护 {
    公开 受保护子() : 基() { }
    公开 整数 读值() => 1;
}

修饰 甲 = 新 修饰(5);
断言(修饰.版本 == 3, "静态只读字段");
断言(甲.固定 == 7, "常字段");
断言(甲.值 == 5, "私有字段通过属性读取");
断言(甲.双倍 == 10, "只读属性");
断言(甲.倍数() == 4, "保护字段");
子修饰 乙 = 新 子修饰(6);
断言(乙.子倍数() == 4, "子类访问保护字段");
受保护子 丙 = 新 受保护子();
断言(丙.读值() == 1, "子类构造器访问保护构造器");
