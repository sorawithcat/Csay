节点 甲 = 新 节点();
节点 乙 = 新 节点();
乙.名字 = $"小明";
甲.下一个 = 乙;

断言(甲.下一个?.名字 == $"小明", $"空安全 字段");
断言(甲?.别名?.名字 == $"小明", $"空安全 属性链");
断言(甲.下一个?.取下一个() == 空, $"空安全 方法");
断言(甲.下一个?.取名字() == $"小明", $"空安全 文本方法");
断言(甲.下一个?.别名文本 == $"小明", $"空安全 文本属性");

节点 空节点;
断言(空节点?.下一个 == 空, $"空安全 空字段");
断言(空节点?.取下一个() == 空, $"空安全 空方法");
断言(空节点?.取名字() == "", $"空安全 空文本方法");
断言(空节点?.取回调() == 空, $"空安全 空委托方法");
异常 空错误 = 空节点?.取错误();
断言(空错误 == 空, $"空安全 空异常方法");

类 节点 {
    公开 文本 名字;
    公开 节点 下一个;
    公开 节点 别名 => 下一个;
    公开 节点 取下一个() => 下一个;
    公开 文本 别名文本 => 名字;
    公开 文本 取名字() => 名字;
    公开 回调 取回调() => 空;
    公开 异常 取错误() => 空;
}

公开 委托 回调(): 整数;
