委托 变换(整数): 整数;
委托 通知(整数): 无;

变换 加倍 = (整数 值) => {
    返回 值 * 2;
};
断言(加倍(4) == 8, "Lambda 块体返回");

变换 绝对值 = (整数 值) => {
    若 (值 < 0) {
        返回 -值;
    }
    返回 值;
};
断言(绝对值(-3) == 3, "Lambda 块体分支返回");

通知 显示 = (整数 值) => {
    打印(值);
};
显示(6);

通知 跳过负数 = (整数 值) => {
    若 (值 < 0) {
        返回;
    }
    打印(值);
};
跳过负数(-1);
跳过负数(8);

打印("Lambda 块体返回值通过");
