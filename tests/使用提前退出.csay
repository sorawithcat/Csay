类 资源 {
    公开 静态 整数 关闭次数 = 0;
    公开 静态 整数 创建次数 = 0;
    公开 文本 名字;

    公开 资源(文本 名字) {
        自.名字 = 名字;
    }

    公开 静态 资源 造(文本 名字) {
        资源.创建次数 = 资源.创建次数 + 1;
        返回 新 资源(名字);
    }

    公开 无 关闭() {
        资源.关闭次数 = 资源.关闭次数 + 1;
    }
}

类 坏资源 {
    公开 静态 整数 关闭次数 = 0;

    公开 无 关闭() {
        坏资源.关闭次数 = 坏资源.关闭次数 + 1;
        抛出 状态异常("关闭失败");
    }
}

整数 提前返回() {
    使用 (新 资源("返回")) {
        返回 7;
    }
    返回 0;
}

整数 循环退出() {
    整数 总 = 0;
    循环 (整数 i = 0; i < 3; i++) {
        使用 (新 资源("循环")) {
            总 = 总 + 1;
            若 (i == 1) {
                跳出;
            }
        }
    }
    返回 总;
}

整数 循环跳过() {
    整数 总 = 0;
    循环 (整数 i = 0; i < 3; i++) {
        使用 (新 资源("跳过")) {
            若 (i == 1) {
                跳过;
            }
            总 = 总 + 1;
        }
    }
    返回 总;
}

整数 关闭时抛出() {
    使用 (新 坏资源()) {
        返回 1;
    }
    返回 0;
}

整数 跳出关闭时抛出() {
    循环 (整数 i = 0; i < 2; i++) {
        使用 (新 坏资源()) {
            跳出;
        }
    }
    返回 1;
}

整数 跳过关闭时抛出() {
    循环 (整数 i = 0; i < 2; i++) {
        使用 (新 坏资源()) {
            跳过;
        }
    }
    返回 1;
}

整数 捕获关闭异常 = 0;
试 {
    关闭时抛出();
} 捕获 (状态异常 错) {
    捕获关闭异常 = 1;
}

断言(提前返回() == 7, "使用块里返回");
断言(资源.关闭次数 == 1, "返回前关闭");
断言(循环退出() == 2, "使用块里跳出");
断言(资源.关闭次数 == 3, "跳出前关闭");
断言(循环跳过() == 2, "使用块里跳过");
断言(资源.关闭次数 == 6, "跳过前关闭");
断言(捕获关闭异常 == 1, "关闭异常向外传播");
断言(坏资源.关闭次数 == 1, "关闭异常不重复调用");

整数 捕获跳出异常 = 0;
试 {
    跳出关闭时抛出();
} 捕获 (状态异常 错) {
    捕获跳出异常 = 1;
}
断言(捕获跳出异常 == 1, "跳出时关闭异常向外传播");
断言(坏资源.关闭次数 == 2, "跳出时关闭异常只调用一次");

整数 捕获跳过异常 = 0;
试 {
    跳过关闭时抛出();
} 捕获 (状态异常 错) {
    捕获跳过异常 = 1;
}
断言(捕获跳过异常 == 1, "跳过时关闭异常向外传播");
断言(坏资源.关闭次数 == 3, "跳过时关闭异常只调用一次");

使用 (资源.造("一次")) { }
断言(资源.创建次数 == 1, "使用目标只求值一次");
断言(资源.关闭次数 == 7, "使用目标关闭");

资源 空资源 = 空;
使用 (空资源) { }
断言(资源.关闭次数 == 7, "空目标不关闭");

整数 嵌套使用() {
    使用 (资源.造("外")) {
        使用 (资源.造("内")) {
            返回 8;
        }
    }
    返回 0;
}

断言(嵌套使用() == 8, "嵌套使用返回");
断言(资源.创建次数 == 3, "嵌套使用目标");
断言(资源.关闭次数 == 9, "嵌套使用逐个关闭");
