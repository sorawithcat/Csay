表<真假, 整数> 计数 = 新 表<真假, 整数>();
计数[真] = 1;
计数[假] = 2;
断言(计数[真] == 1, "真假键 真");
断言(计数[假] == 2, "真假键 假");
断言(计数.含(真), "真假键 含");
断言(计数.取值(假, 0) == 2, "真假键 取值");
计数.设置(真, 3);
断言(计数[真] == 3, "真假键 设置");
计数.删除(假);
断言(!计数.含(假), "真假键 删除");
断言(计数.数量 == 1, "真假键 数量");

遍历 (项 在 计数.条目()) {
    断言(项.键, "真假键 条目");
    断言(项.值 == 3, "真假键 条目值");
}

表<真假, 文本> 状态 = 新 表<真假, 文本>();
状态[真] = "开";
状态[假] = "关";
断言(状态[真] == "开", "真假键 文本值");
断言(状态.取值(假, "") == "关", "真假键 文本取值");
状态.删除(真);
状态.删除(假);
断言(状态.数量 == 0, "真假键 清空");

表<真假, 整数> 序列化 = 新 表<真假, 整数>();
序列化[真] = 7;
断言(JSON取值(JSON序列化(序列化), "真") == "7", "真假键 JSON序列化");
