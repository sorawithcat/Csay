{
  "类": {
    "prefix": "lei",
    "body": [
      "公开 类 ${1:名字} {",
      "    私有 整数 _值;",
      "",
      "    公开 ${1:名字}(整数 值) {",
      "        _值 = 值;",
      "    }",
      "",
      "    公开 虚拟 整数 值 {",
      "        取 { 返回 _值; }",
      "    }",
      "}",
      "$0"
    ],
    "description": "带私有字段和属性的类"
  },
  "接口": {
    "prefix": "jiekou",
    "body": [
      "公开 接口 ${1:形状} {",
      "    ${2:小数} ${3:面积}();",
      "}",
      "$0"
    ],
    "description": "接口"
  },
  "结构": {
    "prefix": "jiegou",
    "body": [
      "公开 结构 ${1:点} {",
      "    公开 ${2:整数} ${3:横};",
      "}",
      "$0"
    ],
    "description": "结构"
  },
  "枚举": {
    "prefix": "meiju",
    "body": [
      "公开 枚举 ${1:星期} { ${2:一}, ${3:二}, ${4:三} }",
      "$0"
    ],
    "description": "枚举"
  },
  "函数": {
    "prefix": "hanshu",
    "body": [
      "${1:整数} ${2:名字}(${3:整数 参数}) {",
      "    $0",
      "    返回 0;",
      "}"
    ],
    "description": "顶层函数"
  },
  "若": {
    "prefix": "ruo",
    "body": [
      "若 (${1:条件}) {",
      "    $0",
      "}"
    ],
    "description": "条件分支"
  },
  "若否则": {
    "prefix": "ruofouze",
    "body": [
      "若 (${1:条件}) {",
      "    $2",
      "} 否则 {",
      "    $0",
      "}"
    ],
    "description": "if / else"
  },
  "对于": {
    "prefix": "duiyu",
    "body": [
      "对于 (整数 ${1:i} = 0; ${1:i} < ${2:10}; ${1:i}++) {",
      "    $0",
      "}"
    ],
    "description": "计次循环"
  },
  "遍历": {
    "prefix": "bianli",
    "body": [
      "遍历 (${1:整数} ${2:项} 在 ${3:集合}) {",
      "    $0",
      "}"
    ],
    "description": "遍历容器"
  },
  "只要": {
    "prefix": "zhiyao",
    "body": [
      "只要 (${1:条件}) {",
      "    $0",
      "}"
    ],
    "description": "while 循环"
  },
  "择": {
    "prefix": "ze",
    "body": [
      "择 (${1:值}) {",
      "    情形 ${2:1}:",
      "        $3",
      "    默认:",
      "        $0",
      "}"
    ],
    "description": "多路分支"
  },
  "试捕获": {
    "prefix": "shibuhuo",
    "body": [
      "试 {",
      "    $1",
      "} 捕获 (异常 ${2:错}) {",
      "    打印(\\$\"出错：{${2:错}.信息}\");",
      "}"
    ],
    "description": "异常捕获"
  },
  "区域": {
    "prefix": "quyu",
    "body": [
      "区域 {",
      "    $0",
      "}"
    ],
    "description": "区域分配块"
  },
  "打印": {
    "prefix": "dayin",
    "body": ["打印(${1});"],
    "description": "打印"
  },
  "插值打印": {
    "prefix": "dayin2",
    "body": ["打印(\\$\"${1:结果 {值}}\");"],
    "description": "带插值的打印"
  },
  "引": {
    "prefix": "yin",
    "body": ["引 ${1:模块};"],
    "description": "引用同目录的库文件"
  },
  "列表": {
    "prefix": "liebiao",
    "body": ["列表<${1:整数}> ${2:数} = 新 列表<${1:整数}>();"],
    "description": "新建列表"
  },
  "表": {
    "prefix": "biao",
    "body": ["表<${1:文本}, ${2:整数}> ${3:频次} = 新 表<${1:文本}, ${2:整数}>();"],
    "description": "新建哈希表"
  }
}
