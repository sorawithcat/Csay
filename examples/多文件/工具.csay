长小数 平方(长小数 x) {
    返回 x * x;
}
长小数 合计(长小数 x, 长小数 y) {
    返回 x + y;
}
浮点数 减法(浮点数 被减数, 浮点数 减数) {
    返回 被减数 - 减数;
}
无 说(文本 话语, 说的类型 类型) {
    若 (!类型) {
        类型 = 说的类型._打印;
    }
    选择 (类型) {
        情况 说的类型._打印:
            打印(话语);
            跳出;
        情况 说的类型._询问:
            询问(话语);
            跳出;
        情况 说的类型._输入:
            输入(话语);
            跳出;
        默认:
            抛出 ($"未知类型");
    }
}

公开 枚举 说的类型 { _打印, _询问, _输入 }
