            若 (p[0] == 属性) {
                文本 vis = "";
                若 (p.数量 > 4) { vis = p[4]; }
                返回 可访问(vis, cls);
            }
        }
        k = k + 1;
    }
    返回 假;
}

真假 静态字段可见(文本 cls, 文本 字段) {
    整数 i = 类索引(cls);
    若 (i < 0) { 返回 假; }
    列表<文本> es = 类静态字段[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 字段) {
                文本 vis = "";
                若 (p.数量 > 2) { vis = p[2]; }
                返回 可访问(vis, cls);
            }
        }
        k = k + 1;
    }
    返回 假;
}

文本 构造参数(文本 cls) {
    整数 i = 类索引(cls);
    若 (i < 0) { 返回 ""; }
    返回 类构造[i];
}

文本 属性项(文本 cls, 文本 属性) {
    整数 i = 类索引(cls);
    若 (i < 0) { 返回 ""; }
    列表<文本> es = 类属性[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 属性) { 返回 p[1] + "|" + p[2] + "|" + p[3]; }
        }
        k = k + 1;
    }
    返回 "";
}

文本 参数C串(文本 源串) {
    若 (源串 == "") { 返回 "void"; }
    列表<文本> ps = 源串.切分(",");
    文本 out = "";
    整数 i = 0;
    只要 (i < ps.数量) {
        若 (out != "") { out = out + ", "; }
        out = out + C型(ps[i]);
        i = i + 1;
    }
    返回 out;
}

文本 接口方法项(文本 iface, 文本 方法) {
    整数 i = 接口索引(iface);
    若 (i < 0) { 返回 ""; }
    列表<文本> es = 接口方法[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 方法) { 返回 p[1] + "|" + p[2]; }
        }
        k = k + 1;
    }
    返回 "";
}

文本 接口属性项(文本 iface, 文本 属性) {
    整数 i = 接口索引(iface);
    若 (i < 0) { 返回 ""; }
    列表<文本> es = 接口属性[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 属性) { 返回 p[1] + "|" + p[2] + "|" + p[3]; }
        }
        k = k + 1;
    }
    返回 "";
}

真假 类实现接口(文本 cls, 文本 iface) {
    整数 i = 类索引(cls);
    若 (i < 0) { 返回 假; }
    列表<文本> es = 类接口[i].切分(",");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] == iface) { 返回 真; }
        k = k + 1;
    }
    返回 假;
}

文本 接口参数定义(文本 源串) {
    若 (源串 == "") { 返回 ""; }
    列表<文本> ps = 源串.切分(",");
    文本 out = "";
    整数 i = 0;
    只要 (i < ps.数量) {
        若 (out != "") { out = out + ", "; }
        out = out + C型(ps[i]) + " a" + 整转文(i);
        i = i + 1;
    }
    返回 out;
}

文本 接口参数调用(文本 源串) {
    若 (源串 == "") { 返回 ""; }
    列表<文本> ps = 源串.切分(",");
    文本 out = "";
    整数 i = 0;
    只要 (i < ps.数量) {
        若 (out != "") { out = out + ", "; }
        out = out + "a" + 整转文(i);
        i = i + 1;
    }
    返回 out;
}

文本 转目标(文本 目标, 文本 值类型, 文本 代码) {
    若 (目标 == 值类型) { 返回 代码; }
    列表<文本> a = 目标.切分(":");
    列表<文本> b = 值类型.切分(":");
    若 (a[0] == "接口" && b[0] == "类" && 类实现接口(b[1], a[1])) {
        返回 "(" + 接口C名(a[1]) + ")" + 左 + " (void*)(" + 代码 + "), " + 整转文(类标签(b[1])) + " " + 右;
    }
    若 (a[0] == "异常" && b[0] == "文本") {
        返回 "csay_error(" + 代码 + ", " + 整转文(异常种类(目标)) + ")";
    }
    若 (a[0] == "委托" && b[0] == "函数") {
        若 (值类型 != 委托签名(a[1])) {
            错("Lambda 签名与委托「" + a[1] + "」不一致");
        }
        文本 en = 查委托环境(代码);
        若 (en == "") { en = "0"; }
        返回 "(" + C型(目标) + ")" + 左 + " " + en + ", " + 代码 + " " + 右;
    }
    若 (a[0] == "委托" && b[0] == "委托" && a[1] != b[1]) {
        错("委托类型不匹配");
    }
    返回 代码;
}

无 收集函数签名(文本 名, 文本 返回类型, 整数 左括号) {
    函数名.追加(名);
    函数返回.追加(返回类型);
    C名("#f:" + 名);
    整数 p = 左括号 + 1;
    文本 ps = "";
    文本 ts = "";
    只要 (p < 词文.数量 && 词(p) != ")") {
        文本 pt = 扫类型(p);
        p = 类型尾;
        若 (ps != "") { ps = ps + ","; }
        若 (ts != "") { ts = ts + ","; }
        ps = ps + C型(pt);
        ts = ts + pt;
        p = p + 1;
        若 (p < 词文.数量 && 词(p) == ",") { p = p + 1; }
    }
    若 (ps == "") { ps = "void"; }
    函数参数.追加(ps);
    函数参数型.追加(ts);
}

文本 函数参数类型(文本 名) {
    整数 i = 0;
    只要 (i < 函数名.数量) {
        若 (函数名[i] == 名) { 返回 函数参数型[i]; }
        i = i + 1;
    }
    返回 "";
}

整数 跳过函数(整数 左括号) {
    整数 p = 左括号;
    只要 (p < 词文.数量 && 词(p) != ")") {
        p = p + 1;
    }
    p = p + 1;
    只要 (p < 词文.数量 && 词(p) != 左) {
        p = p + 1;
    }
    整数 深 = 0;
    只要 (p < 词文.数量) {
        若 (词(p) == 左) { 深 = 深 + 1; }
        否则若 (词(p) == 右) {
            深 = 深 - 1;
            若 (深 == 0) { 返回 p + 1; }
        }
        p = p + 1;
    }
    返回 p;
}

真假 是语句起(文本 t) {
    返回 t == "整数" || t == "小数" || t == "文本" || t == "真假" || t == "列表" || t == "表" ||
        t == "集合" || t == "队列" || t == "栈" ||
        t == "无" || t == "异常" || t == "参数异常" || t == "状态异常" || t == "文件异常" ||
        t == "越界异常" || t == "格式异常" ||
        t == "若" || t == "只要" || t == "对于" || t == "遍历" || t == "做" ||
        t == "择" || t == "打印" || t == "退出" || t == "返回" || t == "抛出" || t == "试" ||
        t == "区域" || t == "公开" || t == "私有" || t == "保护" || t == "内部" || t == "类" ||
        t == "接口" || t == "枚举";
}

整数 跳到分号(整数 起) {
    整数 p = 起;
    只要 (p < 词文.数量) {
        若 (词(p) == ";") { 返回 p + 1; }
        若 (p > 起 && 词类[p] == "id" && 是语句起(词(p)) && 词(p - 1) != "<") {
            返回 p;
        }
        p = p + 1;
    }
    返回 p;
}

整数 跳过块(整数 起) {
    整数 p = 起;
    只要 (p < 词文.数量 && 词(p) != 左) { p = p + 1; }
    整数 深 = 0;
    只要 (p < 词文.数量) {
        若 (词(p) == 左) { 深 = 深 + 1; }
        否则若 (词(p) == 右) {
            深 = 深 - 1;
            若 (深 == 0) { 返回 p + 1; }
        }
        p = p + 1;
    }
    返回 p;
}

整数 跳到类尾(整数 起) {
    整数 p = 起;
    只要 (p < 词文.数量 && 词(p) != 左) { p = p + 1; }
    返回 跳过块(p);
}

真假 是修饰(文本 t) {
    返回 t == "公开" || t == "私有" || t == "保护" || t == "内部" || t == "静态" || t == "只读" || t == "抽象" || t == "虚拟" || t == "覆盖" || t == "常" || t == "密封";
}

文本 读参数串(整数 起) {
    参数尾 = 起 + 1;
    文本 ps = "";
    只要 (参数尾 < 词文.数量 && 词(参数尾) != ")") {
        文本 ty = 扫类型(参数尾);
        参数尾 = 类型尾;
        若 (ps != "") { ps = ps + ","; }
        ps = ps + ty;
        参数尾 = 参数尾 + 1;
        若 (参数尾 < 词文.数量 && 词(参数尾) == ",") { 参数尾 = 参数尾 + 1; }
    }
    参数尾 = 参数尾 + 1;
    返回 ps;
}

无 收集类体(文本 类名, 整数 起) {
    整数 p = 起 + 1;
    文本 fs = "";
    文本 ms = "";
    文本 cs = "";
    文本 props = "";
    只要 (p < 词文.数量 && 词(p) != 右) {
        真假 是静 = 假;
        真假 是虚 = 假;
        真假 是覆 = 假;
        真假 是抽 = 假;
        文本 vis = "公开";
        真假 是只读 = 假;
        只要 (p < 词文.数量 && 是修饰(词(p))) {
            若 (词(p) == "静态") { 是静 = 真; }
            若 (词(p) == "虚拟") { 是虚 = 真; }
            若 (词(p) == "覆盖") { 是覆 = 真; }
            若 (词(p) == "抽象") { 是抽 = 真; 是虚 = 真; }
            若 (词(p) == "只读" || 词(p) == "常") { 是只读 = 真; }
            若 (词(p) == "私有") { vis = "私有"; }
            若 (词(p) == "保护") { vis = "保护"; }
            若 (词(p) == "内部") { vis = "内部"; }
            p = p + 1;
        }
        若 (p < 词文.数量 && 词(p) != 右) {
            若 (词(p) == 类名 && 词(p + 1) == "(") {
                文本 ps = 读参数串(p + 1);
                cs = ps;
                p = 跳过块(参数尾);
            } 否则 {
                文本 ty = 扫类型(p);
                p = 类型尾;
                文本 nm = 词(p);
                p = p + 1;
                若 (词(p) == "(") {
                    文本 ps = 读参数串(p);
                    p = 参数尾;
                    若 (nm == 类名) {
                        cs = ps;
                    } 否则 {
                        文本 sf = "0";
                        若 (是静) { sf = "1"; }
                        ms = ms + nm + "|" + ty + "|" + ps + "|" + sf + "|" + vis + "|" + 覆串(是覆) + "|" + 覆串(是虚) + "|" + 覆串(是抽) + ";";
                    }
                    若 (是抽 && 词(p) == 左) {
                        错("抽象方法不能有方法体");
                    }
                    若 (词(p) == ";" && 是抽) {
                        p = p + 1;
                    } 否则 {
                        p = 跳过块(p);
                    }
                } 否则若 (词(p) == ";") {
                    若 (是静) {
                        静态字段临时 = 静态字段临时 + nm + "|" + ty + "|" + vis + "|" + 覆串(是只读) + ";";
                    } 否则 {
                        fs = fs + nm + "|" + ty + "|" + vis + "|" + 覆串(是只读) + ";";
                    }
                    p = p + 1;
                } 否则若 (词(p) == "=") {
                    若 (是静) {
                        静态字段临时 = 静态字段临时 + nm + "|" + ty + "|" + vis + "|" + 覆串(是只读) + ";";
                    } 否则 {
                        fs = fs + nm + "|" + ty + "|" + vis + "|" + 覆串(是只读) + ";";
                    }
                    p = p + 1;
                    整数 深 = 0;
                    只要 (p < 词文.数量 && !(深 == 0 && 词(p) == ";")) {
                        若 (词(p) == 左) { 深 = 深 + 1; }
                        否则若 (词(p) == 右) { 深 = 深 - 1; }
                        p = p + 1;
                    }
                    若 (p < 词文.数量) { p = p + 1; }
                } 否则若 (词(p) == 左) {
                    整数 q = p + 1;
                    文本 gs = "0";
                    文本 ss = "0";
                    只要 (q < 词文.数量 && 词(q) != 右) {
                        若 (词(q) == "取") {
                            gs = "1";
                            q = 跳过块(q + 1);
                        } 否则若 (词(q) == "写") {
                            ss = "1";
                            q = 跳过块(q + 1);
                        } 否则 {
                            q = q + 1;
                        }
                    }
                    props = props + nm + "|" + ty + "|" + gs + "|" + ss + "|" + vis + ";";
                    p = 跳过块(p);
                } 否则 {
                    p = p + 1;
                }
            }
        }
    }
    类字段.追加(fs);
    类方法.追加(ms);
    类构造.追加(cs);
    类属性.追加(props);
}

无 收集结构() {
    整数 i = 0;
    只要 (i < 词文.数量) {
        若 (词类[i] == "id" && 词(i) == "结构") {
            文本 nm = 词(i + 1);
            整数 p = i + 2;
            只要 (p < 词文.数量 && 词(p) != 左) { p = p + 1; }
            结构名.追加(nm);
            结构体起点.追加(p);
            整数 开始 = p;
            文本 fs = "";
            文本 ms = "";
            文本 cs = "";
            p = p + 1;
            只要 (p < 词文.数量 && 词(p) != 右) {
                真假 是静 = 假;
                文本 vis = "公开";
                只要 (p < 词文.数量 && 是修饰(词(p))) {
                    若 (词(p) == "静态") { 是静 = 真; }
                    若 (词(p) == "私有") { vis = "私有"; }
                    若 (词(p) == "保护") { vis = "保护"; }
                    若 (词(p) == "内部") { vis = "内部"; }
                    p = p + 1;
                }
                若 (p < 词文.数量 && 词(p) != 右) {
                    若 (词(p) == nm && 词(p + 1) == "(") {
                        文本 ps = 读参数串(p + 1);
                        cs = ps;
                        p = 跳过块(参数尾);
                    } 否则 {
                        文本 ty = 扫类型(p);
                        p = 类型尾;
                        文本 fn = 词(p);
                        p = p + 1;
                        若 (词(p) == "(") {
                            文本 ps = 读参数串(p);
                            p = 参数尾;
                            文本 sf = "0";
                            若 (是静) { sf = "1"; }
                            ms = ms + fn + "|" + ty + "|" + ps + "|" + sf + "|" + vis + ";";
                            p = 跳过块(p);
                        } 否则若 (词(p) == ";") {
                            fs = fs + fn + "|" + ty + ";";
                            p = p + 1;
                        } 否则 {
                            p = p + 1;
                        }
                    }
                }
            }
            结构字段.追加(fs);
            结构方法.追加(ms);
            结构构造.追加(cs);
            i = 跳过块(开始);
        } 否则 {
            i = i + 1;
        }
    }
}

无 生成结构定义() {
    整数 i = 0;
    只要 (i < 结构名.数量) {
        输出 = 输出 + "typedef struct " + 左 + "\n";
        列表<文本> es = 结构字段[i].切分(";");
        整数 k = 0;
        只要 (k < es.数量) {
            若 (es[k] != "") {
                列表<文本> p = es[k].切分("|");
                输出 = 输出 + "    " + C型(p[1]) + " " + 结构字段C名(结构名[i], p[0]) + ";\n";
            }
            k = k + 1;
        }
        输出 = 输出 + 右 + " " + 结构C名(结构名[i]) + ";\n\n";
        i = i + 1;
    }
}

无 收集枚举() {
    整数 i = 0;
    只要 (i < 词文.数量) {
        若 (词类[i] == "id" && 词(i) == "枚举") {
            文本 nm = 词(i + 1);
            整数 p = i + 2;
            只要 (p < 词文.数量 && 词(p) != 左) { p = p + 1; }
            文本 items = "";
            整数 val = 0;
            整数 q = p + 1;
            只要 (q < 词文.数量 && 词(q) != 右) {
                若 (词(q) == ",") {
                    q = q + 1;
                } 否则 {
                    items = items + 词(q) + "|" + 整转文(val) + ";";
                    val = val + 1;
                    q = q + 1;
                }
            }
            枚举名.追加(nm);
            枚举项.追加(items);
            i = 跳过块(p);
        } 否则 {
            i = i + 1;
        }
    }
}

无 收集接口体(文本 名, 整数 起) {
    整数 p = 起 + 1;
    文本 ms = "";
    文本 props = "";
    只要 (p < 词文.数量 && 词(p) != 右) {
        只要 (p < 词文.数量 && 是修饰(词(p))) { p = p + 1; }
        若 (p < 词文.数量 && 词(p) != 右) {
            文本 ty = 扫类型(p);
            p = 类型尾;
            文本 nm = 词(p);
            p = p + 1;
            若 (词(p) == "(") {
                文本 ps = 读参数串(p);
                p = 参数尾;
                ms = ms + nm + "|" + ty + "|" + ps + ";";
                若 (p < 词文.数量 && 词(p) == ";") { p = p + 1; }
            } 否则若 (词(p) == 左) {
                整数 q = p + 1;
                文本 gs = "0";
                文本 ss = "0";
                只要 (q < 词文.数量 && 词(q) != 右) {
                    若 (词(q) == "取") {
                        gs = "1";
                        q = q + 1;
                        若 (q < 词文.数量 && 词(q) == 左) { q = 跳过块(q); } 否则若 (q < 词文.数量 && 词(q) == ";") { q = q + 1; }
                    } 否则若 (词(q) == "写") {
                        ss = "1";
                        q = q + 1;
                        若 (q < 词文.数量 && 词(q) == 左) { q = 跳过块(q); } 否则若 (q < 词文.数量 && 词(q) == ";") { q = q + 1; }
                    } 否则 {
                        q = q + 1;
                    }
                }
                props = props + nm + "|" + ty + "|" + gs + "|" + ss + ";";
                p = 跳过块(p);
            } 否则 {
                p = p + 1;
            }
        }
    }
    接口方法.追加(ms);
    接口属性.追加(props);
}

无 收集接口() {
    整数 i = 0;
    只要 (i < 词文.数量) {
        若 (词类[i] == "id" && 词(i) == "接口") {
            文本 nm = 词(i + 1);
            整数 p = i + 2;
            只要 (p < 词文.数量 && 词(p) != 左) { p = p + 1; }
            接口名.追加(nm);
            收集接口体(nm, p);
            i = 跳过块(p);
        } 否则 {
            i = i + 1;
        }
    }
}

无 收集类() {
    整数 i = 0;
    只要 (i < 词文.数量) {
        若 (词类[i] == "id" && 词(i) == "类") {
            文本 nm = 词(i + 1);
            真假 抽 = 假;
            真假 封 = 假;
            整数 j = i - 1;
            只要 (j >= 0 && 是修饰(词(j))) {
                若 (词(j) == "抽象") { 抽 = 真; }
                若 (词(j) == "密封") { 封 = 真; }
                j = j - 1;
            }
            整数 p = i + 2;
            文本 base = "";
            文本 ims = "";
            若 (p < 词文.数量 && 词(p) == ":") {
                p = p + 1;
                文本 n1 = 词(p);
                p = p + 1;
                若 (接口索引(n1) >= 0) {
                    ims = n1;
                } 否则 {
                    base = n1;
                }
                只要 (p < 词文.数量 && 词(p) == ",") {
                    p = p + 1;
                    文本 ni = 词(p);
                    p = p + 1;
                    若 (ims != "") { ims = ims + ","; }
                    ims = ims + ni;
                }
            }
            只要 (p < 词文.数量 && 词(p) != 左) { p = p + 1; }
            类名.追加(nm);
            类基.追加(base);
            类接口.追加(ims);
            若 (抽) { 类抽象.追加("1"); } 否则 { 类抽象.追加("0"); }
            若 (封) { 类密封.追加("1"); } 否则 { 类密封.追加("0"); }
            类体起点.追加(p);
            静态字段临时 = "";
            收集类体(nm, p);
            类静态字段.追加(静态字段临时);
            i = 跳过块(p);
        } 否则 {
            i = i + 1;
        }
    }
    i = 0;
    只要 (i < 类名.数量) {
        文本 b = 类基[i];
        若 (b != "") {
            整数 bi = 类索引(b);
            若 (bi >= 0 && 类密封[bi] == "1") { 错("密封类「" + b + "」不能被继承"); }
        }
        i = i + 1;
    }
}

文本 覆串(真假 b) {
    若 (b) { 返回 "1"; }
    返回 "0";
}

文本 方法虚拟覆盖(文本 cls, 文本 方法) {
    文本 owner = 方法属主(cls, 方法);
    若 (owner == "") { 返回 ""; }
    整数 i = 类索引(owner);
    列表<文本> es = 类方法[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 方法 && p.数量 > 6) { 返回 p[5] + "|" + p[6]; }
        }
        k = k + 1;
    }
    返回 "";
}

真假 方法抽象(文本 cls, 文本 方法) {
    文本 owner = 方法属主(cls, 方法);
    若 (owner == "") { 返回 假; }
    整数 i = 类索引(owner);
    列表<文本> es = 类方法[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 方法) {
                若 (p.数量 > 7 && p[7] == "1") { 返回 真; }
                返回 假;
            }
        }
        k = k + 1;
    }
    返回 假;
}

无 检查抽象() {
    整数 i = 0;
    只要 (i < 类名.数量) {
        列表<文本> es = 类方法[i].切分(";");
        整数 k = 0;
        只要 (k < es.数量) {
            若 (es[k] != "") {
                列表<文本> p = es[k].切分("|");
                若 (p.数量 > 7 && p[7] == "1") {
                    若 (类抽象[i] != "1") { 错("方法「" + p[0] + "」是抽象方法，类「" + 类名[i] + "」必须也是抽象类"); }
                    若 (p[3] == "1") { 错("抽象方法「" + p[0] + "」不能是静态方法"); }
                }
            }
            k = k + 1;
        }
        若 (类抽象[i] != "1") {
            文本 cur = 类基[i];
            只要 (cur != "") {
                整数 bi = 类索引(cur);
                若 (bi < 0) { cur = ""; }
                否则 {
                    列表<文本> bs = 类方法[bi].切分(";");
                    整数 q = 0;
                    只要 (q < bs.数量) {
                        若 (bs[q] != "") {
                            列表<文本> bp = bs[q].切分("|");
                            若 (bp.数量 > 7 && bp[7] == "1" && 方法抽象(类名[i], bp[0])) {
                                错("类「" + 类名[i] + "」没有实现抽象方法「" + bp[0] + "」");
                            }
                        }
                        q = q + 1;
                    }
                    cur = 类基[bi];
                }
            }
        }
        i = i + 1;
    }
}

无 检查覆盖() {
    整数 i = 0;
    只要 (i < 类名.数量) {
        文本 base = 类基[i];
        列表<文本> es = 类方法[i].切分(";");
        整数 k = 0;
        只要 (k < es.数量) {
            若 (es[k] != "") {
                列表<文本> p = es[k].切分("|");
                若 (p.数量 > 6 && p[5] == "1") {
                    文本 bm = "";
                    若 (base != "") { bm = 方法虚拟覆盖(base, p[0]); }
                    真假 可覆盖 = 假;
                    若 (bm != "") {
                        列表<文本> bp = bm.切分("|");
                        若 (bp[0] == "1" || bp[1] == "1") { 可覆盖 = 真; }
                    }
                    若 (!可覆盖) { 错("方法 " + p[0] + " 标了 覆盖，但父类没有可覆盖的 虚拟 方法"); }
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

真假 方法虚(文本 cls, 文本 方法) {
    文本 v = 方法虚拟覆盖(cls, 方法);
    若 (v == "") { 返回 假; }
    列表<文本> p = v.切分("|");
    返回 p[0] == "1" || p[1] == "1";
}

文本 类标签路径(文本 cls) {
    文本 path = "_tag";
    文本 cur = cls;
    只要 (cur != "") {
        整数 i = 类索引(cur);
        若 (i < 0) { 返回 path; }
        文本 b = 类基[i];
        若 (b == "") { 返回 path; }
        path = "base." + path;
        cur = b;
    }
    返回 path;
}

无 收集虚方法() {
    整数 i = 0;
    只要 (i < 类名.数量) {
        列表<文本> es = 类方法[i].切分(";");
        整数 k = 0;
        只要 (k < es.数量) {
            若 (es[k] != "") {
                列表<文本> p = es[k].切分("|");
                若 (p.数量 > 6 && (p[5] == "1" || p[6] == "1")) {
                    真假 已 = 假;
                    整数 q = 0;
                    只要 (q < 虚方法.数量) {
                        列表<文本> old = 虚方法[q].切分("|");
                        若 (old[0] == p[0]) {
                            已 = 真;
                            若 (old[1] != p[1] || old[2] != p[2]) { 错("虚方法 " + p[0] + " 的签名不一致"); }
                        }
                        q = q + 1;
                    }
                    若 (!已) { 虚方法.追加(p[0] + "|" + p[1] + "|" + p[2]); }
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

文本 默认C值(文本 ret) {
    若 (ret == "整数" || ret == "小数" || ret == "真假" || ret == "枚举") { 返回 "0"; }
    若 (ret == "文本") { 返回 "csay_lit(\"\")"; }
    返回 "NULL";
}

无 生成虚分派原型() {
    整数 i = 0;
    只要 (i < 虚方法.数量) {
        列表<文本> p = 虚方法[i].切分("|");
        文本 ps = 参数C串(p[2]);
        文本 tail = "void* self";
        若 (ps != "void") { tail = tail + ", " + ps; }
        输出 = 输出 + "static " + C型(p[1]) + " Csay_dispatch_" + p[0] + "(" + tail + ");\n";
        i = i + 1;
    }
}

无 生成虚分派() {
    整数 i = 0;
    只要 (i < 虚方法.数量) {
        列表<文本> p = 虚方法[i].切分("|");
        文本 ps = 参数C串(p[2]);
        文本 tail = "void* self";
        若 (ps != "void") { tail = tail + ", " + ps; }
        输出 = 输出 + "static " + C型(p[1]) + " Csay_dispatch_" + p[0] + "(" + tail + ") " + 左 + "\n";
        输出 = 输出 + "    switch (((CsayClassHeader*)self)->tag) " + 左 + "\n";
        整数 j = 0;
        只要 (j < 类名.数量) {
            若 (方法虚(类名[j], p[0]) && !方法抽象(类名[j], p[0])) {
                文本 owner = 方法属主(类名[j], p[0]);
                文本 mi = 方法项(类名[j], p[0]);
                若 (mi != "") {
                    列表<文本> mp = mi.切分("|");
                    文本 call = 方法C名(owner, p[0]) + "((" + 类C名(owner) + "*)self";
                    整数 a = 0;
                    只要 (a < p[2].切分(",").数量) {
                        若 (p[2] != "void" && p[2] != "") { call = call + ", a" + 整转文(a); }
                        a = a + 1;
                    }
                    call = call + ")";
                    输出 = 输出 + "        case " + 整转文(j + 1) + "LL:\n";
                    若 (p[1] == "无") { 输出 = 输出 + "            " + call + ";\n"; }
                    否则 { 输出 = 输出 + "            return " + call + ";\n"; }
                }
            }
            j = j + 1;
        }
        输出 = 输出 + "        default:\n";
        若 (p[1] == "无") { 输出 = 输出 + "            return;\n"; }
        否则 { 输出 = 输出 + "            return " + 默认C值(p[1]) + ";\n"; }
        输出 = 输出 + "    " + 右 + "\n";
        输出 = 输出 + "}\n\n";
        i = i + 1;
    }
}

无 收集委托名() {
    整数 i = 0;
    整数 深 = 0;
    只要 (i < 词文.数量) {
        文本 t = 词(i);
        若 (t == 左) {
            深 = 深 + 1;
            i = i + 1;
        } 否则若 (t == 右) {
            深 = 深 - 1;
            i = i + 1;
        } 否则若 (深 == 0 && 词类[i] == "id" && t == "委托" && i + 2 < 词文.数量 && 词类[i + 1] == "id") {
            文本 nm = 词(i + 1);
            若 (委托索引(nm) < 0) {
                委托名.追加(nm);
                委托参数.追加("");
                委托返回.追加("无");
            }
            i = i + 2;
            只要 (i < 词文.数量 && 词(i) != ";") { i = i + 1; }
            若 (i < 词文.数量) { i = i + 1; }
        } 否则 {
            i = i + 1;
        }
    }
}

无 收集委托签名() {
    整数 i = 0;
    只要 (i < 词文.数量) {
        若 (词(i) == "委托" && 词类[i] == "id" && i + 2 < 词文.数量 && 词类[i + 1] == "id" && 词(i + 2) == "(") {
            文本 nm = 词(i + 1);
            整数 j = i + 3;
            文本 ps = "";
            若 (j < 词文.数量 && 词(j) != ")") {
                真假 完 = 假;
                只要 (!完) {
                    文本 ty = 扫类型(j);
                    j = 类型尾;
                    若 (j < 词文.数量 && 词类[j] == "id") { j = j + 1; }
                    若 (ps != "") { ps = ps + ","; }
                    ps = ps + ty;
                    若 (j < 词文.数量 && 词(j) == ",") { j = j + 1; } 否则 { 完 = 真; }
                }
            }
            若 (j < 词文.数量 && 词(j) == ")") { j = j + 1; }
            若 (j < 词文.数量 && 词(j) == ":") { j = j + 1; }
            文本 rt = "无";
            若 (j < 词文.数量) { rt = 扫类型(j); j = 类型尾; }
            整数 k = 委托索引(nm);
            若 (k >= 0) {
                委托参数[k] = ps;
                委托返回[k] = rt;
            }
            i = j;
        } 否则 {
            i = i + 1;
        }
    }
}

无 收集声明() {
    整数 i = 0;
    整数 深 = 0;
    只要 (i < 词文.数量) {
        文本 t = 词(i);
        若 (t == 左) {
            深 = 深 + 1;
            i = i + 1;
        } 否则若 (t == 右) {
            深 = 深 - 1;
            i = i + 1;
        } 否则若 (深 == 0 && 词类[i] == "id" && t == "类") {
            i = 跳到类尾(i);
        } 否则若 (深 == 0 && 词类[i] == "id" && t == "接口") {
            i = 跳到类尾(i);
        } 否则若 (深 == 0 && 词类[i] == "id" && t == "枚举") {
            i = 跳到类尾(i);
        } 否则若 (深 == 0 && 词类[i] == "id" && t == "结构") {
            i = 跳到类尾(i);
        } 否则若 (深 == 0 && 词类[i] == "id" && t == "委托") {
            i = i + 2;
            只要 (i < 词文.数量 && 词(i) != ";") { i = i + 1; }
            若 (i < 词文.数量) { i = i + 1; }
        } 否则若 (深 == 0 && 是类型(t) && 词类[i] == "id") {
            文本 ty = 扫类型(i);
            整数 j = 类型尾;
            若 (j < 词文.数量 && 词类[j] == "id") {
                文本 nm = 词(j);
                文本 nx = 词(j + 1);
                若 (nx == "(") {
                    收集函数签名(nm, ty, j + 1);
                    i = 跳过函数(j + 1);
                } 否则 {
                    全局名.追加(nm);
                    全局类型.追加(ty);
                    声明(nm, ty);
                    i = j + 1;
                    若 (i < 词文.数量 && 词(i) == ";") { i = i + 1; }
                }
            } 否则 {
                i = 类型尾;
            }
        } 否则 {
            i = i + 1;
        }
    }
}

无 追加输出(文本 s) {
    若 (当前区 == "init") {
        初始化输出 = 初始化输出 + s;
    } 否则若 (当前区 == "func") {
        函数输出 = 函数输出 + s;
    } 否则若 (当前区 == "class") {
        类输出 = 类输出 + s;
    } 否则若 (当前区 == "iface") {
        接口输出 = 接口输出 + s;
    } 否则若 (当前区 == "lambda") {
        委托实现 = 委托实现 + s;
    } 否则 {
        主输出 = 主输出 + s;
    }
}

无 追加行(文本 s) {
    追加输出(s + "\n");
}

文本 C转义(文本 s) {
    文本 o = "";
    整数 i = 0;
    只要 (i < s.长度) {
        文本 c = s[i];
        若 (c == "\"") { o = o + "\\\""; }
        否则若 (c == "\\") {
            文本 nx = 取字(i + 1);
            若 (nx == 左 || nx == 右) {
                o = o + nx;
                i = i + 1;
            } 否则 {
                o = o + "\\\\";
            }
        }
        否则若 (c == "\n") { o = o + "\\n"; }
        否则若 (c == "\r") { o = o + "\\r"; }
        否则若 (c == "\t") { o = o + "\\t"; }
        否则 { o = o + c; }
        i = i + 1;
    }
    返回 o;
}

文本 C串(文本 s) {
    返回 "csay_lit(\"" + C转义(s) + "\")";
}

文本 包(文本 t, 文本 c) {
    返回 t + "\n" + c;
}

文本 果类型(文本 r) {
    列表<文本> p = r.切分("\n");
    返回 p[0];
}

文本 果码(文本 r) {
    列表<文本> p = r.切分("\n");
    返回 p[1];
}

文本 读类型() {
    文本 t = 扫类型(位置);
    位置 = 类型尾;
    返回 t;
}

文本 默认值(文本 t) {
    若 (t == "整数") { 返回 "0"; }
    若 (t == "小数") { 返回 "0.0"; }
    若 (t == "真假") { 返回 "false"; }
    若 (t == "文本") { 返回 "csay_lit(\"\")"; }
    若 (t == "异常") { 返回 "csay_error(csay_lit(\"\"), 0)"; }
    若 (t == "参数异常" || t == "状态异常" || t == "文件异常" || t == "越界异常" || t == "格式异常") { 返回 "csay_error(csay_lit(\"\"), 0)"; }
    列表<文本> p = t.切分(":");
    若 (p[0] == "接口") { 返回 左 + " 0, 0 " + 右; }
    若 (p[0] == "委托") { 返回 "(" + C型(t) + ")" + 左 + " 0 " + 右; }
    若 (p[0] == "枚举") { 返回 "0"; }
    若 (p[0] == "结构") { 返回 左 + " 0 " + 右; }
    返回 "NULL";
}

文本 表达式() {
    文本 c = 逻辑或();
    若 (是("?")) {
        进();
        文本 a = 表达式();
        要(":");
        文本 b = 表达式();
        文本 at = 果类型(a);
        文本 bt = 果类型(b);
        文本 rt = at;
        若 (at != bt) {
            若 (at == "小数" || bt == "小数") {
                rt = "小数";
            } 否则若 (at == "整数" && bt == "整数") {
                rt = "整数";
            } 否则 {
                错("三元表达式两边类型不一致");
            }
        }
        返回 包(rt, "(" + 果码(c) + " ? " + 果码(a) + " : " + 果码(b) + ")");
    }
    返回 c;
}

文本 逻辑或() {
    文本 l = 逻辑与();
    只要 (是("||")) {
        进();
        文本 r = 逻辑与();
        l = 包("真假", "(" + 果码(l) + " || " + 果码(r) + ")");
    }
    返回 l;
}

文本 逻辑与() {
    文本 l = 比较();
    只要 (是("&&")) {
        进();
        文本 r = 比较();
        l = 包("真假", "(" + 果码(l) + " && " + 果码(r) + ")");
    }
    返回 l;
}

文本 比较() {
    文本 l = 加减();
    只要 (是("==") || 是("!=") || 是("<") || 是("<=") || 是(">") || 是(">=")) {
        文本 op = 当();
        进();
        文本 r = 加减();
        若 (op == "==" || op == "!=") {
            若 (果类型(l) == "文本" && 果类型(r) == "文本") {
                文本 eq = "csay_str_eq(" + 果码(l) + ", " + 果码(r) + ")";
                若 (op == "!=") { eq = "(!" + eq + ")"; }
                l = 包("真假", eq);
            } 否则 {
                l = 包("真假", "(" + 果码(l) + " " + op + " " + 果码(r) + ")");
            }
        } 否则 {
            l = 包("真假", "(" + 果码(l) + " " + op + " " + 果码(r) + ")");
        }
    }
    返回 l;
}

文本 加减() {
    文本 l = 乘除();
    只要 (是("+") || 是("-")) {
        文本 op = 当();
        进();
        文本 r = 乘除();
        若 (op == "+") {
            若 (果类型(l) == "文本" && 果类型(r) == "文本") {
                l = 包("文本", "csay_cat(" + 果码(l) + ", " + 果码(r) + ")");
            } 否则若 (果类型(l) == "小数" || 果类型(r) == "小数") {
                l = 包("小数", "(" + 果码(l) + " + " + 果码(r) + ")");
            } 否则 {
                l = 包("整数", "(" + 果码(l) + " + " + 果码(r) + ")");
            }
        } 否则 {
            若 (果类型(l) == "小数" || 果类型(r) == "小数") {
                l = 包("小数", "(" + 果码(l) + " - " + 果码(r) + ")");
            } 否则 {
                l = 包("整数", "(" + 果码(l) + " - " + 果码(r) + ")");
            }
        }
    }
    返回 l;
}

文本 乘除() {
    文本 l = 一元();
    只要 (是("*") || 是("/") || 是("%")) {
        文本 op = 当();
        进();
        文本 r = 一元();
        若 (果类型(l) == "小数" || 果类型(r) == "小数") {
            l = 包("小数", "(" + 果码(l) + " " + op + " " + 果码(r) + ")");
        } 否则 {
            l = 包("整数", "(" + 果码(l) + " " + op + " " + 果码(r) + ")");
        }
    }
    返回 l;
}

文本 一元() {
    若 (词类[位置] == "op" && 是("!")) {
        进();
        文本 v = 一元();
        返回 包("真假", "(!" + 果码(v) + ")");
    }
    若 (词类[位置] == "op" && 是("-")) {
        进();
        文本 v = 一元();
        若 (果类型(v) == "小数") {
            返回 包("小数", "(-" + 果码(v) + ")");
        }
        返回 包("整数", "(-" + 果码(v) + ")");
    }
    若 (词类[位置] == "op" && (是("++") || 是("--"))) {
        文本 op = 当();
        进();
        文本 v = 一元();
        返回 包(果类型(v), "(" + op + 果码(v) + ")");
    }
    返回 后缀();
}

文本 后缀() {
    上次字段只读 = 假;
    上次字段名 = "";
    文本 r = 主();
    只要 (是(".") || 是("[")) {
        若 (是("[")) {
            进();
            文本 i = 表达式();
            要("]");
            文本 ty = 果类型(r);
            列表<文本> tp = ty.切分(":");
            若 (tp[0] == "表") {
                文本 k = tp[1];
                文本 v = tp[2];
                r = 包(v, "(*(" + C型(v) + "*)csay_map_at(" + 果码(r) + ", " + 取址(k, 果码(i)) + "))");
            } 否则若 (ty == "文本") {
                r = 包("文本", "csay_char_at(" + 果码(r) + ", " + 果码(i) + ")");
            } 否则若 (ty == "列表:文本") {
                r = 包("文本", "(*(CsayStr*)csay_list_at(" + 果码(r) + ", " + 果码(i) + "))");
            } 否则若 (ty == "列表:整数") {
                r = 包("整数", "(*(CsayInt*)csay_list_at(" + 果码(r) + ", " + 果码(i) + "))");
            } 否则若 (ty.含("列表:")) {
                文本 elem = 元素型(ty);
                r = 包(elem, "(*( " + C型(elem) + "*)csay_list_at(" + 果码(r) + ", " + 果码(i) + "))");
            } 否则 {
                错("类型 " + ty + " 不能取下标");
            }
        } 否则 {
            进();
            文本 nm = 当();
            进();
            文本 rty = 果类型(r);
            列表<文本> rp = rty.切分(":");
            若 (rp[0] == "条目") {
                若 (nm == "键") {
                    r = 包(rp[1], 果码(r) + ".key");
                } 否则若 (nm == "值") {
                    r = 包(rp[2], 果码(r) + ".val");
                } 否则 {
                    错("条目只有 键/值");
                }
            } 否则若 (rty == "异常") {
                若 (nm == "信息") {
                    r = 包("文本", "(" + 果码(r) + ").msg");
                } 否则若 (nm == "类型") {
                    r = 包("文本", "csay_error_kind_name((" + 果码(r) + ").kind)");
                } 否则 {
                    错("异常只有 信息/类型 成员");
                }
            } 否则若 (rp[0] == "枚举") {
                文本 iname = rp[1];
                r = 包("枚举:" + iname, 枚举项C名(iname, nm));
            } 否则若 (rp[0] == "委托") {
                文本 dn = rp[1];
                若 (!是("(")) { 错("委托只能调用"); }
                进();
                文本 args = 委托调用参数(dn);
                文本 tmp = "dg" + 整转文(委托计数);
                委托计数 = 委托计数 + 1;
                文本 tail = "";
                若 (args != "") { tail = ", " + args; }
                r = 包(委托信息(委托返回, dn), "(" + 左 + " " + C型(rty) + " " + tmp + " = " + 果码(r) + "; if (" + tmp + ".fn == NULL) csay_throw_error(csay_error(csay_str(\"委托为空\", 12), 2)); " + tmp + ".fn(" + tmp + ".env" + tail + "); " + 右 + ")");
            } 否则若 (rp[0] == "接口") {
                文本 iname = rp[1];
                若 (是("(")) {
                    进();
                    文本 args = 调用参数();
                    文本 mi = 接口方法项(iname, nm);
                    若 (mi == "") { 错("接口 " + iname + " 没有方法 " + nm); }
                    列表<文本> mp = mi.切分("|");
                    文本 tail = "";
                    若 (args != "") { tail = ", " + args; }
                    r = 包(mp[0], 接口方法C名(iname, nm) + "(" + 果码(r) + tail + ")");
                } 否则 {
                    文本 pi = 接口属性项(iname, nm);
                    若 (pi == "") { 错("接口 " + iname + " 没有成员 " + nm); }
                    列表<文本> ap = pi.切分("|");
                    若 (ap[1] == "1") {
                        r = 包(ap[0], 接口属性取C名(iname, nm) + "(" + 果码(r) + ")");
                    } 否则 {
                        错("接口属性 " + nm + " 没有 取");
                    }
                }
            } 否则若 (rp[0] == "结构") {
                文本 sn = rp[1];
                若 (是("(")) {
                    进();
                    文本 args = 调用参数();
                    文本 mi = 结构方法项(sn, nm);
                    若 (mi == "") { 错("结构 " + sn + " 没有方法 " + nm); }
                    列表<文本> mp = mi.切分("|");
                    文本 tail = "";
                    若 (args != "") { tail = ", " + args; }
                    若 (结构方法静态(sn, nm)) {
                        r = 包(mp[0], 结构方法C名(sn, nm) + "(" + args + ")");
                    } 否则 {
                        文本 recv = 果码(r);
                        若 (recv == "self") { recv = "self"; }
                        否则 { recv = "(&(" + recv + "))"; }
                        r = 包(mp[0], 结构方法C名(sn, nm) + "(" + recv + tail + ")");
                    }
                } 否则 {
                    文本 ft = 结构字段类型(sn, nm);
                    若 (ft == "") { 错("结构 " + sn + " 没有字段 " + nm); }
                    文本 base = 果码(r);
                    若 (base == "self") { base = "self->"; }
                    否则 { base = base + "."; }
                    r = 包(ft, base + 结构字段C名(sn, nm));
                }
            } 否则若 (rp[0] == "类") {
                文本 cn = rp[1];
                若 (是("(")) {
                    文本 ft = 字段类型(cn, nm);
                    若 (ft.切分(":")[0] == "委托") {
                        进();
                        文本 dn = ft.切分(":")[1];
                        文本 args = 委托调用参数(dn);
                        文本 tmp = "dg" + 整转文(委托计数);
                        委托计数 = 委托计数 + 1;
                        文本 tail = "";
                        若 (args != "") { tail = ", " + args; }
                        文本 recv = 果码(r) + "->" + 字段路径(cn, nm);
                        上次字段名 = nm;
                        上次字段只读 = 字段只读(cn, nm);
                        r = 包(委托信息(委托返回, dn), "(" + 左 + " " + C型(ft) + " " + tmp + " = " + recv + "; if (" + tmp + ".fn == NULL) csay_throw_error(csay_error(csay_str(\"委托为空\", 12), 2)); " + tmp + ".fn(" + tmp + ".env" + tail + "); " + 右 + ")");
                    } 否则 {
                        进();
                        文本 args = 调用参数();
                        文本 owner = 方法属主(cn, nm);
                        文本 mi = 方法项(cn, nm);
                        若 (mi == "") { 错("类 " + cn + " 没有方法 " + nm); }
                        若 (!方法可见(owner, nm)) { 错("不能访问私有方法 " + nm); }
                        列表<文本> mp = mi.切分("|");
                        文本 tail = "";
                        若 (args != "") { tail = ", " + args; }
                        真假 是基 = 当前基 != "" && 果码(r) == "((" + 类C名(当前基) + "*)self)";
                        若 (!是基 && 方法虚(owner, nm)) {
                            r = 包(mp[0], "Csay_dispatch_" + nm + "(" + 果码(r) + tail + ")");
                        } 否则若 (方法静态(owner, nm)) {
                            r = 包(mp[0], 方法C名(owner, nm) + "(" + args + ")");
                        } 否则 {
                            r = 包(mp[0], 方法C名(owner, nm) + "(((" + 类C名(owner) + "*)" + 果码(r) + ")" + tail + ")");
                        }
                    }
                } 否则 {
                    文本 pi = 属性项(cn, nm);
                    若 (pi != "") {
                        若 (!属性可见(cn, nm)) { 错("不能访问私有属性 " + nm); }
                        列表<文本> ap = pi.切分("|");
                        若 (ap[1] == "1") {
                            r = 包(ap[0], 属性取C名(cn, nm) + "(" + 果码(r) + ")");
                        } 否则 {
                            错("属性 " + nm + " 没有 取 访问器");
                        }
                    } 否则 {
                        文本 st = 静态字段项(cn, nm);
                        若 (st != "") {
                            若 (!静态字段可见(cn, nm)) { 错("不能访问私有静态字段 " + nm); }
                            r = 包(st, 静态字段C名(cn, nm));
                        } 否则 {
                            文本 ft = 字段类型(cn, nm);
                            文本 path = 字段路径(cn, nm);
                            若 (ft == "" || path == "") { 错("类 " + cn + " 没有字段 " + nm); }
                            若 (!字段可见(cn, nm)) { 错("不能访问私有字段 " + nm); }
                            上次字段只读 = 字段只读(cn, nm);
                            上次字段名 = nm;
                            r = 包(ft, 果码(r) + "->" + path);
                        }
                    }
                }
            } 否则若 (rp[0] == "表") {
                文本 k = rp[1];
                文本 v = rp[2];
                若 (是("(")) {
                    进();
                    若 (nm == "含") {
                        文本 a = 表达式();
                        要(")");
                        r = 包("真假", "csay_map_has(" + 果码(r) + ", " + 取址(k, 果码(a)) + ")");
                    } 否则若 (nm == "取值") {
                        文本 a = 表达式();
                        要(",");
                        文本 b = 表达式();
                        要(")");
                        r = 包(v, "(*(" + C型(v) + "*)csay_map_ptr_or(" + 果码(r) + ", " + 取址(k, 果码(a)) + ", " + 取址(v, 果码(b)) + "))");
                    } 否则若 (nm == "设置") {
                        文本 a = 表达式();
                        要(",");
                        文本 b = 表达式();
                        要(")");
                        r = 包("无", "csay_map_set(" + 果码(r) + ", " + 取址(k, 果码(a)) + ", " + 取址(v, 果码(b)) + ")");
                    } 否则若 (nm == "删除") {
                        文本 a = 表达式();
                        要(")");
                        r = 包("无", "csay_map_remove(" + 果码(r) + ", " + 取址(k, 果码(a)) + ")");
                    } 否则若 (nm == "条目") {
                        要(")");
                        r = 包("列表:条目:" + k + ":" + v, "csay_map_entries_" + k + "_" + v + "(" + 果码(r) + ")");
                    } 否则 {
                        错("表没有方法 " + nm);
                    }
                } 否则若 (nm == "数量") {
                    r = 包("整数", 果码(r) + "->len");
                } 否则 {
                    错("表没有成员 " + nm);
                }
            } 否则若 (是("(")) {
                进();
                若 (nm == "插入") {
                    文本 idx = 表达式();
                    要(",");
                    文本 val = 表达式();
                    要(")");
                    列表<文本> tp = 果类型(r).切分(":");
                    文本 elem = tp[1];
                    r = 包("无", "(" + 左 + " " + C型(elem) + " v = " + 果码(val) + "; csay_list_insert(" + 果码(r) + ", " + 果码(idx) + ", &v); " + 右 + ")");
                } 否则若 (nm == "删除") {
                    文本 idx = 表达式();
                    要(")");
                    r = 包("无", "csay_list_remove(" + 果码(r) + ", " + 果码(idx) + ")");
                } 否则若 (nm == "清空") {
                    要(")");
                    r = 包("无", "csay_list_clear(" + 果码(r) + ")");
                } 否则若 (nm == "排序") {
                    要(")");
                    列表<文本> tp = 果类型(r).切分(":");
                    文本 fn = "csay_cmp_int";
                    若 (tp[1] == "文本") { fn = "csay_cmp_str"; }
                    若 (tp[1] == "小数") { fn = "csay_cmp_float"; }
                    r = 包("无", "csay_list_sort(" + 果码(r) + ", " + fn + ")");
                } 否则若 (nm == "反转") {
                    要(")");
                    r = 包("无", "csay_list_reverse(" + 果码(r) + ")");
                } 否则若 (nm == "去重") {
                    要(")");
                    列表<文本> tp = 果类型(r).切分(":");
                    文本 fn = "csay_list_unique_int";
                    若 (tp[1] == "文本") { fn = "csay_list_unique_str"; }
                    若 (tp[1] == "小数") { fn = "csay_list_unique_float"; }
                    r = 包("无", fn + "(" + 果码(r) + ")");
                } 否则若 (nm == "切片") {
                    文本 a = 表达式();
                    要(",");
                    文本 b = 表达式();
                    要(")");
                    r = 包(果类型(r), "csay_list_slice(" + 果码(r) + ", " + 果码(a) + ", " + 果码(b) + ")");
                } 否则若 (nm == "查找") {
                    文本 a = 表达式();
                    要(")");
                    列表<文本> tp = 果类型(r).切分(":");
                    文本 fn = "csay_list_index_int";
                    若 (tp[1] == "文本") { fn = "csay_list_index_str"; }
                    若 (tp[1] == "小数") { fn = "csay_list_index_float"; }
                    r = 包("整数", fn + "(" + 果码(r) + ", " + 果码(a) + ")");
                } 否则若 (nm == "最大") {
                    要(")");
                    列表<文本> tp = 果类型(r).切分(":");
                    文本 fn = "csay_list_max_int";
                    文本 et = "整数";
                    若 (tp[1] == "文本") { fn = "csay_list_max_str"; et = "文本"; }
                    若 (tp[1] == "小数") { fn = "csay_list_max_float"; et = "小数"; }
                    r = 包(et, fn + "(" + 果码(r) + ")");
                } 否则若 (nm == "追加") {
                    文本 a = 表达式();
                    要(")");
                    文本 ty = 果类型(r);
                    若 (ty == "列表:文本") {
                        r = 包("无", "csay_list_push_str(" + 果码(r) + ", " + 果码(a) + ")");
                    } 否则若 (ty == "列表:整数") {
                        r = 包("无", "csay_list_push_int(" + 果码(r) + ", " + 果码(a) + ")");
                    } 否则 {
                        文本 elem = 元素型(ty);
                        r = 包("无", "(" + 左 + " " + C型(elem) + " v = " + 果码(a) + "; csay_list_add(" + 果码(r) + ", &v); " + 右 + ")");
                    }
                } 否则若 (nm == "集合添加") {
                    文本 a = 表达式();
                    要(")");
                    文本 et = 元素型(果类型(r));
                    文本 sf = "int";
                    若 (et == "文本") { sf = "str"; }
                    若 (et == "小数") { sf = "float"; }
                    若 (et == "真假") { sf = "bool"; }
                    r = 包("真假", "csay_list_add_unique_" + sf + "(" + 果码(r) + ", " + 果码(a) + ")");
                } 否则若 (nm == "入队" || nm == "入栈") {
                    文本 a = 表达式();
                    要(")");
                    文本 et = 元素型(果类型(r));
                    r = 包("无", "(" + 左 + " " + C型(et) + " v = " + 果码(a) + "; csay_list_add(" + 果码(r) + ", &v); " + 右 + ")");
                } 否则若 (nm == "出队" || nm == "出栈") {
                    要(")");
                    文本 et = 元素型(果类型(r));
                    文本 sf = "int";
                    若 (et == "文本") { sf = "str"; }
                    若 (et == "小数") { sf = "float"; }
                    若 (et == "真假") { sf = "bool"; }
                    文本 side = "front";
                    若 (nm == "出栈") { side = "back"; }
                    r = 包(et, "csay_list_pop_" + side + "_" + sf + "(" + 果码(r) + ")");
                } 否则若 (nm == "切分") {
                    文本 a = 表达式();
                    要(")");
                    r = 包("列表:文本", "csay_split(" + 果码(r) + ", " + 果码(a) + ")");
                } 否则若 (nm == "切分空白") {
                    要(")");
                    r = 包("列表:文本", "csay_split_ws(" + 果码(r) + ")");
                } 否则若 (nm == "转整数") {
                    要(")");
                    r = 包("整数", "csay_str_to_int(" + 果码(r) + ")");
                } 否则若 (nm == "转小数") {
                    要(")");
                    r = 包("小数", "csay_str_to_float(" + 果码(r) + ")");
                } 否则若 (nm == "替换") {
                    文本 a = 表达式();
                    要(",");
                    文本 b = 表达式();
                    要(")");
                    r = 包("文本", "csay_str_replace(" + 果码(r) + ", " + 果码(a) + ", " + 果码(b) + ")");
                } 否则若 (nm == "含") {
                    文本 a = 表达式();
                    要(")");
                    r = 包("真假", "csay_str_contains(" + 果码(r) + ", " + 果码(a) + ")");
                } 否则若 (nm == "转大写") {
                    要(")");
                    r = 包("文本", "csay_str_upper(" + 果码(r) + ")");
                } 否则若 (nm == "转小写") {
                    要(")");
                    r = 包("文本", "csay_str_lower(" + 果码(r) + ")");
                } 否则若 (nm == "去除空白") {
                    要(")");
                    r = 包("文本", "csay_str_trim(" + 果码(r) + ")");
                } 否则 {
                    错("未知成员方法 " + nm);
                }
            } 否则 {
                若 (nm == "长度") {
                    若 (果类型(r) == "文本") {
                        r = 包("整数", "csay_utf8_len(" + 果码(r) + ")");
                    } 否则若 (果类型(r).含("列表:")) {
                        r = 包("整数", 果码(r) + "->len");
                    } 否则 {
                        错("长度 只能用于文本或列表");
                    }
                } 否则若 (nm == "数量") {
                    若 (果类型(r).含("列表:")) {
                        r = 包("整数", 果码(r) + "->len");
                    } 否则 {
                        错("数量 只能用于列表");
                    }
                } 否则 {
                    错("未知成员 " + nm);
                }
            }
        }
    }
    若 (是("++") || 是("--")) {
        文本 op = 当();
        进();
        返回 包(果类型(r), "(" + 果码(r) + op + ")");
    }
    返回 r;
}

文本 调用参数() {
    文本 args = "";
    若 (!是(")")) {
        真假 完 = 假;
        只要 (!完) {
            文本 a = 表达式();
            若 (args != "") { args = args + ", "; }
            args = args + 果码(a);
            若 (是(",")) { 进(); } 否则 { 完 = 真; }
        }
    }
    要(")");
    返回 args;
}

文本 委托调用参数(文本 dn) {
    文本 ps = 委托信息(委托参数, dn);
    列表<文本> pt = ps.切分(",");
    文本 args = "";
    整数 i = 0;
    若 (!是(")")) {
        真假 完 = 假;
        只要 (!完) {
            文本 a = 表达式();
            文本 target = "";
            若 (ps != "" && i < pt.数量) { target = pt[i]; }
            若 (target != "") {
                a = 包(target, 转目标(target, 果类型(a), 果码(a)));
            }
            若 (args != "") { args = args + ", "; }
            args = args + 果码(a);
            i = i + 1;
            若 (是(",")) { 进(); } 否则 { 完 = 真; }
        }
    }
    要(")");
    返回 args;
}

文本 调用参数到(文本 ps) {
    列表<文本> pt = ps.切分(",");
    文本 args = "";
    整数 i = 0;
    若 (!是(")")) {
        真假 完 = 假;
        只要 (!完) {
            文本 a = 表达式();
            文本 target = "";
            若 (ps != "" && i < pt.数量) { target = pt[i]; }
            若 (target == "") { 错("参数数量不匹配"); }
            a = 包(target, 转目标(target, 果类型(a), 果码(a)));
            若 (args != "") { args = args + ", "; }
            args = args + 果码(a);
            i = i + 1;
            若 (是(",")) { 进(); } 否则 { 完 = 真; }
        }
    }
    要(")");
    返回 args;
}

文本 合并(文本 a, 文本 b) {
    若 (a == "") { 返回 b; }
    返回 "csay_cat(" + a + ", " + b + ")";
}

文本 转文本码(文本 ty, 文本 code) {
    若 (ty == "文本") { 返回 code; }
    若 (ty == "整数") { 返回 "csay_str_of_int(" + code + ")"; }
    若 (ty == "小数") { 返回 "csay_str_of_float(" + code + ")"; }
    若 (ty == "真假") { 返回 "csay_str_of_bool(" + code + ")"; }
    若 (ty == "异常") { 返回 "(" + code + ").msg"; }
    列表<文本> p = ty.切分(":");
    若 (p[0] == "枚举") { 返回 "csay_str_of_int(" + code + ")"; }
    错("插值表达式类型 " + ty + " 不能转文本");
    返回 code;
}

文本 解析子表达式(文本 code) {
    文本 旧源 = 源;
    列表<文本> 旧词 = 词文;
    列表<文本> 旧类 = 词类;
    整数 旧位 = 位置;
    源 = code;
    词文 = 新 列表<文本>();
    词类 = 新 列表<文本>();
    位置 = 0;
    分词();
    文本 r = 表达式();
    源 = 旧源;
    词文 = 旧词;
    词类 = 旧类;
    位置 = 旧位;
    返回 r;
}

文本 生成串(文本 s) {
    文本 out = "";
    文本 buf = "";
    整数 i = 0;
    只要 (i < s.长度) {
        文本 c = s[i];
        若 (c == "\\" && i + 1 < s.长度 && (s[i + 1] == 左 || s[i + 1] == 右)) {
            buf = buf + s[i + 1];
            i = i + 2;
        } 否则若 (c == 左) {
            若 (buf != "") {
                out = 合并(out, C串(buf));
                buf = "";
            }
            整数 j = i + 1;
            文本 ex = "";
            只要 (j < s.长度 && s[j] != 右) {
                ex = ex + s[j];
                j = j + 1;
            }
            文本 r = 解析子表达式(ex);
            out = 合并(out, 转文本码(果类型(r), 果码(r)));
            i = j + 1;
        } 否则 {
            buf = buf + c;
            i = i + 1;
        }
    }
    若 (buf != "") { out = 合并(out, C串(buf)); }
    若 (out == "") { 返回 "csay_lit(\"\")"; }
    返回 out;
}

真假 像Lambda() {
    若 (!是("(")) { 返回 假; }
    整数 i = 位置;
    整数 深 = 0;
    只要 (i < 词文.数量) {
        文本 t = 词(i);
        若 (t == "(") {
            深 = 深 + 1;
        } 否则若 (t == ")") {
            深 = 深 - 1;
            若 (深 == 0) {
                返回 i + 1 < 词文.数量 && 词(i + 1) == "=>";
            }
        }
        i = i + 1;
    }
    返回 假;
}

真假 文列含(列表<文本> xs, 文本 v) {
    整数 i = 0;
    只要 (i < xs.数量) {
        若 (xs[i] == v) { 返回 真; }
        i = i + 1;
    }
    返回 假;
}

整数 Lambda体止(整数 起) {
    整数 i = 起;
    整数 深 = 0;
    若 (i < 词文.数量 && 词(i) == 左) {
        只要 (i < 词文.数量) {
            文本 t = 词(i);
            若 (t == 左) { 深 = 深 + 1; }
            若 (t == 右) {
                深 = 深 - 1;
                若 (深 == 0) { 返回 i + 1; }
            }
            i = i + 1;
        }
        返回 i;
    }
    只要 (i < 词文.数量) {
        文本 t = 词(i);
        若 (深 == 0 && i > 起 && t != "打印" && 是语句起(t)) { 返回 i; }
        若 (t == "(" || t == "[" || t == 左) {
            深 = 深 + 1;
        } 否则若 (t == ")" || t == "]" || t == 右) {
            若 (深 == 0) { 返回 i; }
            深 = 深 - 1;
        } 否则若 (深 == 0 && (t == "," || t == ";")) {
            返回 i;
        }
        i = i + 1;
    }
    返回 i;
}

无 收集Lambda捕获(整数 起, 整数 止, 列表<文本> 参数名, 列表<文本> 捕获名, 列表<文本> 捕获型, 列表<文本> 捕获码) {
    整数 i = 起;
    只要 (i < 止) {
        若 (词类[i] == "id") {
            文本 t = 词(i);
            若 ((t == "自" || t == "基") && 当前类 != "") {
                若 (!文列含(捕获名, "自")) {
                    捕获名.追加("自");
                    捕获型.追加("类:" + 当前类);
                    捕获码.追加("self");
                }
            } 否则若 (!文列含(参数名, t) && !文列含(全局名, t) && t != 当前声明) {
                文本 ty = 查类型(t);
                若 (ty != "") {
                    若 (ty.含("[]")) { 错("Lambda 暂不支持捕获数组"); }
                    若 (!文列含(捕获名, t)) {
                        捕获名.追加(t);
                        捕获型.追加(ty);
                        捕获码.追加(变量C名(t));
                    }
                }
            }
        }
        i = i + 1;
    }
}

文本 生成Lambda() {
    委托计数 = 委托计数 + 1;
    文本 编号 = 整转文(委托计数);
    文本 fn = "Csay_lambda_" + 编号;
    文本 旧前缀 = 前缀;
    文本 旧区 = 当前区;
    文本 旧类 = 当前类;
    文本 旧基 = 当前基;
    文本 旧结构 = 当前结构;
    文本 旧返回 = 当前返回;
    文本 旧参数名串 = 参数名串;
    真假 旧构造 = 当前构造;
    真假 旧Lambda = 在Lambda;
    整数 旧使用深 = 使用深;
    要("(");
    列表<文本> 参数型 = 新 列表<文本>();
    列表<文本> 参数名 = 新 列表<文本>();
    若 (!是(")")) {
        真假 完 = 假;
        只要 (!完) {
            文本 ty = 读类型();
            文本 nm = 当();
            进();
            参数型.追加(ty);
            参数名.追加(nm);
            若 (是(",")) { 进(); } 否则 { 完 = 真; }
        }
    }
    要(")");
    要("=>");
    整数 体起 = 位置;
    整数 体止 = Lambda体止(体起);
    列表<文本> 捕获名 = 新 列表<文本>();
    列表<文本> 捕获型 = 新 列表<文本>();
    列表<文本> 捕获码 = 新 列表<文本>();
    收集Lambda捕获(体起, 体止, 参数名, 捕获名, 捕获型, 捕获码);
    真假 捕自 = 文列含(捕获名, "自");
    前缀 = "L" + 编号 + "_";
    当前区 = "lambda";
    当前类 = "";
    当前基 = "";
    当前结构 = "";
    若 (捕自) {
        当前类 = 旧类;
        当前基 = 旧基;
        当前结构 = 旧结构;
    }
    当前返回 = "无";
    当前构造 = 假;
    在Lambda = 真;
    文本 定义 = "";
    文本 原型 = "void* env";
    文本 签名 = "";
    整数 k = 0;
    只要 (k < 参数型.数量) {
        文本 ty = 参数型[k];
        文本 nm = 参数名[k];
        声明(nm, ty);
        文本 cn = 变量C名(nm);
        若 (定义 != "") { 定义 = 定义 + ", "; }
        定义 = 定义 + C型(ty) + " " + cn;
        若 (签名 != "") { 签名 = 签名 + ","; }
        签名 = 签名 + ty;
        k = k + 1;
    }
    若 (定义 != "") { 原型 = 原型 + ", " + 定义; }
    文本 绑定 = "";
    若 (捕获名.数量 > 0) {
        文本 envcn = "Csay_env_" + 编号;
        文本 字段 = "";
        文本 参数 = "";
        整数 c = 0;
        只要 (c < 捕获名.数量) {
            若 (字段 != "") { 字段 = 字段 + " "; }
            字段 = 字段 + C型(捕获型[c]) + " c" + 整转文(c) + ";";
            若 (参数 != "") { 参数 = 参数 + ", "; }
            参数 = 参数 + C型(捕获型[c]) + " a" + 整转文(c);
            c = c + 1;
        }
        委托原型 = 委托原型 + "typedef struct " + envcn + " " + 左 + " " + 字段 + " " + 右 + " " + envcn + ";\n";
        委托原型 = 委托原型 + "static void* " + envcn + "_alloc(" + 参数 + ");\n";
        委托实现 = 委托实现 + "static void* " + envcn + "_alloc(" + 参数 + ") " + 左 + "\n" + envcn + "* e = (" + envcn + "*)csay_alloc((int64_t)sizeof(" + envcn + "));\n";
        c = 0;
        只要 (c < 捕获名.数量) {
            委托实现 = 委托实现 + "e->c" + 整转文(c) + " = a" + 整转文(c) + ";\n";
            c = c + 1;
        }
        委托实现 = 委托实现 + "return (void*)e;\n" + 右 + "\n";
        绑定 = envcn + "* e = (" + envcn + "*)env;\n";
        文本 env参数 = "";
        c = 0;
        只要 (c < 捕获名.数量) {
            文本 nm = 捕获名[c];
            文本 ty = 捕获型[c];
            若 (nm == "自") {
                绑定 = 绑定 + C型(ty) + " self = e->c" + 整转文(c) + ";\n";
            } 否则 {
                声明(nm, ty);
                文本 cn = 变量C名(nm);
                绑定 = 绑定 + C型(ty) + " " + cn + " = e->c" + 整转文(c) + ";\n";
            }
            若 (env参数 != "") { env参数 = env参数 + ", "; }
            env参数 = env参数 + 捕获码[c];
            c = c + 1;
        }
        委托环境名.追加(fn);
        委托环境码.追加(envcn + "_alloc(" + env参数 + ")");
    } 否则 {
        绑定 = "(void)env;\n";
    }
    若 (是(左)) {
        委托原型 = 委托原型 + "static void " + fn + "(" + 原型 + ");\n";
        委托实现 = 委托实现 + "static void " + fn + "(" + 原型 + ") " + 左 + "\n" + 绑定;
        生成块();
        委托实现 = 委托实现 + "}\n";
        前缀 = 旧前缀;
        当前区 = 旧区;
        当前类 = 旧类;
        当前基 = 旧基;
        当前结构 = 旧结构;
        当前返回 = 旧返回;
        参数名串 = 旧参数名串;
        当前构造 = 旧构造;
        在Lambda = 旧Lambda;
        使用深 = 旧使用深;
        返回 包("函数:" + 签名 + "->无", fn);
    }
    文本 v = 表达式();
    文本 rt = 果类型(v);
    委托原型 = 委托原型 + "static " + C型(rt) + " " + fn + "(" + 原型 + ");\n";
    委托实现 = 委托实现 + "static " + C型(rt) + " " + fn + "(" + 原型 + ") " + 左 + "\n" + 绑定 + "return " + 果码(v) + ";\n" + 右 + "\n";
    前缀 = 旧前缀;
    当前区 = 旧区;
    当前类 = 旧类;
    当前基 = 旧基;
    当前结构 = 旧结构;
    当前返回 = 旧返回;
    参数名串 = 旧参数名串;
    当前构造 = 旧构造;
    在Lambda = 旧Lambda;
    使用深 = 旧使用深;
    返回 包("函数:" + 签名 + "->" + rt, fn);
}

文本 主() {
    文本 t = 当();
    若 (词类[位置] == "int") {
        进();
        返回 包("整数", t + "LL");
    }
    若 (词类[位置] == "float") {
        进();
        返回 包("小数", t);
    }
    若 (词类[位置] == "op" && t == "[") {
        进();
        文本 code = "(" + 左 + " CsayList* l = csay_list_new((int64_t)sizeof(CsayStr)); ";
        文本 elem = "";
        真假 首 = 真;
        整数 vn = 0;
        只要 (!是("]")) {
            文本 r = 表达式();
            若 (首) {
                elem = 果类型(r);
                首 = 假;
                列表<文本> ep = elem.切分(":");
                若 (ep[0] == "类") {
                    整数 ci = 类索引(ep[1]);
                    列表<文本> ifs = 类接口[ci].切分(",");
                    若 (ifs[0] != "") { elem = "接口:" + ifs[0]; }
                }
                若 (elem == "整数") { code = "(" + 左 + " CsayList* l = csay_list_new((int64_t)sizeof(CsayInt)); "; }
                否则若 (elem == "文本") { code = "(" + 左 + " CsayList* l = csay_list_new((int64_t)sizeof(CsayStr)); "; }
                否则 { code = "(" + 左 + " CsayList* l = csay_list_new((int64_t)sizeof(" + C型(elem) + ")); "; }
            }
            若 (elem == "文本") {
                code = code + "csay_list_push_str(l, " + 果码(r) + "); ";
            } 否则若 (elem == "整数") {
                code = code + "csay_list_push_int(l, " + 果码(r) + "); ";
            } 否则 {
                文本 v = "v" + 整转文(vn);
                vn = vn + 1;
                code = code + C型(elem) + " " + v + " = " + 转目标(elem, 果类型(r), 果码(r)) + "; csay_list_add(l, &" + v + "); ";
            }
            若 (是(",")) { 进(); }
        }
        要("]");
        返回 包("列表:" + elem, code + "l; " + 右 + ")");
    }
    若 (词类[位置] == "istr") {
        进();
        返回 包("文本", 生成串(t));
    }
    若 (词类[位置] == "str") {
        进();
        返回 包("文本", 生成串(t));
    }
    若 (t == "真") { 进(); 返回 包("真假", "true"); }
    若 (t == "假") { 进(); 返回 包("真假", "false"); }
    若 (t == "(" && 像Lambda()) {
        返回 生成Lambda();
    }
    若 (t == "(") {
        进();
        文本 r = 表达式();
        要(")");
        返回 r;
    }
    若 (t == "新") {
        进();
        若 (是("列表") || 是("集合") || 是("队列") || 是("栈")) {
            进();
            要("<");
            文本 e = 读类型();
            要(">");
            要("(");
            要(")");
            若 (e == "文本") { 返回 包("列表:文本", "csay_list_new((int64_t)sizeof(CsayStr))"); }
            否则若 (e == "整数") { 返回 包("列表:整数", "csay_list_new((int64_t)sizeof(CsayInt))"); }
            否则 { 返回 包("列表:" + e, "csay_list_new((int64_t)sizeof(" + C型(e) + "))"); }
        } 否则若 (是("表")) {
            要("表");
            要("<");
            文本 k = 读类型();
            要(",");
            文本 v = 读类型();
            要(">");
            要("(");
            要(")");
            返回 包("表:" + k + ":" + v, "csay_map_new((int64_t)sizeof(" + C型(k) + "), (int64_t)sizeof(" + C型(v) + "), " + 表哈希(k) + ", " + 表相等(k) + ")");
        } 否则 {
            文本 cn = 当();
            进();
            若 (结构索引(cn) >= 0) {
                要("(");
                文本 args = 调用参数();
                返回 包("结构:" + cn, 结构构造C名(cn) + "(" + args + ")");
            }
            若 (类索引(cn) < 0) { 错("未知类 " + cn); }
            若 (类抽象[类索引(cn)] == "1") { 错("抽象类「" + cn + "」不能实例化"); }
            要("(");
            文本 args = 调用参数到(构造参数(cn));
            返回 包("类:" + cn, 构造C名(cn) + "(" + args + ")");
        }
    }
    若 (t == "自") {
        进();
        若 (当前结构 != "") { 返回 包("结构:" + 当前结构, "self"); }
        若 (当前类 == "") { 错("自 只能用在类的方法里"); }
        返回 包("类:" + 当前类, "self");
    }
    若 (t == "值") {
        进();
        若 (当前值类型 == "") { 错("值 只能用在属性的 写 里"); }
        返回 包(当前值类型, "_value");
    }
    若 (t == "基") {
        进();
        若 (当前基 == "") { 错("基 只能用在派生类里"); }
        返回 包("类:" + 当前基, "((" + 类C名(当前基) + "*)self)");
    }
    若 (t == "字符") {
        进();
        要("(");
        文本 cc = 表达式();
        要(")");
        返回 包("文本", "csay_char_of_code(" + 果码(cc) + ")");
    }
    若 (t == "开方") {
        进();
        要("(");
        文本 a = 表达式();
        要(")");
        返回 包("小数", "sqrt((double)(" + 果码(a) + "))");
    }
    若 (t == "文本长度") {
        进();
        要("(");
        文本 a = 表达式();
        要(")");
        返回 包("整数", "csay_utf8_len(" + 果码(a) + ")");
    }
    若 (t == "转大写") {
        进(); 要("(");
        文本 a = 表达式(); 要(")");
        返回 包("文本", "csay_str_upper(" + 果码(a) + ")");
    }
    若 (t == "转小写") {
        进(); 要("(");
        文本 a = 表达式(); 要(")");
        返回 包("文本", "csay_str_lower(" + 果码(a) + ")");
    }
    若 (t == "去除空白") {
        进(); 要("(");
        文本 a = 表达式(); 要(")");
        返回 包("文本", "csay_str_trim(" + 果码(a) + ")");
    }
    若 (t == "重复文本") {
        进(); 要("(");
        文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(")");
        返回 包("文本", "csay_repeat(" + 果码(a) + ", " + 果码(b) + ")");
    }
    若 (t == "连接文本") {
        进(); 要("(");
        文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(")");
        若 (果类型(a) != "列表:文本") { 错("连接文本() 的第一个参数必须是 列表<文本>"); }
        返回 包("文本", "csay_join(" + 果码(a) + ", " + 果码(b) + ")");
    }
    若 (t == "格式化小数") {
        进(); 要("(");
        文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(")");
        返回 包("文本", "csay_format_float(" + 果码(a) + ", " + 果码(b) + ")");
    }
    若 (t == "格式化") {
        进(); 要("(");
        文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(")");
        若 (果类型(b) != "列表:文本") { 错("格式化() 的第二个参数必须是 列表<文本>"); }
        返回 包("文本", "csay_format_text(" + 果码(a) + ", " + 果码(b) + ")");
    }
    若 (t == "填充文本") {
        进(); 要("(");
        文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(","); 文本 c = 表达式(); 要(")");
        返回 包("文本", "csay_fill_text(" + 果码(a) + ", " + 果码(b) + ", " + 果码(c) + ")");
    }
    若 (t == "查找文本") {
        进(); 要("(");
        文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(")");
        返回 包("整数", "csay_find_text(" + 果码(a) + ", " + 果码(b) + ")");
    }
    若 (t == "正则匹配") {
        进(); 要("(");
        文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(")");
        返回 包("真假", "csay_regex_match(" + 果码(a) + ", " + 果码(b) + ")");
    }
    若 (t == "正则查找") {
        进(); 要("(");
        文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(")");
        返回 包("整数", "csay_regex_find(" + 果码(a) + ", " + 果码(b) + ")");
    }
    若 (t == "正则替换") {
        进(); 要("(");
        文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(","); 文本 c = 表达式(); 要(")");
        返回 包("文本", "csay_regex_replace(" + 果码(a) + ", " + 果码(b) + ", " + 果码(c) + ")");
    }
    若 (t == "断言") {
        进(); 要("(");
        文本 a = 表达式();
        若 (果类型(a) != "真假") { 错("断言 的第一个参数必须是真假"); }
        文本 m = "csay_lit(\"\")";
        若 (是(",")) {
            进();
            文本 b = 表达式();
            若 (果类型(b) != "文本") { 错("断言 的消息必须是文本"); }
            m = 果码(b);
        }
        要(")");
        返回 包("无", "(csay_assert(" + 果码(a) + ", " + m + "), 0LL)");
    }
    若 (t == "JSON文本") {
        进(); 要("(");
        文本 a = 表达式(); 要(")");
        返回 包("文本", "csay_json_text(" + 果码(a) + ")");
    }
    若 (t == "JSON解析") {
        进(); 要("(");
        文本 a = 表达式(); 要(")");
        若 (果类型(a) != "文本") { 错("JSON解析 的参数必须是文本"); }
        返回 包("表:文本:文本", "csay_json_parse(" + 果码(a) + ")");
    }
    若 (t == "JSON序列化") {
        进(); 要("(");
        文本 a = 表达式(); 要(")");
        文本 at = 果类型(a);
        若 (at == "文本") { 返回 包("文本", "csay_json_text(" + 果码(a) + ")"); }
        若 (at == "整数") { 返回 包("文本", "csay_str_of_int(" + 果码(a) + ")"); }
        若 (at == "小数") { 返回 包("文本", "csay_str_of_float(" + 果码(a) + ")"); }
        若 (at == "真假") { 返回 包("文本", "csay_json_bool(" + 果码(a) + ")"); }
        若 (at == "列表:文本") { 返回 包("文本", "csay_json_list(" + 果码(a) + ", 0)"); }
        若 (at == "列表:整数") { 返回 包("文本", "csay_json_list(" + 果码(a) + ", 1)"); }
        若 (at == "列表:小数") { 返回 包("文本", "csay_json_list(" + 果码(a) + ", 2)"); }
        若 (at == "列表:真假") { 返回 包("文本", "csay_json_list(" + 果码(a) + ", 3)"); }
        错("JSON序列化 暂不支持 " + at);
    }
    若 (t == "保留") {
        进();
        要("(");
        文本 a = 表达式();
        要(")");
        返回 包("文本", "csay_keep_str(" + 果码(a) + ")");
    }
    若 (t == "输入") {
        进();
        返回 包("文本", "csay_read_line()");
    }
    若 (t == "询问") {
        进();
        要("(");
        文本 a = 表达式();
        要(")");
        返回 包("文本", "csay_ask(" + 果码(a) + ")");
    }
    若 (t == "转整数") {
        进();
        要("(");
        文本 a = 表达式();
        要(")");
        返回 包("整数", "csay_str_to_int(" + 果码(a) + ")");
    }
    若 (t == "转小数") {
        进();
        要("(");
        文本 a = 表达式();
        要(")");
        返回 包("小数", "csay_str_to_float(" + 果码(a) + ")");
    }
    若 (t == "取整") {
        进();
        要("(");
        文本 a = 表达式();
        要(")");
        返回 包("整数", "csay_round(" + 果码(a) + ")");
    }
    若 (t == "绝对值") {
        进();
        要("(");
        文本 a = 表达式();
        要(")");
        返回 包("小数", "fabs((double)(" + 果码(a) + "))");
    }    若 (t == "正弦") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("小数", "sin((double)(" + 果码(a) + "))");
    }
    若 (t == "余弦") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("小数", "cos((double)(" + 果码(a) + "))");
    }
    若 (t == "正切") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("小数", "tan((double)(" + 果码(a) + "))");
    }
    若 (t == "反正弦") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("小数", "asin((double)(" + 果码(a) + "))");
    }
    若 (t == "反余弦") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("小数", "acos((double)(" + 果码(a) + "))");
    }
    若 (t == "反正切") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("小数", "atan((double)(" + 果码(a) + "))");
    }
    若 (t == "反正切2") {
        进(); 要("("); 文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(")");
        返回 包("小数", "atan2((double)(" + 果码(a) + "), (double)(" + 果码(b) + "))");
    }
    若 (t == "自然对数") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("小数", "log((double)(" + 果码(a) + "))");
    }
    若 (t == "常用对数") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("小数", "log10((double)(" + 果码(a) + "))");
    }
    若 (t == "指数") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("小数", "exp((double)(" + 果码(a) + "))");
    }
    若 (t == "幂") {
        进(); 要("("); 文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(")");
        返回 包("小数", "pow((double)(" + 果码(a) + "), (double)(" + 果码(b) + "))");
    }
    若 (t == "向下取整") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("整数", "(int64_t)floor((double)(" + 果码(a) + "))");
    }
    若 (t == "向上取整") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("整数", "(int64_t)ceil((double)(" + 果码(a) + "))");
    }
    若 (t == "截断") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("整数", "(int64_t)trunc((double)(" + 果码(a) + "))");
    }
    若 (t == "符号") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("整数", "((" + 果码(a) + ") > 0 ? 1LL : ((" + 果码(a) + ") < 0 ? -1LL : 0LL))");
    }
    若 (t == "最大" || t == "最小") {
        进(); 要("("); 文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(")");
        文本 rt = "整数";
        若 (果类型(a) == "小数" || 果类型(b) == "小数") { rt = "小数"; }
        文本 op = ">";
        若 (t == "最小") { op = "<"; }
        返回 包(rt, "((" + 果码(a) + ") " + op + " (" + 果码(b) + ") ? (" + 果码(a) + ") : (" + 果码(b) + "))");
    }
    若 (t == "圆周率") {
        进(); 要("("); 要(")");
        返回 包("小数", "3.14159265358979323846");
    }    若 (t == "随机") {
        进(); 要("("); 要(")");
        返回 包("小数", "csay_random()");
    }
    若 (t == "随机整数") {
        进(); 要("("); 文本 a = 表达式(); 要(","); 文本 b = 表达式(); 要(")");
        返回 包("整数", "csay_random_int(" + 果码(a) + ", " + 果码(b) + ")");
    }
    若 (t == "随机种子") {
        进(); 要("("); 文本 a = 表达式(); 要(")");
        返回 包("无", "(csay_random_seed(" + 果码(a) + "), 0LL)");
    }
    若 (t == "异常" || 异常种类(t) >= 0) {
        进();
        返回 异常构造(t);
    }
    若 (t == "当前时间") {
        进(); 要("("); 要(")");
        返回 包("文本", "csay_now()");
    }
    若 (t == "当前日期") {
        进(); 要("("); 要(")");
        返回 包("文本", "csay_today()");
    }
    若 (t == "时间戳") {
        进(); 要("("); 要(")");
        返回 包("整数", "csay_timestamp()");
    }
    若 (t == "格式化时间") {
        进(); 要("(");
        文本 fa = 表达式(); 要(","); 文本 fb = 表达式(); 要(")");
        返回 包("文本", "csay_format_time(" + 果码(fa) + ", " + 果码(fb) + ")");
    }
    若 (t == "当前目录") {
        进(); 要("("); 要(")");
        返回 包("文本", "csay_current_dir()");
    }
    若 (t == "路径合并") {
        进(); 要("(");
        文本 pa = 表达式(); 要(","); 文本 pb = 表达式(); 要(")");
        返回 包("文本", "csay_path_join(" + 果码(pa) + ", " + 果码(pb) + ")");
    }
    若 (t == "路径存在") {
        进(); 要("(");
        文本 pe = 表达式(); 要(")");
        返回 包("真假", "csay_path_exists(" + 果码(pe) + ")");
    }
    若 (t == "目录列表") {
        进(); 要("(");
        文本 dl = 表达式(); 要(")");
        返回 包("列表:文本", "csay_list_dir(" + 果码(dl) + ")");
    }
    若 (t == "创建目录") {
        进(); 要("(");
        文本 md = 表达式(); 要(")");
        返回 包("真假", "csay_make_dir(" + 果码(md) + ")");
    }
    若 (t == "删除文件") {
        进(); 要("(");
        文本 rf = 表达式(); 要(")");
        返回 包("真假", "csay_remove_file(" + 果码(rf) + ")");
    }
    若 (t == "删除目录") {
        进(); 要("(");
        文本 rd = 表达式(); 要(")");
        返回 包("真假", "csay_remove_dir(" + 果码(rd) + ")");
    }
    若 (t == "是目录") {
        进(); 要("(");
        文本 id = 表达式(); 要(")");
        返回 包("真假", "csay_is_dir(" + 果码(id) + ")");
    }
    若 (t == "是文件") {
        进(); 要("(");
        文本 iff = 表达式(); 要(")");
        返回 包("真假", "csay_is_file(" + 果码(iff) + ")");
    }
    若 (t == "文件大小") {
        进(); 要("(");
        文本 fs = 表达式(); 要(")");
        返回 包("整数", "csay_file_size(" + 果码(fs) + ")");
    }
    若 (t == "读环境变量") {
        进(); 要("(");
        文本 ev = 表达式(); 要(")");
        返回 包("文本", "csay_getenv(" + 果码(ev) + ")");
    }
    若 (t == "系统平台") {
        进(); 要("("); 要(")");
        返回 包("文本", "csay_platform()");
    }
    若 (t == "运行命令") {
        进(); 要("(");
        文本 rc = 表达式(); 要(")");
        返回 包("整数", "csay_run_command(" + 果码(rc) + ")");
    }
    若 (t == "运行命令输出") {
        进(); 要("(");
        文本 rc = 表达式(); 要(")");
        返回 包("文本", "csay_run_capture(" + 果码(rc) + ")");
    }
    若 (t == "打开文件") {
        进();
        要("(");
        文本 fp = 表达式();
        要(",");
        文本 fm = 表达式();
        要(")");
        返回 包("整数", "csay_file_open(" + 果码(fp) + ", " + 果码(fm) + ")");
    }
    若 (t == "读文件行") {
        进();
        要("(");
        文本 fl = 表达式();
        要(")");
        返回 包("文本", "csay_file_read_line(" + 果码(fl) + ")");
    }
    若 (t == "写文件行") {
        进();
        要("(");
        文本 fh = 表达式();
        要(",");
        文本 ft = 表达式();
        要(")");
        返回 包("真假", "csay_file_write_line(" + 果码(fh) + ", " + 果码(ft) + ")");
    }
    若 (t == "文件末尾") {
        进();
        要("(");
        文本 fe = 表达式();
        要(")");
        返回 包("真假", "csay_file_eof(" + 果码(fe) + ")");
    }
    若 (t == "关闭文件") {
        进();
        要("(");
        文本 fc = 表达式();
        要(")");
        返回 包("无", "(csay_file_close(" + 果码(fc) + "), 0LL)");
    }
    若 (t == "读文件") {
        进();
        要("(");
        文本 rf = 表达式();
        要(")");
        返回 包("文本", "csay_read_file(" + 果码(rf) + ")");
    }
    若 (t == "写文件") {
        进();
        要("(");
        文本 wa = 表达式();
        要(",");
        文本 wb = 表达式();
        要(")");
        返回 包("真假", "csay_write_file(" + 果码(wa) + ", " + 果码(wb) + ")");
    }
    若 (t == "命令行参数") {
        进();
        要("(");
        要(")");
        返回 包("列表:文本", "csay_args()");
    }
    若 (词类[位置] == "id") {
        文本 nm = t;
        进();
        文本 dty = 查类型(nm);
        若 (是("(") && dty.切分(":")[0] == "委托") {
            进();
            文本 dn = dty.切分(":")[1];
            文本 args = 委托调用参数(dn);
            文本 tmp = "dg" + 整转文(委托计数);
            委托计数 = 委托计数 + 1;
            文本 tail = "";
            若 (args != "") { tail = ", " + args; }
            返回 包(委托信息(委托返回, dn), "(" + 左 + " " + C型(dty) + " " + tmp + " = " + 变量C名(nm) + "; if (" + tmp + ".fn == NULL) csay_throw_error(csay_error(csay_str(\"委托为空\", 12), 2)); " + tmp + ".fn(" + tmp + ".env" + tail + "); " + 右 + ")");
        }
        若 (是("(")) {
            进();
            文本 args = 调用参数到(函数参数类型(nm));
            文本 rt = 函数返回类型(nm);
            若 (rt == "") { 错("未知函数 " + nm); }
            返回 包(rt, C名("#f:" + nm) + "(" + args + ")");
        }
        若 (类索引(nm) >= 0) {
            返回 包("类:" + nm, "");
        }
        若 (枚举索引(nm) >= 0) {
            返回 包("枚举:" + nm, "");
        }
        文本 ty = 查类型(nm);
        若 (ty == "") {
            若 (当前结构 != "") {
                文本 ft = 结构字段类型(当前结构, nm);
                若 (ft != "") { 返回 包(ft, "self->" + 结构字段C名(当前结构, nm)); }
            }
            若 (当前类 != "") {
                文本 sft = 静态字段项(当前类, nm);
                若 (sft != "") {
                    若 (!静态字段可见(当前类, nm)) { 错("不能访问私有静态字段 " + nm); }
                    返回 包(sft, 静态字段C名(当前类, nm));
                }
                文本 ft = 字段类型(当前类, nm);
                若 (ft != "") {
                    返回 包(ft, "self->" + 字段路径(当前类, nm));
                }
            }
            错("未知变量 " + nm);
        }
        返回 包(ty, 变量C名(nm));
    }
    错("不认识的记号「" + t + "」");
    返回 包("整数", "0");
}

无 生成块() {
    要(左);
    只要 (位置 < 词文.数量 && !是(右)) {
        生成语句();
    }
    要(右);
}

无 生成条件体() {
    要("(");
    文本 c = 表达式();
    要(")");
    追加输出("if (" + 果码(c) + ") " + 左 + "\n");
    生成块();
    追加输出("}\n");
    若 (是("否则若")) {
        进();
        追加输出("else ");
        生成条件体();
    } 否则若 (是("否则")) {
        进();
        追加输出("else " + 左 + "\n");
        生成块();
        追加输出("}\n");
    }
}

无 生成若() {
    进();
    生成条件体();
}

无 生成只要() {
    进();
    追加输出("while (");
    要("(");
    文本 c = 表达式();
    要(")");
    追加输出(果码(c) + ") " + 左 + "\n");
    生成块();
    追加输出("}\n");
}

无 生成做() {
    进();
    追加输出("do " + 左 + "\n");
    生成块();
    要("只要");
    要("(");
    文本 c = 表达式();
    要(")");
    分号可();
    追加输出("} while (" + 果码(c) + ");\n");
}

无 生成择() {
    进();
    要("(");
    文本 c = 表达式();
    要(")");
    要(左);
    追加输出("switch (" + 果码(c) + ") " + 左 + "\n");
    只要 (位置 < 词文.数量 && !是(右)) {
        若 (是("情形")) {
            进();
            文本 v = 表达式();
            要(":");
            追加输出("case " + 果码(v) + ":\n");
        } 否则若 (是("默认")) {
            进();
            要(":");
            追加输出("default:\n");
        } 否则 {
            生成语句();
        }
    }
    要(右);
    追加输出("}\n");
}

无 生成局部变量() {
    文本 ty = 读类型();
    文本 nm = 当();
    进();
    声明(nm, ty);
    文本 cn = 变量C名(nm);
    若 (是("=")) {
        进();
        文本 旧声明 = 当前声明;
        当前声明 = nm;
        文本 r = 表达式();
        当前声明 = 旧声明;
        分号可();
        追加行(C型(ty) + " " + cn + " = " + 转目标(ty, 果类型(r), 果码(r)) + ";");
    } 否则 {
        分号可();
        追加行(C型(ty) + " " + cn + " = " + 默认值(ty) + ";");
    }
}

无 生成全局() {
    文本 ty = 读类型();
    文本 nm = 当();
    进();
    当前区 = "main";
    若 (是("=")) {
        进();
        文本 旧声明 = 当前声明;
        当前声明 = nm;
        文本 r = 表达式();
        当前声明 = 旧声明;
        分号可();
        追加行(变量C名(nm) + " = " + 转目标(ty, 果类型(r), 果码(r)) + ";");
    } 否则 {
        分号可();
        若 (ty == "文本") {
            追加行(变量C名(nm) + " = csay_lit(\"\");");
        }
    }
    当前区 = "func";
}

无 生成赋值() {
    文本 nm = 当();
    进();
    文本 op = 当();
    进();
    文本 r = 表达式();
    分号可();
    文本 ty = 查类型(nm);
    文本 cn = "";
    若 (ty == "") {
        若 (当前结构 != "") {
            文本 ft = 结构字段类型(当前结构, nm);
            若 (ft != "") {
                ty = ft;
                cn = "self->" + 结构字段C名(当前结构, nm);
            }
        }
        若 (ty == "" && 当前类 != "") {
            文本 sft = 静态字段项(当前类, nm);
            若 (sft != "") {
                若 (!静态字段可见(当前类, nm)) { 错("不能访问私有静态字段 " + nm); }
                ty = sft;
                cn = 静态字段C名(当前类, nm);
            }
            文本 ft = 字段类型(当前类, nm);
            若 (ft != "") {
                若 (字段只读(当前类, nm) && !当前构造) { 错("只读字段「" + nm + "」只能在构造器里赋值"); }
                ty = ft;
                cn = "self->" + 字段路径(当前类, nm);
            }
        }
    }
    若 (ty == "") { 错("给未知变量赋值 " + nm); }
    若 (cn == "") { cn = 变量C名(nm); }
    若 (op == "=") {
        追加行(cn + " = " + 转目标(ty, 果类型(r), 果码(r)) + ";");
    } 否则若 (op == "+=" && ty == "文本") {
        追加行(cn + " = csay_cat(" + cn + ", " + 果码(r) + ");");
    } 否则 {
        追加行(cn + " " + op + " " + 果码(r) + ";");
    }
}

无 生成返回() {
    若 (使用深 > 0) { 错("使用 块里不能 返回"); }
    若 (在Lambda) { 错("Lambda 块体暂不支持 返回；请改用表达式体"); }
    进();
    若 (是(";")) {
        进();
        追加行("return;");
        返回;
    }
    文本 r = 表达式();
    分号可();
    追加行("return " + 转目标(当前返回, 果类型(r), 果码(r)) + ";");
}

无 生成打印() {
    进();
    要("(");
    文本 r = 表达式();
    要(")");
    分号可();
    文本 ty = 果类型(r);
    列表<文本> tp = ty.切分(":");
    若 (ty == "文本") { 追加行("csay_println_str(" + 果码(r) + ");"); }
    否则若 (ty == "整数") { 追加行("csay_println_int(" + 果码(r) + ");"); }
    否则若 (ty == "小数") { 追加行("csay_println_float(" + 果码(r) + ");"); }
    否则若 (ty == "真假") { 追加行("csay_println_bool(" + 果码(r) + ");"); }
    否则若 (ty == "异常") { 追加行("csay_println_str((" + 果码(r) + ").msg);"); }
    否则若 (tp[0] == "枚举") { 追加行("csay_println_int(" + 果码(r) + ");"); }
    否则 { 错("打印不支持类型 " + ty); }
}

无 生成退出() {
    进();
    要("(");
    文本 r = 表达式();
    要(")");
    分号可();
    追加行("csay_exit(" + 果码(r) + ");");
}

无 生成函数() {
    文本 rt = 读类型();
    文本 nm = 当();
    进();
    要("(");
    前缀 = nm + ":";
    文本 ps = "";
    若 (!是(")")) {
        真假 完 = 假;
        只要 (!完) {
            文本 pt = 读类型();
            文本 pn = 当();
            进();
            声明(pn, pt);
            若 (ps != "") { ps = ps + ", "; }
            ps = ps + C型(pt) + " " + 变量C名(pn);
            若 (是(",")) { 进(); } 否则 { 完 = 真; }
        }
    }
    要(")");
    若 (ps == "") { ps = "void"; }
    当前区 = "func";
    当前返回 = rt;
    追加输出("static " + C型(rt) + " " + C名("#f:" + nm) + "(" + ps + ") " + 左 + "\n");
    生成块();
    追加输出("}\n\n");
    前缀 = "";
}

无 生成对于() {
    进();
    要("(");
    文本 init = "";
    若 (是类型(当()) && 词类[位置] == "id") {
        文本 ty = 读类型();
        文本 nm = 当();
        进();
        声明(nm, ty);
        要("=");
        文本 r0 = 表达式();
        init = C型(ty) + " " + 变量C名(nm) + " = " + 果码(r0);
    } 否则 {
        文本 r1 = 表达式();
        init = 果码(r1);
    }
    分号可();
    文本 c = 表达式();
    分号可();
    文本 step = "";
    若 (词类[位置] == "id" && (后一() == "++" || 后一() == "--")) {
        文本 nm = 当();
        文本 op = 后一();
        进();
        进();
        step = 变量C名(nm) + op;
    } 否则若 (词类[位置] == "id" && (后一() == "+=" || 后一() == "-=" || 后一() == "*=" || 后一() == "/=" || 后一() == "%=")) {
        文本 nm = 当();
        文本 op = 后一();
        进();
        进();
        文本 r2 = 表达式();
        step = 变量C名(nm) + op + 果码(r2);
    } 否则 {
        文本 r3 = 表达式();
        step = 果码(r3);
    }
    要(")");
    追加输出("for (" + init + "; " + 果码(c) + "; " + step + ") " + 左 + "\n");
    生成块();
    追加输出("}\n");
}

无 生成遍历() {
    进();
    要("(");
    文本 et = "";
    若 (是类型(当()) && 词类[位置] == "id") {
        et = 读类型();
    }
    文本 nm = 当();
    进();
    要("在");
    文本 it = 表达式();
    要(")");
    文本 ity = 果类型(it);
    列表<文本> ip = ity.切分(":");
    若 (ip[0] != "列表") {
        错("遍历 只能遍历列表");
    }
    若 (ip[1] == "类" || ip[1] == "接口") {
        et = ip[1] + ":" + ip[2];
    } 否则若 (ip[1] == "条目") {
        et = "条目:" + ip[2] + ":" + ip[3];
    } 否则若 (et == "") { et = 元素型(ity); }
    声明(nm, et);
    文本 cn = 变量C名(nm);
    整数 idx = 临时号;
    临时号 = 临时号 + 1;
    文本 iv = "i" + 整转文(idx);
    追加输出("for (CsayInt " + iv + " = 0; " + iv + " < " + 果码(it) + "->len; " + iv + "++) " + 左 + "\n");
    追加输出(C型(et) + " " + cn + " = *(" + C型(et) + "*)csay_list_at(" + 果码(it) + ", " + iv + ");\n");
    生成块();
    追加输出("}\n");
}

无 生成试() {
    进();
    整数 id = 临时号;
    临时号 = 临时号 + 1;
    文本 t = "try" + 整转文(id);
    追加行("CsayTry " + t + ";");
    追加行("int " + t + "_failed = 0;");
    追加行("int " + t + "_handled = 0;");
    追加行(t + ".prev = csay_try_top;");
    追加行("if (setjmp(" + t + ".buf) == 0) " + 左);
    追加行("csay_try_top = &" + t + ";");
    生成块();
    追加行("csay_try_top = " + t + ".prev;");
    追加行(右);
    追加行("else " + 左);
    追加行(t + "_failed = 1;");
    追加行("csay_try_top = " + t + ".prev;");
    整数 n = 0;
    只要 (是("捕获")) {
        进();
        要("(");
        文本 ct = 当();
        进();
        文本 nm = 当();
        进();
        要(")");
        整数 k = 异常种类(ct);
        若 (k < 0) { 错("未知的异常类型 " + ct); }
        文本 cond = "1";
        若 (k != 0) { cond = t + ".err.kind == " + 整转文(k); }
        若 (n == 0) {
            追加行("if (" + cond + ") " + 左);
        } 否则 {
            追加行("else if (" + cond + ") " + 左);
        }
        追加行(t + "_handled = 1;");
        追加行("CsayError " + 变量C名(nm) + " = " + t + ".err;");
        声明(nm, "异常");
        生成块();
        追加行(右);
        n = n + 1;
    }
    追加行(右);
    若 (是("最终")) {
        进();
        生成块();
    }
    追加行("if (" + t + "_failed && !" + t + "_handled) " + 左 + " csay_throw_error(" + t + ".err); " + 右);
}

无 生成区域() {
    进();
    整数 id = 临时号;
    临时号 = 临时号 + 1;
    文本 r = "reg" + 整转文(id);
    追加行("CsayRegion* " + r + " = csay_region_begin();");
    生成块();
    追加行("csay_region_end(" + r + ");");
}

无 生成抛出() {
    进();
    文本 r = 表达式();
    分号可();
    若 (果类型(r) == "异常") {
        追加行("csay_throw_error(" + 果码(r) + ");");
    } 否则 {
        追加行("csay_throw(" + 转文本码(果类型(r), 果码(r)) + ");");
    }
}

无 生成使用() {
    进();
    要("(");
    文本 r = 表达式();
    要(")");
    文本 ty = 果类型(r);
    列表<文本> tp = ty.切分(":");
    若 (tp[0] != "类") { 错("使用 的目标必须是类对象"); }
    文本 cls = tp[1];
    文本 owner = 方法属主(cls, "关闭");
    若 (owner == "") { 错("类 " + cls + " 没有 关闭 方法"); }
    若 (方法静态(owner, "关闭")) { 错("使用 不能调用静态 关闭 方法"); }
    文本 mi = 方法项(owner, "关闭");
    列表<文本> mp = mi.切分("|");
    若 (mp[1] != "") { 错("关闭 方法不能带参数"); }
    文本 call = "";
    若 (方法虚(owner, "关闭")) {
        call = "Csay_dispatch_关闭(" + 果码(r) + ")";
    } 否则 {
        call = 方法C名(owner, "关闭") + "((" + 类C名(owner) + "*)" + 果码(r) + ")";
    }
    整数 id = 临时号;
    临时号 = 临时号 + 1;
    文本 t = "use" + 整转文(id);
    追加行(左);
    追加行("CsayTry " + t + ";");
    追加行("int " + t + "_failed = 0;");
    追加行(t + ".prev = csay_try_top;");
    追加行("if (setjmp(" + t + ".buf) == 0) " + 左);
    追加行("csay_try_top = &" + t + ";");
    使用深 = 使用深 + 1;
    生成块();
    使用深 = 使用深 - 1;
    追加行("csay_try_top = " + t + ".prev;");
    追加行(右 + " else " + 左);
    追加行(t + "_failed = 1;");
    追加行("csay_try_top = " + t + ".prev;");
    追加行(call + ";");
    追加行("csay_throw_error(" + t + ".err);");
    追加行(右);
    追加行(call + ";");
    追加行(右);
}

无 生成语句() {
    若 (是(左)) {
        生成块();
        返回;
    }
    若 (是("若")) {
        生成若();
        返回;
    }
    若 (是("只要")) {
        生成只要();
        返回;
    }
    若 (是("对于")) {
        生成对于();
        返回;
    }
    若 (是("遍历")) {
        生成遍历();
        返回;
    }
    若 (是("做")) {
        生成做();
        返回;
    }
    若 (是("择")) {
        生成择();
        返回;
    }
    若 (是("跳出")) {
        若 (使用深 > 0) { 错("使用 块里不能 跳出 或 跳过"); }
        进();
        分号可();
        追加行("break;");
        返回;
    }
    若 (是("跳过")) {
        若 (使用深 > 0) { 错("使用 块里不能 跳出 或 跳过"); }
        进();
        分号可();
        追加行("continue;");
        返回;
    }
    若 (是("试")) {
        生成试();
        返回;
    }
    若 (是("区域")) {
        生成区域();
        返回;
    }
    若 (是("使用")) {
        生成使用();
        返回;
    }
    若 (是("抛出")) {
        生成抛出();
        返回;
    }
    若 (是("返回")) {
        生成返回();
        返回;
    }
    若 (是("打印") && 后一() == "(") {
        生成打印();
        返回;
    }
    若 (是("退出") && 后一() == "(") {
        生成退出();
        返回;
    }
    若 (是类型(当()) && 词类[位置] == "id" && 后一() != "." && 后一() != "(") {
        生成局部变量();
        返回;
    }
    若 (词类[位置] == "id" && 后一() == "[") {
        整数 save = 位置;
        文本 base = 主();
        若 (是("[")) {
            进();
            文本 key = 表达式();
            要("]");
            若 (是("=")) {
                进();
                文本 val = 表达式();
                分号可();
                文本 ty = 果类型(base);
                列表<文本> tp = ty.切分(":");
                若 (tp[0] == "表") {
                    文本 k = tp[1];
                    文本 v = tp[2];
                    追加行("csay_map_set(" + 果码(base) + ", " + 取址(k, 果码(key)) + ", " + 取址(v, 果码(val)) + ");");
                    返回;
                }
            }
        }
        位置 = save;
    }
    若 ((是("自") || 词类[位置] == "id") && (后一() == "." || 后一() == "[")) {
        整数 save = 位置;
        文本 base = 主();
        若 (是(".")) {
            进();
            文本 nm = 当();
            进();
            文本 bty = 果类型(base);
            列表<文本> rp = bty.切分(":");
            若 (rp[0] == "类") {
                文本 pi = 属性项(rp[1], nm);
                若 (pi != "") {
                    若 (!属性可见(rp[1], nm)) { 错("不能访问私有属性 " + nm); }
                    列表<文本> ap = pi.切分("|");
                    若 (ap[2] == "1" && 是("=")) {
                        进();
                        文本 r = 表达式();
                        分号可();
                        追加行(属性写C名(rp[1], nm) + "(" + 果码(base) + ", " + 果码(r) + ");");
                        返回;
                    } 否则若 (ap[2] != "1") {
                        错("属性 " + nm + " 没有 写 访问器");
                    }
                }
                文本 st = 静态字段项(rp[1], nm);
                若 ((st != "") && !静态字段可见(rp[1], nm)) { 错("不能访问私有静态字段 " + nm); }
                若 (st != "" && 是("=")) {
                    进();
                    文本 r = 表达式();
                    分号可();
                    追加行(静态字段C名(rp[1], nm) + " = " + 果码(r) + ";");
                    返回;
                }
            } 否则若 (rp[0] == "接口") {
                文本 pi = 接口属性项(rp[1], nm);
                若 (pi != "") {
                    列表<文本> ap = pi.切分("|");
                    若 (ap[2] == "1" && 是("=")) {
                        进();
                        文本 r = 表达式();
                        分号可();
                        追加行(接口属性写C名(rp[1], nm) + "(" + 果码(base) + ", " + 果码(r) + ");");
                        返回;
                    } 否则若 (ap[2] != "1") {
                        错("属性 " + nm + " 没有 写 访问器");
                    }
                }
            }
        }
        位置 = save;
    }
    若 ((是("自") || 词类[位置] == "id") && (后一() == "." || 后一() == "[")) {
        文本 left = 后缀();
        若 (是("=") || 是("+=") || 是("-=") || 是("*=") || 是("/=") || 是("%=")) {
            若 (上次字段只读 && !当前构造) { 错("只读字段「" + 上次字段名 + "」只能在构造器里赋值"); }
            文本 op = 当();
            进();
            文本 r = 表达式();
            分号可();
            文本 ty = 果类型(left);
            若 (op == "=") {
                追加行(果码(left) + " = " + 转目标(ty, 果类型(r), 果码(r)) + ";");
            } 否则若 (op == "+=" && ty == "文本") {
                追加行(果码(left) + " = csay_cat(" + 果码(left) + ", " + 果码(r) + ");");
            } 否则 {
                追加行(果码(left) + " " + op + " " + 果码(r) + ";");
            }
        } 否则 {
            分号可();
            追加行(果码(left) + ";");
        }
        返回;
    }
    若 (词类[位置] == "id" && (后一() == "=" || 后一() == "+=" || 后一() == "-=" || 后一() == "*=" || 后一() == "/=" || 后一() == "%=")) {
        生成赋值();
        返回;
    }
    文本 r = 表达式();
    分号可();
    追加行(果码(r) + ";");
}

无 生成主() {
    位置 = 0;
    前缀 = "";
    只要 (位置 < 词文.数量) {
        文本 t = 当();
        若 ((词类[位置] == "id" && t == "类") || (词类[位置] == "id" && t == "接口") || (词类[位置] == "id" && t == "枚举") || (词类[位置] == "id" && t == "结构")) {
            位置 = 跳到类尾(位置);
        } 否则若 (词类[位置] == "id" && t == "委托") {
            位置 = 位置 + 2;
            只要 (位置 < 词文.数量 && 当() != ";") { 进(); }
            若 (位置 < 词文.数量) { 进(); }
        } 否则若 (是修饰(t)) {
            只要 (位置 < 词文.数量 && 是修饰(当())) { 进(); }
            若 (位置 < 词文.数量 && 词类[位置] == "id" && (当() == "类" || 当() == "接口" || 当() == "枚举" || 当() == "结构")) {
                位置 = 跳到类尾(位置);
            } 否则若 (位置 < 词文.数量 && 词类[位置] == "id" && 当() == "委托") {
                位置 = 位置 + 2;
                只要 (位置 < 词文.数量 && 当() != ";") { 进(); }
                若 (位置 < 词文.数量) { 进(); }
            } 否则 {
                当前区 = "main";
                生成语句();
            }
        } 否则若 (是类型(t) && 词类[位置] == "id") {
            扫类型(位置);
            整数 j = 类型尾;
            若 (词类[j] == "id") {
                若 (词(j + 1) == "(") {
                    生成函数();
                } 否则 {
                    生成全局();
                }
            } 否则 {
                当前区 = "main";
                生成语句();
            }
        } 否则 {
            当前区 = "main";
            生成语句();
        }
    }
}

文本 读参数定义() {
    要("(");
    文本 ps = "";
    参数名串 = "";
    若 (!是(")")) {
        真假 完 = 假;
        只要 (!完) {
            文本 ty = 读类型();
            文本 nm = 当();
            进();
            声明(nm, ty);
            若 (ps != "") { ps = ps + ", "; }
            若 (参数名串 != "") { 参数名串 = 参数名串 + ", "; }
            ps = ps + C型(ty) + " " + 变量C名(nm);
            参数名串 = 参数名串 + 变量C名(nm);
            若 (是(",")) { 进(); } 否则 { 完 = 真; }
        }
    }
    要(")");
    若 (ps == "") { ps = "void"; }
    返回 ps;
}

