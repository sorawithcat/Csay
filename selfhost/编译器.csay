// Csay 自举编译器 —— Stage 1。
// 先实现词法器；跑通后再接解析和 C 代码生成。
// 源码只使用 Stage 1 自己的子集：整数/文本/真假/无、函数、若、只要、列表、文本下标。

列表<文本> 词文 = 新 列表<文本>();
列表<文本> 词类 = 新 列表<文本>();
文本 源 = "";
整数 位置 = 0;

文本 源码无泛型 = "";
列表<文本> 泛型名 = 新 列表<文本>();
列表<文本> 泛型参数 = 新 列表<文本>();
列表<文本> 泛型原文 = 新 列表<文本>();
列表<文本> 泛型实例键 = 新 列表<文本>();
列表<文本> 泛型新类表 = 新 列表<文本>();

列表<文本> 委托名 = 新 列表<文本>();
列表<文本> 委托参数 = 新 列表<文本>();
列表<文本> 委托返回 = 新 列表<文本>();
列表<文本> 委托环境名 = 新 列表<文本>();
列表<文本> 委托环境码 = 新 列表<文本>();
文本 委托原型 = "";
文本 委托实现 = "";
文本 当前声明 = "";
整数 委托计数 = 0;

无 加词(文本 t, 文本 k) {
    词文.追加(t);
    词类.追加(k);
}

文本 取字(整数 i) {
    若 (i < 0 || i >= 源.长度) {
        返回 "";
    }
    返回 源[i];
}

真假 是空白(文本 c) {
    返回 c == " " || c == "\n" || c == "\t" || c == "\r";
}

真假 是数字(文本 c) {
    返回 "0123456789".含(c);
}

真假 是符号(文本 c) {
    返回 "()[];,+-*/%<>=!&|.:?".含(c) || c == 左 || c == 右;
}

真假 是标识(文本 c) {
    若 (c == "") { 返回 假; }
    若 (是空白(c)) { 返回 假; }
    若 (是符号(c)) { 返回 假; }
    若 (c == "\"" || c == "“" || c == "”") { 返回 假; }
    返回 真;
}

文本 数字字(整数 d) {
    若 (d == 0) { 返回 "0"; }
    否则若 (d == 1) { 返回 "1"; }
    否则若 (d == 2) { 返回 "2"; }
    否则若 (d == 3) { 返回 "3"; }
    否则若 (d == 4) { 返回 "4"; }
    否则若 (d == 5) { 返回 "5"; }
    否则若 (d == 6) { 返回 "6"; }
    否则若 (d == 7) { 返回 "7"; }
    否则若 (d == 8) { 返回 "8"; }
    返回 "9";
}

文本 整转文(整数 n) {
    若 (n == 0) { 返回 "0"; }
    文本 s = "";
    真假 负 = 假;
    若 (n < 0) {
        负 = 真;
        n = 0 - n;
    }
    只要 (n > 0) {
        整数 d = n % 10;
        s = 数字字(d) + s;
        n = n / 10;
    }
    若 (负) {
        返回 "-" + s;
    }
    返回 s;
}

文本 全角转(文本 c) {
    若 (c == "（") { 返回 "("; }
    若 (c == "）") { 返回 ")"; }
    若 (c == "｛") { 返回 左; }
    若 (c == "｝") { 返回 右; }
    若 (c == "，") { 返回 ","; }
    若 (c == "：") { 返回 ":"; }
    若 (c == "；") { 返回 ";"; }
    若 (c == "＜") { 返回 "<"; }
    若 (c == "＞") { 返回 ">"; }
    若 (c == "＝") { 返回 "="; }
    若 (c == "＋") { 返回 "+"; }
    若 (c == "－") { 返回 "-"; }
    若 (c == "＊") { 返回 "*"; }
    若 (c == "／") { 返回 "/"; }
    若 (c == "％") { 返回 "%"; }
    若 (c == "！") { 返回 "!"; }
    若 (c == "＆") { 返回 "&"; }
    若 (c == "｜") { 返回 "|"; }
    若 (c == "［") { 返回 "["; }
    若 (c == "］") { 返回 "]"; }
    若 (c == "．") { 返回 "."; }
    若 (c == "？") { 返回 "?"; }
    若 (c == "　") { 返回 " "; }
    返回 c;
}

无 分词() {
    整数 i = 0;
    真假 插值 = 假;
    只要 (i < 源.长度) {
        文本 c = 源[i];
        文本 z = 全角转(c);
        若 (z != c) {
            若 (z == " ") {
                i = i + 1;
            } 否则 {
                加词(z, "op");
                i = i + 1;
            }
        } 否则若 (是空白(c)) {
            i = i + 1;
        } 否则若 (c == "/" && 取字(i + 1) == "/") {
            只要 (i < 源.长度 && 源[i] != "\n") {
                i = i + 1;
            }
        } 否则若 (c == "/" && 取字(i + 1) == "*") {
            i = i + 2;
            只要 (i < 源.长度 && !(源[i] == "*" && 取字(i + 1) == "/")) {
                i = i + 1;
            }
            若 (i < 源.长度) {
                i = i + 2;
            }
        } 否则若 (c == "$" && (取字(i + 1) == "\"" || 取字(i + 1) == "“")) {
            插值 = 真;
            i = i + 1;
        } 否则若 (c == "\"" || c == "“") {
            真假 本插值 = 插值;
            插值 = 假;
            文本 终止 = "\"";
            若 (c == "“") { 终止 = "”"; }
            i = i + 1;
            文本 s = "";
            整数 深 = 0;
            真假 完 = 假;
            只要 (i < 源.长度 && !完) {
                文本 ch = 源[i];
                若 (ch == "\\") {
                    文本 e = 取字(i + 1);
                    若 (e == "n") { s = s + "\n"; }
                    否则若 (e == "t") { s = s + "\t"; }
                    否则若 (e == "r") { s = s + "\r"; }
                    否则若 (e == "\"") { s = s + "\""; }
                    否则若 (e == "\\") { s = s + "\\"; }
                    否则若 (e == 左) { s = s + "\\" + 左; }
                    否则若 (e == 右) { s = s + "\\" + 右; }
                    否则 { s = s + e; }
                    i = i + 2;
                } 否则若 (ch == 终止 && 深 == 0) {
                    完 = 真;
                    i = i + 1;
                } 否则若 (ch == 左) {
                    深 = 深 + 1;
                    s = s + 左;
                    i = i + 1;
                } 否则若 (ch == 右 && 深 > 0) {
                    深 = 深 - 1;
                    s = s + 右;
                    i = i + 1;
                } 否则 {
                    s = s + ch;
                    i = i + 1;
                }
            }
            若 (本插值) { 加词(s, "istr"); } 否则 { 加词(s, "str"); }
        } 否则若 (是数字(c)) {
            文本 s = "";
            只要 (i < 源.长度 && 是数字(源[i])) {
                s = s + 源[i];
                i = i + 1;
            }
            真假 浮 = 假;
            若 (i < 源.长度 && 源[i] == "." && 是数字(取字(i + 1))) {
                浮 = 真;
                s = s + ".";
                i = i + 1;
                只要 (i < 源.长度 && 是数字(源[i])) {
                    s = s + 源[i];
                    i = i + 1;
                }
            }
            若 (浮) { 加词(s, "float"); } 否则 { 加词(s, "int"); }
        } 否则若 (是标识(c)) {
            文本 s = "";
            只要 (i < 源.长度 && 是标识(源[i]) && 全角转(源[i]) == 源[i]) {
                s = s + 源[i];
                i = i + 1;
            }
            加词(s, "id");
        } 否则 {
            文本 两 = c + 取字(i + 1);
            若 (两 == "==" || 两 == "!=" || 两 == "<=" || 两 == ">=" || 两 == "&&" || 两 == "||" || 两 == "++" || 两 == "--" || 两 == "+=" || 两 == "-=" || 两 == "*=" || 两 == "/=" || 两 == "%=" || 两 == "=>") {
                加词(两, "op");
                i = i + 2;
            } 否则 {
                加词(c, "op");
                i = i + 1;
            }
        }
    }
}

文本 输出 = "";
文本 初始化输出 = "";
文本 主输出 = "";
文本 函数输出 = "";
文本 当前区 = "func";
真假 当前构造 = 假;
真假 上次字段只读 = 假;
文本 上次字段名 = "";
文本 当前返回 = "无";
真假 在Lambda = 假;
文本 前缀 = "";
文本 左 = 字符(123);
文本 右 = 字符(125);

列表<文本> 符号名 = 新 列表<文本>();
列表<文本> 符号类型 = 新 列表<文本>();
列表<文本> 名字表 = 新 列表<文本>();
列表<文本> 函数名 = 新 列表<文本>();
列表<文本> 函数返回 = 新 列表<文本>();
列表<文本> 函数参数 = 新 列表<文本>();
列表<文本> 函数参数型 = 新 列表<文本>();
列表<文本> 全局名 = 新 列表<文本>();
列表<文本> 全局类型 = 新 列表<文本>();

列表<文本> 类名 = 新 列表<文本>();
列表<文本> 类字段 = 新 列表<文本>();
列表<文本> 类方法 = 新 列表<文本>();
列表<文本> 类构造 = 新 列表<文本>();
列表<文本> 类属性 = 新 列表<文本>();
列表<文本> 类基 = 新 列表<文本>();
列表<文本> 类接口 = 新 列表<文本>();
列表<文本> 类抽象 = 新 列表<文本>();
列表<文本> 类密封 = 新 列表<文本>();
列表<文本> 类接口 = 新 列表<文本>();
列表<文本> 类静态字段 = 新 列表<文本>();
列表<文本> 接口名 = 新 列表<文本>();
列表<文本> 接口方法 = 新 列表<文本>();
列表<文本> 接口属性 = 新 列表<文本>();
列表<文本> 枚举名 = 新 列表<文本>();
列表<文本> 枚举项 = 新 列表<文本>();
列表<文本> 结构名 = 新 列表<文本>();
列表<文本> 结构字段 = 新 列表<文本>();
列表<文本> 结构方法 = 新 列表<文本>();
列表<文本> 结构构造 = 新 列表<文本>();
列表<文本> 虚方法 = 新 列表<文本>();
列表<整数> 结构体起点 = 新 列表<整数>();
列表<整数> 类体起点 = 新 列表<整数>();
文本 类输出 = "";
文本 静态字段临时 = "";
文本 接口输出 = "";
文本 当前类 = "";
文本 当前结构 = "";
文本 当前基 = "";
真假 基接收者 = 假;
文本 当前值类型 = "";
文本 参数名串 = "";

整数 类型尾 = 0;
整数 参数尾 = 0;
整数 临时号 = 0;
整数 使用深 = 0;

无 错(文本 m) {
    打印("编译错误：" + m);
    打印("记号位置 " + 整转文(位置) + "，当前「" + 当() + "」");
    退出(1);
}

文本 词(整数 i) {
    若 (i < 0 || i >= 词文.数量) { 返回 ""; }
    返回 词文[i];
}

文本 当() {
    返回 词(位置);
}

文本 后一() {
    返回 词(位置 + 1);
}

真假 是(文本 t) {
    若 (位置 >= 词文.数量) { 返回 假; }
    若 (当() != t) { 返回 假; }
    返回 词类[位置] == "id" || 词类[位置] == "op";
}

无 分号可() {
    若 (是(";")) { 进(); }
}

无 进() {
    位置 = 位置 + 1;
}

无 要(文本 t) {
    若 (当() != t) {
        错("期望「" + t + "」，读到「" + 当() + "」");
    }
    位置 = 位置 + 1;
}

真假 是类型词(文本 t) {
    返回 t == "整数" || t == "小数" || t == "文本" || t == "真假" || t == "无" || t == "列表" || t == "表" || t == "条目" ||
        t == "集合" || t == "队列" || t == "栈" ||
        t == "异常" || t == "参数异常" || t == "状态异常" || t == "文件异常" || t == "越界异常" || t == "格式异常";
}

整数 类索引(文本 名) {
    整数 i = 0;
    只要 (i < 类名.数量) {
        若 (类名[i] == 名) { 返回 i; }
        i = i + 1;
    }
    返回 -1;
}

整数 接口索引(文本 名) {
    整数 i = 0;
    只要 (i < 接口名.数量) {
        若 (接口名[i] == 名) { 返回 i; }
        i = i + 1;
    }
    返回 -1;
}

整数 结构索引(文本 名) {
    整数 i = 0;
    只要 (i < 结构名.数量) {
        若 (结构名[i] == 名) { 返回 i; }
        i = i + 1;
    }
    返回 -1;
}

整数 枚举索引(文本 名) {
    整数 i = 0;
    只要 (i < 枚举名.数量) {
        若 (枚举名[i] == 名) { 返回 i; }
        i = i + 1;
    }
    返回 -1;
}

真假 是类型(文本 t) {
    返回 是类型词(t) || 类索引(t) >= 0 || 接口索引(t) >= 0 || 枚举索引(t) >= 0 || 结构索引(t) >= 0 || 委托索引(t) >= 0;
}

文本 类C名(文本 名) {
    返回 "Csay_" + C名("#t:" + 名);
}

文本 字段C名(文本 cls, 文本 字段) {
    返回 C名("#f:" + cls + ":" + 字段);
}

文本 方法C名(文本 cls, 文本 方法) {
    返回 C名("#m:" + cls + ":" + 方法);
}

文本 构造C名(文本 cls) {
    返回 C名("#new:" + cls);
}

文本 属性取C名(文本 cls, 文本 属性) {
    返回 C名("#get:" + cls + ":" + 属性);
}

文本 属性写C名(文本 cls, 文本 属性) {
    返回 C名("#set:" + cls + ":" + 属性);
}

文本 初始化C名(文本 cls) {
    返回 C名("#init:" + cls);
}

文本 结构C名(文本 名) {
    返回 "Csay_" + C名("#st:" + 名);
}

文本 结构字段C名(文本 st, 文本 字段) {
    返回 C名("#stf:" + st + ":" + 字段);
}

文本 结构方法C名(文本 st, 文本 方法) {
    返回 C名("#stm:" + st + ":" + 方法);
}

文本 结构构造C名(文本 st) {
    返回 C名("#stnew:" + st);
}

文本 结构初始化C名(文本 st) {
    返回 C名("#stinit:" + st);
}

文本 结构方法项(文本 st, 文本 方法) {
    整数 i = 结构索引(st);
    若 (i < 0 || i >= 结构方法.数量) { 返回 ""; }
    列表<文本> es = 结构方法[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 方法) { 返回 p[1] + "|" + p[2]; }
        }
        k = k + 1;
    }
    返回 "";
}

真假 结构方法静态(文本 st, 文本 方法) {
    整数 i = 结构索引(st);
    若 (i < 0 || i >= 结构方法.数量) { 返回 假; }
    列表<文本> es = 结构方法[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 方法 && p[3] == "1") { 返回 真; }
        }
        k = k + 1;
    }
    返回 假;
}
文本 接口C名(文本 名) {
    返回 "Csay_" + C名("#i:" + 名);
}

文本 接口方法C名(文本 iface, 文本 方法) {
    返回 C名("#im:" + iface + ":" + 方法);
}

文本 接口属性取C名(文本 iface, 文本 属性) {
    返回 C名("#ig:" + iface + ":" + 属性);
}

文本 接口属性写C名(文本 iface, 文本 属性) {
    返回 C名("#is:" + iface + ":" + 属性);
}

整数 类标签(文本 cls) {
    返回 类索引(cls) + 1;
}

文本 静态字段C名(文本 cls, 文本 字段) {
    返回 C名("#sf:" + cls + ":" + 字段);
}

文本 静态字段项(文本 cls, 文本 字段) {
    整数 i = 类索引(cls);
    若 (i < 0) { 返回 ""; }
    列表<文本> es = 类静态字段[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 字段) { 返回 p[1]; }
        }
        k = k + 1;
    }
    返回 "";
}

文本 枚举项C名(文本 en, 文本 项) {
    返回 C名("#e:" + en + ":" + 项);
}

文本 枚举项值(文本 en, 文本 项) {
    整数 i = 枚举索引(en);
    若 (i < 0) { 返回 ""; }
    列表<文本> es = 枚举项[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 项) { 返回 p[1]; }
        }
        k = k + 1;
    }
    返回 "";
}

整数 委托索引(文本 n) {
    整数 i = 0;
    只要 (i < 委托名.数量) {
        若 (委托名[i] == n) { 返回 i; }
        i = i + 1;
    }
    返回 -1;
}

文本 委托信息(列表<文本> 表, 文本 n) {
    整数 i = 委托索引(n);
    若 (i < 0 || i >= 表.数量) { 返回 ""; }
    返回 表[i];
}

文本 委托签名(文本 n) {
    返回 "函数:" + 委托信息(委托参数, n) + "->" + 委托信息(委托返回, n);
}

文本 查委托环境(文本 fn) {
    整数 i = 委托环境名.数量 - 1;
    只要 (i >= 0) {
        若 (委托环境名[i] == fn) { 返回 委托环境码[i]; }
        i = i - 1;
    }
    返回 "";
}

文本 扫类型(整数 起) {
    文本 t = 词(起);
    文本 base = "";
    若 (t == "表") {
        整数 p = 起 + 1;
        若 (p < 词文.数量 && 词(p) == "<") { p = p + 1; }
        文本 k = 扫类型(p);
        p = 类型尾;
        若 (p < 词文.数量 && 词(p) == ",") { p = p + 1; }
        文本 v = 扫类型(p);
        p = 类型尾;
        若 (p < 词文.数量 && 词(p) == ">") { p = p + 1; }
        类型尾 = p;
        base = "表:" + k + ":" + v;
    } 否则若 (t == "列表" || t == "集合" || t == "队列" || t == "栈") {
        整数 p = 起 + 1;
        若 (p < 词文.数量 && 词(p) == "<") { p = p + 1; }
        文本 e = 扫类型(p);
        p = 类型尾;
        若 (p < 词文.数量 && 词(p) == ">") { p = p + 1; }
        类型尾 = p;
        base = "列表:" + e;
    } 否则若 (类索引(t) >= 0) {
        类型尾 = 起 + 1;
        base = "类:" + t;
    } 否则若 (委托索引(t) >= 0) {
        类型尾 = 起 + 1;
        base = "委托:" + t;
    } 否则若 (接口索引(t) >= 0) {
        类型尾 = 起 + 1;
        base = "接口:" + t;
    } 否则若 (枚举索引(t) >= 0) {
        类型尾 = 起 + 1;
        base = "枚举:" + t;
    } 否则若 (结构索引(t) >= 0) {
        类型尾 = 起 + 1;
        base = "结构:" + t;
    } 否则 {
        类型尾 = 起 + 1;
        base = t;
    }
    若 (类型尾 + 1 < 词文.数量 && 词(类型尾) == "[" && 词(类型尾 + 1) == "]") {
        类型尾 = 类型尾 + 2;
        返回 "列表:" + base;
    }
    返回 base;
}

文本 C型(文本 t) {
    若 (t == "整数") { 返回 "CsayInt"; }
    若 (t == "小数") { 返回 "CsayFloat"; }
    若 (t == "文本") { 返回 "CsayStr"; }
    若 (t == "真假") { 返回 "CsayBool"; }
    若 (t == "无") { 返回 "void"; }
    若 (t == "异常") { 返回 "CsayError"; }
    若 (t == "参数异常" || t == "状态异常" || t == "文件异常" || t == "越界异常" || t == "格式异常") { 返回 "CsayError"; }
    若 (t == "列表:文本" || t == "列表:整数") { 返回 "CsayList*"; }
    若 (t.含("列表:")) { 返回 "CsayList*"; }
    列表<文本> p = t.切分(":");
    若 (p[0] == "类") { 返回 类C名(p[1]) + "*"; }
    若 (p[0] == "委托") { 返回 "Csay_" + p[1]; }
    若 (p[0] == "接口") { 返回 接口C名(p[1]); }
    若 (p[0] == "结构") { 返回 结构C名(p[1]); }
    若 (p[0] == "表") { 返回 "CsayMap*"; }
    若 (p[0] == "条目") { 返回 "CsayEntry_" + p[1] + "_" + p[2]; }
    若 (p[0] == "枚举") { 返回 "CsayInt"; }
    错("不支持的类型 " + t);
    返回 "void";
}

整数 异常种类(文本 t) {
    若 (t == "异常") { 返回 0; }
    若 (t == "参数异常") { 返回 1; }
    若 (t == "状态异常") { 返回 2; }
    若 (t == "文件异常") { 返回 3; }
    若 (t == "越界异常") { 返回 4; }
    若 (t == "格式异常") { 返回 5; }
    返回 -1;
}

文本 异常消息(文本 r) {
    文本 ty = 果类型(r);
    若 (ty == "异常") { 返回 果码(r) + ".msg"; }
    返回 转文本码(ty, 果码(r));
}

文本 异常构造(文本 t) {
    文本 a = 包("文本", "csay_lit(\"\")");
    若 (是("(")) {
        进();
        a = 表达式();
        要(")");
    }
    返回 包("异常", "csay_error(" + 异常消息(a) + ", " + 整转文(异常种类(t)) + ")");
}

文本 元素型(文本 t) {
    列表<文本> p = t.切分(":");
    若 (p[1] == "类" || p[1] == "接口") {
        返回 p[1] + ":" + p[2];
    }
    若 (p[1] == "条目") {
        返回 p[1] + ":" + p[2] + ":" + p[3];
    }
    返回 p[1];
}

文本 表键型(文本 t) {
    列表<文本> p = t.切分(":");
    返回 p[1];
}

文本 表值型(文本 t) {
    列表<文本> p = t.切分(":");
    返回 p[2];
}

文本 表哈希(文本 k) {
    若 (k == "文本") { 返回 "csay_hash_str"; }
    返回 "csay_hash_int";
}

文本 表相等(文本 k) {
    若 (k == "文本") { 返回 "csay_eq_str"; }
    返回 "csay_eq_int";
}

文本 取址(文本 t, 文本 c) {
    若 (t == "文本") {
        返回 "(" + 左 + " CsayStr tmp = " + c + "; &tmp; " + 右 + ")";
    }
    返回 "&(" + C型(t) + ")" + 左 + c + 右;
}

文本 C名(文本 键) {
    整数 i = 0;
    只要 (i < 名字表.数量) {
        若 (名字表[i] == 键) {
            返回 "n" + 整转文(i);
        }
        i = i + 1;
    }
    名字表.追加(键);
    返回 "n" + 整转文(名字表.数量 - 1);
}

文本 变量键(文本 名) {
    返回 前缀 + 名;
}

无 声明(文本 名, 文本 型) {
    符号名.追加(变量键(名));
    符号类型.追加(型);
}

真假 有符号(文本 键) {
    整数 i = 符号名.数量 - 1;
    只要 (i >= 0) {
        若 (符号名[i] == 键) { 返回 真; }
        i = i - 1;
    }
    返回 假;
}

文本 查类型(文本 名) {
    文本 键 = 变量键(名);
    整数 i = 符号名.数量 - 1;
    只要 (i >= 0) {
        若 (符号名[i] == 键) {
            返回 符号类型[i];
        }
        i = i - 1;
    }
    若 (前缀 != "") {
        i = 符号名.数量 - 1;
        只要 (i >= 0) {
            若 (符号名[i] == 名) {
                返回 符号类型[i];
            }
            i = i - 1;
        }
    }
    返回 "";
}

文本 变量C名(文本 名) {
    若 (有符号(变量键(名))) {
        返回 C名(变量键(名));
    }
    返回 C名(名);
}

文本 函数返回类型(文本 名) {
    整数 i = 0;
    只要 (i < 函数名.数量) {
        若 (函数名[i] == 名) {
            返回 函数返回[i];
        }
        i = i + 1;
    }
    返回 "";
}

文本 结构字段类型(文本 st, 文本 字段) {
    整数 i = 结构索引(st);
    若 (i < 0) { 返回 ""; }
    列表<文本> es = 结构字段[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 字段) { 返回 p[1]; }
        }
        k = k + 1;
    }
    返回 "";
}

文本 字段类型(文本 cls, 文本 字段) {
    整数 i = 类索引(cls);
    若 (i < 0) { 返回 ""; }
    列表<文本> es = 类字段[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 字段) { 返回 p[1]; }
        }
        k = k + 1;
    }
    若 (类基[i] != "") { 返回 字段类型(类基[i], 字段); }
    返回 "";
}

文本 字段路径(文本 cls, 文本 字段) {
    整数 i = 类索引(cls);
    若 (i < 0) { 返回 ""; }
    列表<文本> es = 类字段[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 字段) { 返回 字段C名(cls, 字段); }
        }
        k = k + 1;
    }
    若 (类基[i] != "") {
        文本 p = 字段路径(类基[i], 字段);
        若 (p != "") { 返回 "base." + p; }
    }
    返回 "";
}

文本 方法属主(文本 cls, 文本 方法) {
    整数 i = 类索引(cls);
    若 (i < 0) { 返回 ""; }
    列表<文本> es = 类方法[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 方法) { 返回 cls; }
        }
        k = k + 1;
    }
    若 (类基[i] != "") { 返回 方法属主(类基[i], 方法); }
    返回 "";
}

文本 方法项(文本 cls, 文本 方法) {
    文本 owner = 方法属主(cls, 方法);
    若 (owner == "") { 返回 ""; }
    整数 i = 类索引(owner);
    列表<文本> es = 类方法[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 方法) { 返回 p[1] + "|" + p[2]; }
        }
        k = k + 1;
    }
    返回 "";
}

真假 方法静态(文本 cls, 文本 方法) {
    文本 owner = 方法属主(cls, 方法);
    若 (owner == "") { 返回 假; }
    整数 i = 类索引(owner);
    列表<文本> es = 类方法[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 方法 && p[3] == "1") { 返回 真; }
        }
        k = k + 1;
    }
    返回 假;
}

真假 继承自(文本 cls, 文本 base) {
    若 (cls == base) { 返回 真; }
    整数 i = 类索引(cls);
    若 (i < 0) { 返回 假; }
    若 (类基[i] == "") { 返回 假; }
    返回 继承自(类基[i], base);
}

真假 可访问(文本 vis, 文本 owner) {
    若 (vis == "" || vis == "公开" || vis == "内部") { 返回 真; }
    若 (当前类 == "") { 返回 假; }
    若 (vis == "私有") { 返回 当前类 == owner; }
    若 (vis == "保护") { 返回 当前类 == owner || 继承自(当前类, owner); }
    返回 真;
}

文本 字段属主(文本 cls, 文本 字段) {
    整数 i = 类索引(cls);
    若 (i < 0) { 返回 ""; }
    列表<文本> es = 类字段[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 字段) { 返回 cls; }
        }
        k = k + 1;
    }
    若 (类基[i] != "") { 返回 字段属主(类基[i], 字段); }
    返回 "";
}

真假 字段只读(文本 cls, 文本 字段) {
    文本 owner = 字段属主(cls, 字段);
    若 (owner == "") { 返回 假; }
    整数 i = 类索引(owner);
    列表<文本> es = 类字段[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 字段) {
                若 (p.数量 > 3) { 返回 p[3] == "1"; }
                返回 假;
            }
        }
        k = k + 1;
    }
    返回 假;
}

真假 字段可见(文本 cls, 文本 字段) {
    文本 owner = 字段属主(cls, 字段);
    若 (owner == "") { 返回 假; }
    整数 i = 类索引(owner);
    列表<文本> es = 类字段[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 字段) {
                文本 vis = "";
                若 (p.数量 > 2) { vis = p[2]; }
                返回 可访问(vis, owner);
            }
        }
        k = k + 1;
    }
    返回 假;
}

真假 方法可见(文本 cls, 文本 方法) {
    文本 owner = 方法属主(cls, 方法);
    若 (owner == "") { 返回 假; }
    整数 i = 类索引(owner);
    列表<文本> es = 类方法[i].切分(";");
    整数 k = 0;
    只要 (k < es.数量) {
        若 (es[k] != "") {
            列表<文本> p = es[k].切分("|");
            若 (p[0] == 方法) {
                文本 vis = "";
                若 (p.数量 > 4) { vis = p[4]; }
                返回 可访问(vis, owner);
            }
        }
        k = k + 1;
    }
    返回 假;
}

真假 属性可见(文本 cls, 文本 属性) {
    整数 i = 类索引(cls);
    若 (i < 0) { 返回 假; }
    列表<文本> es = 类属性[i].切分(";");
