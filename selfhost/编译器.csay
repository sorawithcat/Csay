无 生成接口原型() {
    整数 i = 0;
    只要 (i < 接口名.数量) {
        文本 in = 接口C名(接口名[i]);
        输出 = 输出 + "typedef struct " + 左 + " void* obj; CsayInt tag; " + 右 + " " + in + ";\n";
        列表<文本> ms = 接口方法[i].切分(";");
        整数 k = 0;
        只要 (k < ms.数量) {
            若 (ms[k] != "") {
                列表<文本> p = ms[k].切分("|");
                文本 ps = 接口参数定义(p[2]);
                文本 tail = in + " self";
                若 (ps != "") { tail = tail + ", " + ps; }
                输出 = 输出 + "static " + C型(p[1]) + " " + 接口方法C名(接口名[i], p[0]) + "(" + tail + ");\n";
            }
            k = k + 1;
        }
        列表<文本> props = 接口属性[i].切分(";");
        k = 0;
        只要 (k < props.数量) {
            若 (props[k] != "") {
                列表<文本> p = props[k].切分("|");
                若 (p[2] == "1") {
                    输出 = 输出 + "static " + C型(p[1]) + " " + 接口属性取C名(接口名[i], p[0]) + "(" + in + " self);\n";
                }
                若 (p[3] == "1") {
                    输出 = 输出 + "static void " + 接口属性写C名(接口名[i], p[0]) + "(" + in + " self, " + C型(p[1]) + " v);\n";
                }
            }
            k = k + 1;
        }
        输出 = 输出 + "\n";
        i = i + 1;
    }
}

无 生成接口实现() {
    整数 i = 0;
    只要 (i < 接口名.数量) {
        文本 iname = 接口名[i];
        文本 in = 接口C名(iname);
        列表<文本> ms = 接口方法[i].切分(";");
        整数 k = 0;
        只要 (k < ms.数量) {
            若 (ms[k] != "") {
                列表<文本> p = ms[k].切分("|");
                文本 ps = 接口参数定义(p[2]);
                文本 tail = in + " self";
                若 (ps != "") { tail = tail + ", " + ps; }
                追加输出("static " + C型(p[1]) + " " + 接口方法C名(iname, p[0]) + "(" + tail + ") " + 左 + "\n");
                整数 c = 0;
                只要 (c < 类名.数量) {
                    若 (类实现接口(类名[c], iname)) {
                        文本 owner = 方法属主(类名[c], p[0]);
                        若 (owner == "") { 错("类 " + 类名[c] + " 没有实现接口方法 " + p[0]); }
                        文本 args = 接口参数调用(p[2]);
                        文本 atail = "";
                        若 (args != "") { atail = ", " + args; }
                        文本 call = 方法C名(owner, p[0]) + "(((" + 类C名(owner) + "*)self.obj)" + atail + ")";
                        追加输出("if (self.tag == " + 整转文(类标签(类名[c])) + ") " + 左 + "\n");
                        若 (p[1] == "无") {
                            追加输出(call + ";\nreturn;\n");
                        } 否则 {
                            追加输出("return " + call + ";\n");
                        }
                        追加输出("}\n");
                    }
                    c = c + 1;
                }
                若 (p[1] != "无") {
                    追加输出("return " + 默认值(p[1]) + ";\n");
                }
                追加输出("}\n\n");
            }
            k = k + 1;
        }
        列表<文本> props = 接口属性[i].切分(";");
        k = 0;
        只要 (k < props.数量) {
            若 (props[k] != "") {
                列表<文本> p = props[k].切分("|");
                文本 pty = p[1];
                若 (p[2] == "1") {
                    追加输出("static " + C型(pty) + " " + 接口属性取C名(iname, p[0]) + "(" + in + " self) " + 左 + "\n");
                    整数 c = 0;
                    只要 (c < 类名.数量) {
                        若 (类实现接口(类名[c], iname)) {
                            文本 pi = 属性项(类名[c], p[0]);
                            若 (pi == "") { 错("类 " + 类名[c] + " 没有实现接口属性 " + p[0]); }
                            列表<文本> ap = pi.切分("|");
                            追加输出("if (self.tag == " + 整转文(类标签(类名[c])) + ") return " + 属性取C名(类名[c], p[0]) + "(((" + 类C名(类名[c]) + "*)self.obj));\n");
                        }
                        c = c + 1;
                    }
                    追加输出("return " + 默认值(pty) + ";\n");
                    追加输出("}\n\n");
                }
                若 (p[3] == "1") {
                    追加输出("static void " + 接口属性写C名(iname, p[0]) + "(" + in + " self, " + C型(pty) + " v) " + 左 + "\n");
                    整数 c = 0;
                    只要 (c < 类名.数量) {
                        若 (类实现接口(类名[c], iname)) {
                            文本 pi = 属性项(类名[c], p[0]);
                            若 (pi == "") { 错("类 " + 类名[c] + " 没有实现接口属性 " + p[0]); }
                            追加输出("if (self.tag == " + 整转文(类标签(类名[c])) + ") " + 左 + "\n");
                            追加输出(属性写C名(类名[c], p[0]) + "(((" + 类C名(类名[c]) + "*)self.obj), v);\n");
                            追加输出("return;\n}\n");
                        }
                        c = c + 1;
                    }
                    追加输出("}\n\n");
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

无 生成结构原型() {
    整数 i = 0;
    只要 (i < 结构名.数量) {
        文本 cn = 结构C名(结构名[i]);
        文本 cps = 参数C串(结构构造[i]);
        文本 ctail = "";
        若 (cps == "void") { ctail = " " + cn + "* self"; }
        否则 { ctail = " " + cn + "* self, " + cps; }
        输出 = 输出 + "static void " + 结构初始化C名(结构名[i]) + "(" + ctail + ");\n";
        输出 = 输出 + "static " + cn + " " + 结构构造C名(结构名[i]) + "(" + cps + ");\n";
        列表<文本> ms = 结构方法[i].切分(";");
        整数 k = 0;
        只要 (k < ms.数量) {
            若 (ms[k] != "") {
                列表<文本> p = ms[k].切分("|");
                文本 ps = 参数C串(p[2]);
                文本 tail = "void";
                若 (p[3] == "1") {
                    tail = ps;
                } 否则若 (ps != "void") { tail = " " + cn + "* self, " + ps; }
                否则 { tail = " " + cn + "* self"; }
                输出 = 输出 + "static " + C型(p[1]) + " " + 结构方法C名(结构名[i], p[0]) + "(" + tail + ");\n";
            }
            k = k + 1;
        }
        输出 = 输出 + "\n";
        i = i + 1;
    }
}

无 生成结构体(整数 i) {
    文本 st = 结构名[i];
    文本 cn = 结构C名(st);
    位置 = 结构体起点[i] + 1;
    当前结构 = st;
    当前类 = "";
    当前基 = "";
    前缀 = "";
    当前区 = "func";
    真假 有构造 = 假;
    只要 (位置 < 词文.数量 && !是(右)) {
        只要 (是修饰(当())) { 进(); }
        若 (位置 < 词文.数量 && !是(右)) {
            若 (当() == st && 后一() == "(") {
                进();
                文本 ps = 读参数定义();
                文本 pnames = 参数名串;
                有构造 = 真;
                文本 cparams = "void";
                若 (ps != "void") { cparams = " " + cn + "* self, " + ps; }
                否则 { cparams = " " + cn + "* self"; }
                追加输出("static void " + 结构初始化C名(st) + "(" + cparams + ") " + 左 + "\n");
                生成块();
                追加输出("}\n\n");
                追加输出("static " + cn + " " + 结构构造C名(st) + "(" + ps + ") " + 左 + "\n");
                追加输出(cn + " self;\n");
                文本 call = "&self";
                若 (pnames != "") { call = call + ", " + pnames; }
                追加输出(结构初始化C名(st) + "(" + call + ");\n");
                追加输出("return self;\n}\n\n");
            } 否则 {
                文本 ty = 读类型();
                文本 nm = 当();
                进();
                若 (是("(")) {
                    文本 ps = 读参数定义();
                    当前返回 = ty;
                    文本 head = "static " + C型(ty) + " " + 结构方法C名(st, nm) + "(";
                    真假 静态方法 = 假;
                    列表<文本> ms = 结构方法[i].切分(";");
                    整数 k = 0;
                    只要 (k < ms.数量) {
                        若 (ms[k] != "") {
                            列表<文本> p = ms[k].切分("|");
                            若 (p[0] == nm && p[3] == "1") { 静态方法 = 真; }
                        }
                        k = k + 1;
                    }
                    若 (静态方法) {
                        若 (ps == "void") { head = head + ") " + 左 + "\n"; }
                        否则 { head = head + ps + ") " + 左 + "\n"; }
                    } 否则若 (ps == "void") {
                        head = head + cn + "* self) " + 左 + "\n";
                    } 否则 {
                        head = head + cn + "* self, " + ps + ") " + 左 + "\n";
                    }
                    追加输出(head);
                    生成块();
                    追加输出("}\n\n");
                } 否则若 (是(";")) {
                    进();
                } 否则 {
                    进();
                }
            }
        }
    }
    若 (!有构造) {
        追加输出("static void " + 结构初始化C名(st) + "(" + cn + "* self) " + 左 + "\n");
        追加输出("}\n\n");
        追加输出("static " + cn + " " + 结构构造C名(st) + "(void) " + 左 + "\n");
        追加输出(cn + " self;\n");
        追加输出("return self;\n}\n\n");
    }
    当前结构 = "";
    当前返回 = "无";
    当前区 = "func";
}

无 生成结构函数() {
    整数 i = 0;
    只要 (i < 结构名.数量) {
        生成结构体(i);
        i = i + 1;
    }
}
无 生成类结构() {
    整数 i = 0;
    若 (类名.数量 > 0) {
        输出 = 输出 + "typedef struct " + 左 + " CsayInt tag; " + 右 + " CsayClassHeader;\n\n";
    }
    i = 0;
    只要 (i < 类名.数量) {
        文本 cn = 类C名(类名[i]);
        输出 = 输出 + "typedef struct " + cn + " " + cn + ";\n";
        i = i + 1;
    }
    输出 = 输出 + "\n";
    i = 0;
    只要 (i < 类名.数量) {
        文本 cn = 类C名(类名[i]);
        输出 = 输出 + "struct " + cn + " " + 左 + "\n";
        整数 有字段 = 0;
        若 (类基[i] != "") {
            输出 = 输出 + "    " + 类C名(类基[i]) + " base;\n";
        } 否则 {
            输出 = 输出 + "    CsayInt _tag;\n";
            有字段 = 1;
        }
        列表<文本> es = 类字段[i].切分(";");
        整数 k = 0;
        只要 (k < es.数量) {
            若 (es[k] != "") {
                列表<文本> p = es[k].切分("|");
                输出 = 输出 + "    " + C型(p[1]) + " " + 字段C名(类名[i], p[0]) + ";\n";
                有字段 = 1;
            }
            k = k + 1;
        }
        若 (有字段 == 0) { 输出 = 输出 + "    char _empty;\n"; }
        输出 = 输出 + "};\n\n";
        i = i + 1;
    }
}

无 生成类原型() {
    整数 i = 0;
    只要 (i < 类名.数量) {
        文本 cn = 类C名(类名[i]);
        文本 cps = 参数C串(构造参数(类名[i]));
        文本 ctail = "void";
        若 (cps != "void") { ctail = " " + cn + "* self, " + cps; }
        否则 { ctail = " " + cn + "* self"; }
        输出 = 输出 + "static void " + 初始化C名(类名[i]) + "(" + ctail + ");\n";
        输出 = 输出 + "static " + cn + "* " + 构造C名(类名[i]) + "(" + cps + ");\n";
        列表<文本> ms = 类方法[i].切分(";");
        整数 k = 0;
        只要 (k < ms.数量) {
            若 (ms[k] != "") {
                列表<文本> p = ms[k].切分("|");
                若 (!(p.数量 > 7 && p[7] == "1")) {
                    文本 ps = 参数C串(p[2]);
                    文本 tail = "void";
                    若 (p[3] == "1") {
                        tail = ps;
                    } 否则若 (ps != "void") { tail = " " + cn + "* self, " + ps; }
                    否则 { tail = " " + cn + "* self"; }
                    输出 = 输出 + "static " + C型(p[1]) + " " + 方法C名(类名[i], p[0]) + "(" + tail + ");\n";
                }
            }
            k = k + 1;
        }
        列表<文本> props = 类属性[i].切分(";");
        k = 0;
        只要 (k < props.数量) {
            若 (props[k] != "") {
                列表<文本> p = props[k].切分("|");
                若 (p[2] == "1") {
                    输出 = 输出 + "static " + C型(p[1]) + " " + 属性取C名(类名[i], p[0]) + "(" + cn + "* self);\n";
                }
                若 (p[3] == "1") {
                    输出 = 输出 + "static void " + 属性写C名(类名[i], p[0]) + "(" + cn + "* self, " + C型(p[1]) + " v);\n";
                }
            }
            k = k + 1;
        }
        输出 = 输出 + "\n";
        i = i + 1;
    }
}

无 生成属性(文本 cls, 文本 nm, 文本 ty) {
    文本 cn = 类C名(cls);
    要(左);
    只要 (位置 < 词文.数量 && !是(右)) {
        若 (是("取")) {
            进();
            前缀 = "类:" + cls + ":取:" + nm + ":";
            当前值类型 = "";
            追加输出("static " + C型(ty) + " " + 属性取C名(cls, nm) + "(" + cn + "* self) " + 左 + "\n");
            生成块();
            追加输出("}\n\n");
        } 否则若 (是("写")) {
            进();
            前缀 = "类:" + cls + ":写:" + nm + ":";
            当前值类型 = ty;
            追加输出("static void " + 属性写C名(cls, nm) + "(" + cn + "* self, " + C型(ty) + " _value) " + 左 + "\n");
            生成块();
            追加输出("}\n\n");
            当前值类型 = "";
        } 否则 {
            进();
        }
    }
    要(右);
}

文本 类字段初值(整数 ci) {
    文本 cls = 类名[ci];
    整数 旧位 = 位置;
    文本 out = "";
    位置 = 类体起点[ci] + 1;
    当前类 = cls;
    当前基 = 类基[ci];
    只要 (位置 < 词文.数量 && !是(右)) {
        真假 是静 = 假;
        只要 (是修饰(当())) {
            若 (当() == "静态") { 是静 = 真; }
            进();
        }
        若 (位置 < 词文.数量 && !是(右)) {
            若 (当() == cls && 后一() == "(") {
                进();
                只要 (位置 < 词文.数量 && !是(左)) { 进(); }
                若 (位置 < 词文.数量) { 位置 = 跳过块(位置); }
            } 否则 {
                文本 fty = 读类型();
                文本 nm = 当();
                进();
                若 (是("(")) {
                    只要 (位置 < 词文.数量 && !是(")")) { 进(); }
                    若 (是(")")) { 进(); }
                    若 (是(左)) { 位置 = 跳过块(位置); }
                    否则若 (是(";")) { 进(); }
                } 否则若 (是("=")) {
                    进();
                    文本 v = 表达式();
                    若 (!是静) {
                        out = out + "self->" + 字段C名(cls, nm) + " = " + 转目标(fty, 果类型(v), 果码(v)) + ";\n";
                    }
                    要(";");
                } 否则若 (是(左)) {
                    位置 = 跳过块(位置);
                } 否则 {
                    若 (!是静) {
                        out = out + "self->" + 字段C名(cls, nm) + " = " + 默认值(fty) + ";\n";
                    }
                    只要 (位置 < 词文.数量 && !是(";") && !是(左) && !是(右)) { 进(); }
                    若 (是(";")) {
                        进();
                    } 否则若 (是(左)) {
                        位置 = 跳过块(位置);
                    }
                }
            }
        }
    }
    位置 = 旧位;
    返回 out;
}

无 生成类体(整数 ci) {
    文本 cls = 类名[ci];
    文本 cn = 类C名(cls);
    位置 = 类体起点[ci] + 1;
    当前类 = cls;
    当前基 = 类基[ci];
    前缀 = "";
    当前区 = "class";
    文本 初值 = 类字段初值(ci);
    真假 有构造 = 假;
    只要 (位置 < 词文.数量 && !是(右)) {
        只要 (是修饰(当())) { 进(); }
        若 (位置 < 词文.数量 && !是(右)) {
            若 (当() == cls && 后一() == "(") {
                进();
                前缀 = "类:" + cls + ":构造:";
                文本 ps = 读参数定义();
                文本 pnames = 参数名串;
                有构造 = 真;
                文本 cparams = "void";
                若 (ps != "void") { cparams = " " + cn + "* self, " + ps; }
                否则 { cparams = " " + cn + "* self"; }
                追加输出("static void " + 初始化C名(cls) + "(" + cparams + ") " + 左 + "\n");
                若 (是(":")) {
                    进();
                    要("基");
                    要("(");
                    文本 bargs = 调用参数();
                    若 (类基[ci] == "") { 错("类 " + cls + " 没有父类"); }
                    文本 tail = "";
                    若 (bargs != "") { tail = ", " + bargs; }
                    追加输出(初始化C名(类基[ci]) + "(&self->base" + tail + ");\n");
                } 否则 {
                    若 (类基[ci] != "") {
                        文本 bp = 构造参数(类基[ci]);
                        若 (bp != "" && bp != "void") { 错("父类 " + 类基[ci] + " 没有无参构造器"); }
                        追加输出(初始化C名(类基[ci]) + "(&self->base);\n");
                    }
                }
                若 (初值 != "") { 追加输出(初值); }
                当前构造 = 真;
                生成块();
                当前构造 = 假;
                追加输出("self->" + 类标签路径(cls) + " = " + 整转文(ci + 1) + "LL;\n");
                追加输出("}\n\n");
                追加输出("static " + cn + "* " + 构造C名(cls) + "(" + ps + ") " + 左 + "\n");
                追加输出(cn + "* self = (" + cn + "*)malloc(sizeof(" + cn + "));\n");
                文本 call = "self";
                若 (pnames != "") { call = call + ", " + pnames; }
                追加输出(初始化C名(cls) + "(" + call + ");\n");
                追加输出("return self;\n}\n\n");
            } 否则 {
                文本 ty = 读类型();
                文本 nm = 当();
                进();
                若 (是("(")) {
                    前缀 = "类:" + cls + ":" + nm + ":";
                    文本 ps = 读参数定义();
                    若 (方法抽象(cls, nm)) {
                        若 (是(";")) { 进(); }
                    } 否则 {
                        当前返回 = ty;
                        文本 head = "static " + C型(ty) + " " + 方法C名(cls, nm) + "(";
                        真假 st = 方法静态(cls, nm);
                        若 (st) {
                            若 (ps == "void") {
                                head = head + ") " + 左 + "\n";
                            } 否则 {
                                head = head + ps + ") " + 左 + "\n";
                            }
                        } 否则若 (ps == "void") {
                            head = head + cn + "* self) " + 左 + "\n";
                        } 否则 {
                            head = head + cn + "* self, " + ps + ") " + 左 + "\n";
                        }
                        追加输出(head);
                        生成块();
                        追加输出("}\n\n");
                    }
                } 否则若 (是(";")) {
                    进();
                } 否则若 (是(左)) {
                    生成属性(cls, nm, ty);
                } 否则 {
                    进();
                    整数 深 = 0;
                    只要 (位置 < 词文.数量 && !(深 == 0 && 是(";"))) {
                        若 (是(左)) { 深 = 深 + 1; }
                        否则若 (是(右)) { 深 = 深 - 1; }
                        进();
                    }
                    若 (是(";")) { 进(); }
                }
            }
        }
    }
    若 (!有构造) {
        追加输出("static void " + 初始化C名(cls) + "(" + cn + "* self) " + 左 + "\n");
        若 (类基[ci] != "") {
            文本 bp = 构造参数(类基[ci]);
            若 (bp != "" && bp != "void") { 错("父类 " + 类基[ci] + " 没有无参构造器"); }
            追加输出(初始化C名(类基[ci]) + "(&self->base);\n");
        }
        追加输出("self->" + 类标签路径(cls) + " = " + 整转文(ci + 1) + "LL;\n");
        若 (初值 != "") { 追加输出(初值); }
        追加输出("}\n\n");
        追加输出("static " + cn + "* " + 构造C名(cls) + "(void) " + 左 + "\n");
        追加输出(cn + "* self = (" + cn + "*)malloc(sizeof(" + cn + "));\n");
        追加输出(初始化C名(cls) + "(self);\n");
        追加输出("return self;\n}\n\n");
    }
    当前类 = "";
    当前基 = "";
    前缀 = "";
    当前返回 = "无";
    当前区 = "func";
}

无 生成委托定义() {
    整数 i = 0;
    只要 (i < 委托名.数量) {
        文本 ps = 委托参数[i];
        文本 sig = "void* env";
        若 (ps != "") {
            列表<文本> parts = ps.切分(",");
            整数 k = 0;
            只要 (k < parts.数量) {
                sig = sig + ", " + C型(parts[k]);
                k = k + 1;
            }
        }
        输出 = 输出 + "typedef struct " + 左 + " void* env; " + C型(委托返回[i]) + " (*fn)(" + sig + "); " + 右 + " Csay_" + 委托名[i] + ";\n";
        i = i + 1;
    }
    若 (委托名.数量 > 0) { 输出 = 输出 + "\n"; }
}

无 生成() {
    收集委托名();
    收集结构();
    收集枚举();
    收集接口();
    收集类();
    检查抽象();
    检查覆盖();
    收集虚方法();
    收集委托签名();
    收集声明();
    生成主();
    输出 = "#include \"csay_runtime.h\"\n\n";
    生成委托定义();
    当前区 = "func";
    生成枚举定义();
    生成结构定义();
    生成结构原型();
    生成结构函数();
    生成静态字段定义();
    生成接口原型();
    生成类结构();
    生成类原型();
    生成虚分派原型();
    整数 i = 0;
    只要 (i < 函数名.数量) {
        输出 = 输出 + "static " + C型(函数返回[i]) + " " + C名("#f:" + 函数名[i]) + "(" + 函数参数[i] + ");\n";
        i = i + 1;
    }
    输出 = 输出 + "\n";
    i = 0;
    只要 (i < 全局名.数量) {
        输出 = 输出 + "static " + C型(全局类型[i]) + " " + C名(全局名[i]) + ";\n";
        i = i + 1;
    }
    输出 = 输出 + "\n";
    i = 0;
    只要 (i < 类名.数量) {
        生成类体(i);
        i = i + 1;
    }
    输出 = 输出 + 委托原型;
    输出 = 输出 + 类输出;
    生成虚分派();
    当前区 = "iface";
    生成接口实现();
    当前区 = "func";
    输出 = 输出 + 接口输出;
    输出 = 输出 + 函数输出;
    输出 = 输出 + 委托实现;
    输出 = 输出 + "int main(int argc, char** argv) " + 左 + "\n";
    输出 = 输出 + "csay_win_init();\natexit(csay_win_finish);\n";
    输出 = 输出 + "g_csay_argc = argc; g_csay_argv = argv;\n";
    输出 = 输出 + 初始化输出;
    输出 = 输出 + 主输出;
    输出 = 输出 + "return 0;\n}\n";
}

文本 目录部分(文本 p) {
    文本 q = p.替换("/", "\\");
    列表<文本> ps = q.切分("\\");
    文本 d = "";
    整数 i = 0;
    只要 (i < ps.数量 - 1) {
        若 (i > 0) { d = d + "\\"; }
        d = d + ps[i];
        i = i + 1;
    }
    返回 d;
}

文本 展开引(文本 s, 文本 目录) {
    若 (s.长度 == 0 || s[0] != "引") { 返回 s; }
    列表<文本> ls = s.切分("\n");
    真假 有引 = 假;
    遍历 (文本 line 在 ls) {
        列表<文本> ss = line.切分(" ");
        若 (ss.数量 > 0 && ss[0] == "引") { 有引 = 真; }
    }
    若 (!有引) { 返回 s; }
    文本 out = "";
    遍历 (文本 line 在 ls) {
        文本 t = line.替换("\r", "");
        列表<文本> ws = t.切分(" ");
        若 (ws.数量 > 0 && ws[0] == "引") {
            列表<文本> ps = t.切分("\"");
            若 (ps.数量 >= 3) {
                文本 p = ps[1];
                若 (!p.含(":")) {
                    若 (目录 != "") { p = 目录 + "\\" + p; }
                }
                文本 inc = 读文件(p);
                若 (inc != "") {
                    out = out + 展开引(inc, 目录部分(p));
                    out = out + "\n";
                }
            }
        } 否则 {
            out = out + line + "\n";
        }
    }
    返回 out;
}

真假 有空间() {
    整数 i = 0;
    只要 (i < 词文.数量) {
        若 ((词类[i] == "id" || 词类[i] == "kw") && 词文[i] == "空间") { 返回 真; }
        i = i + 1;
    }
    返回 假;
}

无 剥离空间() {
    列表<文本> 新词 = 新 列表<文本>();
    列表<文本> 新类 = 新 列表<文本>();
    整数 i = 0;
    只要 (i < 词文.数量) {
        若 ((词类[i] == "id" || 词类[i] == "kw") && 词文[i] == "空间") {
            i = i + 1;
            只要 (i < 词文.数量 && 词文[i] != 左) { i = i + 1; }
            若 (i < 词文.数量) { i = i + 1; }
            整数 深 = 1;
            只要 (i < 词文.数量 && 深 > 0) {
                若 (词文[i] == 左) { 深 = 深 + 1; }
                否则若 (词文[i] == 右) { 深 = 深 - 1; }
                若 (深 > 0) {
                    新词.追加(词文[i]);
                    新类.追加(词类[i]);
                }
                i = i + 1;
            }
        } 否则 {
            新词.追加(词文[i]);
            新类.追加(词类[i]);
            i = i + 1;
        }
    }
    词文 = 新词;
    词类 = 新类;
}

真假 泛型标识(文本 c) {
    若 (c == "") { 返回 假; }
    若 (是空白(c)) { 返回 假; }
    若 (是符号(c)) { 返回 假; }
    若 (c == "\"" || c == "“" || c == "”" || c == "'") { 返回 假; }
    返回 真;
}

文本 取段(文本 s, 整数 a, 整数 b) {
    若 (a < 0) { a = 0; }
    若 (b > s.长度) { b = s.长度; }
    文本 r = "";
    整数 i = a;
    只要 (i < b) {
        r = r + s[i];
        i = i + 1;
    }
    返回 r;
}

整数 跳空白(文本 s, 整数 i) {
    只要 (i < s.长度 && 是空白(s[i])) { i = i + 1; }
    返回 i;
}

整数 标识尾(文本 s, 整数 i) {
    只要 (i < s.长度 && 泛型标识(s[i])) { i = i + 1; }
    返回 i;
}

整数 跳非代码(文本 s, 整数 i) {
    若 (i >= s.长度) { 返回 i; }
    文本 c = s[i];
    若 (c == "\"") {
        整数 j = i + 1;
        只要 (j < s.长度) {
            若 (s[j] == "\\") { j = j + 2; }
            否则若 (s[j] == "\"") { 返回 j + 1; }
            否则 { j = j + 1; }
        }
        返回 s.长度;
    }
    若 (c == "“") {
        整数 j = i + 1;
        只要 (j < s.长度) {
            若 (s[j] == "”") { 返回 j + 1; }
            j = j + 1;
        }
        返回 s.长度;
    }
    若 (c == "/" && i + 1 < s.长度 && s[i + 1] == "/") {
        整数 j = i + 2;
        只要 (j < s.长度 && s[j] != "\n") { j = j + 1; }
        返回 j;
    }
    若 (c == "/" && i + 1 < s.长度 && s[i + 1] == "*") {
        整数 j = i + 2;
        只要 (j + 1 < s.长度) {
            若 (s[j] == "*" && s[j + 1] == "/") { 返回 j + 2; }
            j = j + 1;
        }
        返回 s.长度;
    }
    返回 i;
}

整数 匹配花(文本 s, 整数 开) {
    整数 深 = 0;
    整数 i = 开;
    只要 (i < s.长度) {
        整数 j = 跳非代码(s, i);
        若 (j != i) { i = j; }
        否则若 (s[i] == 左) { 深 = 深 + 1; i = i + 1; }
        否则若 (s[i] == 右) {
            深 = 深 - 1;
            若 (深 == 0) { 返回 i; }
            i = i + 1;
        }
        否则 { i = i + 1; }
    }
    返回 s.长度 - 1;
}

整数 匹配尖(文本 s, 整数 开) {
    整数 深 = 0;
    整数 i = 开;
    只要 (i < s.长度) {
        整数 j = 跳非代码(s, i);
        若 (j != i) { i = j; }
        否则若 (s[i] == "<") { 深 = 深 + 1; i = i + 1; }
        否则若 (s[i] == ">") {
            深 = 深 - 1;
            i = i + 1;
            若 (深 == 0) { 返回 i; }
        }
        否则 { i = i + 1; }
    }
    返回 s.长度;
}

整数 找代码字符(文本 s, 整数 起, 文本 c) {
    整数 i = 起;
    只要 (i < s.长度) {
        整数 j = 跳非代码(s, i);
        若 (j != i) { i = j; }
        否则若 (s[i] == c) { 返回 i; }
        否则 { i = i + 1; }
    }
    返回 s.长度;
}

文本 修剪(文本 s) {
    整数 a = 0;
    整数 b = s.长度;
    只要 (a < b && 是空白(s[a])) { a = a + 1; }
    只要 (b > a && 是空白(s[b - 1])) { b = b - 1; }
    返回 取段(s, a, b);
}

列表<文本> 切分参数(文本 raw) {
    列表<文本> r = 新 列表<文本>();
    文本 cur = "";
    整数 深 = 0;
    整数 i = 0;
    只要 (i < raw.长度) {
        文本 c = raw[i];
        若 (c == "<") { 深 = 深 + 1; cur = cur + c; }
        否则若 (c == ">") { 深 = 深 - 1; cur = cur + c; }
        否则若 (c == "," && 深 == 0) {
            r.追加(修剪(cur));
            cur = "";
        }
        否则 { cur = cur + c; }
        i = i + 1;
    }
    文本 t = 修剪(cur);
    若 (t != "") { r.追加(t); }
    返回 r;
}

整数 找词(文本 s, 文本 w, 整数 起) {
    整数 i = 起;
    只要 (i < s.长度) {
        整数 j = 跳非代码(s, i);
        若 (j != i) { i = j; }
        否则若 (泛型标识(s[i])) {
            整数 e = 标识尾(s, i);
            若 (取段(s, i, e) == w) { 返回 i; }
            i = e;
        }
        否则 { i = i + 1; }
    }
    返回 -1;
}

文本 替换词(文本 s, 文本 from, 文本 to) {
    若 (from == "") { 返回 s; }
    文本 out = "";
    整数 i = 0;
    只要 (i < s.长度) {
        整数 j = 跳非代码(s, i);
        若 (j != i) {
            out = out + 取段(s, i, j);
            i = j;
        } 否则若 (泛型标识(s[i])) {
            整数 e = 标识尾(s, i);
            文本 w = 取段(s, i, e);
            若 (w == from) { out = out + to; }
            否则 { out = out + w; }
            i = e;
        } 否则 {
            out = out + s[i];
            i = i + 1;
        }
    }
    返回 out;
}

文本 泛型清洗(文本 s) {
    文本 r = "";
    整数 i = 0;
    只要 (i < s.长度) {
        文本 c = s[i];
        若 (泛型标识(c)) { r = r + c; }
        否则 { r = r + "_"; }
        i = i + 1;
    }
    返回 r;
}

文本 泛型新名(文本 名, 列表<文本> 实参) {
    文本 r = 名;
    整数 i = 0;
    只要 (i < 实参.数量) {
        r = r + "_" + 泛型清洗(实参[i]);
        i = i + 1;
    }
    返回 r;
}

文本 去自实参(文本 s, 文本 名) {
    文本 out = "";
    整数 i = 0;
    只要 (i < s.长度) {
        整数 j = 跳非代码(s, i);
        若 (j != i) {
            out = out + 取段(s, i, j);
            i = j;
        } 否则若 (泛型标识(s[i])) {
            整数 e = 标识尾(s, i);
            文本 w = 取段(s, i, e);
            若 (w == 名) {
                整数 q = 跳空白(s, e);
                若 (q < s.长度 && s[q] == "<") {
                    out = out + w;
                    i = 匹配尖(s, q);
                } 否则 {
                    out = out + w;
                    i = e;
                }
            } 否则 {
                out = out + w;
                i = e;
            }
        } 否则 {
            out = out + s[i];
            i = i + 1;
        }
    }
    返回 out;
}

文本 泛型实例体(文本 原文, 文本 名, 文本 参串, 列表<文本> 实参) {
    文本 d = 原文;
    整数 np = 找词(d, 名, 0);
    若 (np >= 0) {
        整数 q = 跳空白(d, np + 名.长度);
        若 (q < d.长度 && d[q] == "<") {
            整数 e = 匹配尖(d, q);
            d = 取段(d, 0, q) + 取段(d, e, d.长度);
        }
    }
    文本 新名 = 泛型新名(名, 实参);
    d = 替换词(d, 名, 新名);
    列表<文本> ps = 切分参数(参串);
    整数 i = 0;
    只要 (i < ps.数量 && i < 实参.数量) {
        d = 替换词(d, ps[i], 实参[i]);
        i = i + 1;
    }
    返回 去自实参(d, 新名);
}

真假 已有实例(文本 key) {
    整数 i = 0;
    只要 (i < 泛型实例键.数量) {
        若 (泛型实例键[i] == key) { 返回 真; }
        i = i + 1;
    }
    返回 假;
}

文本 替换泛型实例(文本 s, 整数 ti) {
    文本 nm = 泛型名[ti];
    文本 参串 = 泛型参数[ti];
    列表<文本> 形参 = 切分参数(参串);
    文本 out = "";
    整数 i = 0;
    只要 (i < s.长度) {
        整数 j = 跳非代码(s, i);
        若 (j != i) {
            out = out + 取段(s, i, j);
            i = j;
        } 否则若 (泛型标识(s[i])) {
            整数 e = 标识尾(s, i);
            文本 w = 取段(s, i, e);
            若 (w == nm) {
                整数 q = 跳空白(s, e);
                若 (q < s.长度 && s[q] == "<") {
                    整数 ce = 匹配尖(s, q);
                    文本 raw = 取段(s, q + 1, ce - 1);
                    列表<文本> 实参 = 切分参数(raw);
                    若 (实参.数量 == 形参.数量) {
                        文本 新名 = 泛型新名(nm, 实参);
                        文本 key = nm + "<" + raw + ">";
                        若 (!已有实例(key)) {
                            泛型实例键.追加(key);
                            泛型新类表.追加(泛型实例体(泛型原文[ti], nm, 参串, 实参));
                        }
                        out = out + 新名;
                        i = ce;
                    } 否则 {
                        错("泛型 " + nm + " 的类型参数数量不对");
                        out = out + w;
                        i = e;
                    }
                } 否则 {
                    out = out + w;
                    i = e;
                }
            } 否则 {
                out = out + w;
                i = e;
            }
        } 否则 {
            out = out + s[i];
            i = i + 1;
        }
    }
    返回 out;
}

真假 泛型修饰(文本 w) {
    返回 w == "公开" || w == "私有" || w == "保护" || w == "内部" || w == "静态" || w == "只读" || w == "抽象" || w == "虚拟" || w == "覆盖" || w == "常";
}

整数 试提取泛型(文本 s, 整数 起) {
    整数 p = 起;
    文本 w = "";
    只要 (p < s.长度) {
        整数 e = 标识尾(s, p);
        若 (e == p) { 返回 -1; }
        w = 取段(s, p, e);
        若 (泛型修饰(w)) {
            p = 跳空白(s, e);
        } 否则 {
            若 (w != "类" && w != "结构" && w != "接口") { 返回 -1; }
            整数 ne = 标识尾(s, 跳空白(s, e));
            文本 nm = 取段(s, 跳空白(s, e), ne);
            整数 r = 跳空白(s, ne);
            若 (nm == "" || r >= s.长度 || s[r] != "<") { 返回 -1; }
            整数 ce = 匹配尖(s, r);
            文本 ps = 取段(s, r + 1, ce - 1);
            整数 b = 找代码字符(s, ce, 左);
            若 (b >= s.长度) { 返回 -1; }
            整数 end = 匹配花(s, b) + 1;
            泛型名.追加(nm);
            泛型参数.追加(ps);
            泛型原文.追加(取段(s, 起, end));
            返回 end;
        }
    }
    返回 -1;
}

无 提取泛型(文本 s) {
    文本 out = "";
    整数 i = 0;
    只要 (i < s.长度) {
        整数 j = 跳非代码(s, i);
        若 (j != i) {
            out = out + 取段(s, i, j);
            i = j;
        } 否则若 (泛型标识(s[i])) {
            整数 e = 标识尾(s, i);
            文本 w = 取段(s, i, e);
            整数 end = 试提取泛型(s, i);
            若 (end > i) {
                i = end;
            } 否则 {
                out = out + w;
                i = e;
            }
        } 否则 {
            out = out + s[i];
            i = i + 1;
        }
    }
    源码无泛型 = out;
}

真假 有泛型词() {
    整数 i = 0;
    只要 (i + 2 < 词文.数量) {
        文本 w = 词文[i];
        若 ((词类[i] == "id" || 词类[i] == "kw") && (w == "类" || w == "结构" || w == "接口") && 词文[i + 2] == "<") { 返回 真; }
        i = i + 1;
    }
    返回 假;
}

文本 展开泛型(文本 s) {
    提取泛型(s);
    文本 work = 源码无泛型;
    整数 guard = 0;
    只要 (guard < 40) {
        真假 改 = 假;
        整数 ti = 0;
        只要 (ti < 泛型名.数量) {
            文本 before = work;
            文本 r = 替换泛型实例(work, ti);
            若 (r != before) {
                work = r;
                改 = 真;
            }
            若 (泛型新类表.数量 > 0) {
                整数 k = 0;
                只要 (k < 泛型新类表.数量) {
                    work = 泛型新类表[k] + "\n" + work;
                    k = k + 1;
                }
                泛型新类表 = 新 列表<文本>();
                改 = 真;
            }
            ti = ti + 1;
        }
        若 (!改) { 返回 work; }
        guard = guard + 1;
    }
    返回 work;
}

无 启动() {
    列表<文本> 参数 = 命令行参数();
    若 (参数.数量 < 2) {
        打印("用法：csay 编译器.csay <源.csay> <输出.c>");
        退出(1);
    }
    源 = 展开引(读文件(参数[0]), 目录部分(参数[0]));
    词文 = 新 列表<文本>();
    词类 = 新 列表<文本>();
    分词();
    若 (有泛型词()) {
        源 = 展开泛型(源);
        词文 = 新 列表<文本>();
        词类 = 新 列表<文本>();
        分词();
    }
    只要 (有空间()) { 剥离空间(); }
    生成();
    若 (写文件(参数[1], 输出)) {
        打印("已生成 " + 参数[1] + "，记号 " + 整转文(词文.数量) + " 个");
    } 否则 {
        打印("写文件失败：" + 参数[1]);
        退出(1);
    }
}

启动();
